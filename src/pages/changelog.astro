---
import PageLayout from '@/layouts/BaseLayout.astro'
import KnowledgeIndexHero from '@/components/KnowledgeIndexHero.astro'
import UpdateList from '@/components/about/UpdateList.astro'
import { sitePath } from '@/utils/site-path'
import changelog from '../data/changelog.json'
import generations from '../data/site-generations.json'
import sites from '../data/sites.json'

const unreleased = changelog.filter(entry => entry.status === 'unreleased')
const released = changelog.filter(entry => entry.status !== 'unreleased')
const total = released.reduce((sum, entry) => sum + entry.items.length, 0)
const commits = generations.reduce((sum, gen) => sum + gen.commits, 0)
const siteOf = (entry: { site?: string }) => entry.site ?? 'main'
const groups = [...generations].reverse().map(gen => {
  const entries = released.filter(entry => entry.gen === gen.gen)
  const bySite = sites
    .map(site => ({ site, entries: entries.filter(entry => siteOf(entry) === site.id) }))
    .filter(group => group.entries.length > 0)
  return {
    ...gen,
    entries,
    items: entries.reduce((sum, entry) => sum + entry.items.length, 0),
    bySite,
    from: entries[entries.length - 1]?.date,
    to: entries[0]?.date,
  }
})
---

<PageLayout meta={{ title: '更新日志', description: '这个站的版本记录：按代次、站点与日期编号，每条标出改动方式，一天最多一个版本。' }}>
  <main class='changelog-page'>
    <KnowledgeIndexHero
      icon='list'
      eyebrow='CHANGELOG'
      title='更新日志'
      description='只记站点本身真正变过的部分：先按代次、再按站点收拢，每条标出改动方式；文章发布不在这里。'
      stats={[
        { label: '代次', value: generations.length },
        { label: '版本', value: released.length },
        { label: '条目', value: total + unreleased.reduce((sum, entry) => sum + entry.items.length, 0) }
      ]}
      statsLabel='更新概览'
      symbol='✳'
    />

    {unreleased.length > 0 && <section class='changelog-list unreleased' aria-labelledby='unreleased-title'>
      <header class='list-head'>
        <h2 id='unreleased-title'>在途改动</h2>
        <span>已提交、尚未发布</span>
      </header>
      <UpdateList entries={unreleased} />
    </section>}

    <section class='gens' aria-labelledby='gens-title'>
      <header class='list-head'>
        <h2 id='gens-title'>站点沿革</h2>
        <span>{generations.length} 代 · {commits.toLocaleString('zh-CN')} 次提交</span>
      </header>
      <ol class='gen-list'>
        {generations.map(gen => <li>
          <span class='gen-mark'>G{gen.gen}</span>
          <div class='gen-main'>
            <div class='gen-name'>{gen.name}<span class='gen-engine'>{gen.engine}</span></div>
            <p class='gen-note'>{gen.note}</p>
          </div>
          <div class='gen-meta'><span>{gen.span}</span><span>{gen.commits.toLocaleString('zh-CN')} 次提交</span></div>
        </li>)}
      </ol>
    </section>

    <section class='changelog-list' aria-labelledby='changelog-list-title'>
      <header class='list-head'>
        <h2 id='changelog-list-title'>全部版本</h2>
        <span>{released.length} 个版本 · {total} 项</span>
      </header>
      <div class='groups'>
        {groups.filter(group => group.entries.length > 0).map(group => <details class='gen-group' open={group.gen === 3}>
          <summary>
            <span class='gen-mark'>G{group.gen}</span>
            <span class='group-name'>{group.name}</span>
            <span class='group-meta'>{group.from?.slice(0, 4)}–{group.to?.slice(0, 4)} · {group.entries.length} 个版本 · {group.bySite.length} 个站点</span>
            <span class='group-plus' aria-hidden='true'>＋</span>
          </summary>
          {group.bySite.map(({ site, entries }) => <section class='site-block'>
            <h4 class='site-head'>
              <span class='site-name'>{site.label}</span>
              <span class='site-note'>{site.note}</span>
              <span class='site-count'>{entries.length} 个版本</span>
            </h4>
            <UpdateList entries={entries} />
          </section>)}
        </details>)}
      </div>
    </section>
    <p class='changelog-foot'>最近三个版本也会出现在<a href={sitePath('/about#changelog')}>关于页</a>底部；版本号怎么排、改动方式怎么选、站点怎么分，见<a href={sitePath('/docs/meta/changelog-convention')}>更新日志规范</a>。</p>
  </main>
</PageLayout>

<style>
  .changelog-page {max-width:64rem;margin:1.5rem auto 3rem;}
  .changelog-list {margin-top:2.5rem;}
  .changelog-list.unreleased {margin-top:1.5rem;}
  .changelog-list.unreleased .list-head h2 {color:hsl(var(--primary));}
  .gens {margin-top:2.5rem;}
  .gen-list {list-style:none;padding:0;margin:0;}
  .gen-list li {display:grid;grid-template-columns:2.2rem minmax(0,1fr) auto;gap:.9rem;align-items:baseline;padding:.85rem 0;border-bottom:1px solid hsl(var(--border)/.6);}
  .gen-list li:last-child {border-bottom:0;}
  .gen-mark {font-size:.68rem;font-variant-numeric:tabular-nums;color:hsl(var(--primary));border:1px solid hsl(var(--primary)/.35);border-radius:.3rem;padding:.1rem .3rem;text-align:center;}
  .gen-name {font-size:.86rem;font-weight:600;}
  .gen-engine {font-size:.66rem;font-weight:400;color:hsl(var(--muted-foreground));margin-left:.5rem;}
  .gen-note {font-size:.74rem;color:hsl(var(--muted-foreground));line-height:1.7;margin:.15rem 0 0;}
  .gen-meta {display:flex;flex-direction:column;align-items:flex-end;gap:.15rem;font-size:.68rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;white-space:nowrap;}
  .list-head {display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding-bottom:1rem;border-bottom:1px solid hsl(var(--border));}
  .list-head h2 {font-size:clamp(1.2rem,2.4vw,1.5rem);font-weight:650;letter-spacing:-.02em;}
  .list-head span {font-size:.75rem;color:hsl(var(--muted-foreground));}
  .groups {margin-top:.5rem;}
  .gen-group {border-bottom:1px solid hsl(var(--border));}
  .gen-group:last-of-type {border-bottom:0;}
  .gen-group > summary {display:flex;align-items:center;gap:.6rem;padding:1rem 0;cursor:pointer;list-style:none;}
  .gen-group > summary::-webkit-details-marker {display:none;}
  .group-name {font-size:.92rem;font-weight:600;}
  .group-meta {font-size:.7rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;}
  .group-plus {margin-left:auto;font-size:.8rem;color:hsl(var(--muted-foreground));transition:transform .2s ease;}
  .gen-group[open] .group-plus {transform:rotate(45deg);}
  .site-block {padding:.25rem 0 .5rem;}
  .site-block + .site-block {border-top:1px dashed hsl(var(--border));}
  .site-head {display:flex;align-items:baseline;gap:.5rem;flex-wrap:wrap;margin:0;padding:.75rem 0 .25rem;font-size:.74rem;}
  .site-name {font-size:.76rem;font-weight:650;color:hsl(var(--foreground));}
  .site-name::before {content:'§';margin-right:.35rem;color:hsl(var(--primary)/.55);font-weight:400;}
  .site-note {font-size:.66rem;color:hsl(var(--muted-foreground));}
  .site-count {margin-left:auto;font-size:.66rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;}
  .changelog-foot {font-size:.78rem;color:hsl(var(--muted-foreground));line-height:1.9;margin-top:1.5rem;}
  .changelog-foot a {color:hsl(var(--primary));text-underline-offset:.25em;}
  .changelog-foot a:hover {text-decoration:underline;}
  @media(max-width:640px) {.changelog-page {margin-top:1rem;} .group-meta {display:none;}}
</style>
