---
import { musicTracks } from '@/data/music'
import musicWaveforms from '@/data/music-waveforms.json'
import { sitePath } from '@/utils/site-path'
interface Props { compact?: boolean }
const { compact = false } = Astro.props
const fallbackWaveform = Array.from({length:64},()=>0.18)
const waveformFor = (id:string):number[] => {const values=(musicWaveforms as Record<string,number[]>)[id];return Array.isArray(values)&&values.length===64?values:fallbackWaveform}
---
<vesper-music-player class:list={['vesper-music-player', compact && 'is-compact']} data-tracks={JSON.stringify(musicTracks)} data-waveforms={JSON.stringify(musicWaveforms)} aria-label='Vesper 音乐播放器'>
  <div class='music-deck'>
    <div class='music-art' aria-hidden='true'><div class='music-vinyl'><span class='music-spindle'></span><img class='music-cover' data-cover alt='' hidden /><span class='music-vinyl-label' data-cover-fallback>V</span></div><div class='music-tonearm'><span class='music-tonearm-pivot'></span><span class='music-tonearm-rod'></span><span class='music-tonearm-head'></span></div></div>
    <div class='music-info'>
      <span class='music-kicker'>VESPER · NIGHT RADIO</span>
      <h3 data-song-title>夜曲 Op. 9 No. 2</h3>
      <p data-song-artist>Frédéric Chopin</p>
    </div>
    <div class='music-timeline'>
      <label class='sr-only' for={compact ? 'home-music-seek' : 'music-page-seek'}>播放进度</label>
      <div class='music-wave-seek' data-wave-seek style='--music-progress:0%'><output class='music-seek-tooltip' data-seek-tooltip aria-hidden='true'>0:00</output>
        <div class='music-wave-bars' aria-hidden='true'>
          {waveformFor(musicTracks[0]?.id||'').map(value=><span class='music-wave-bar' style={`--bar-height:${Math.round(4+value*26)}px`}></span>)}
        </div>
        <div class='music-wave-played' aria-hidden='true'>
          <div class='music-wave-bars'>
            {waveformFor(musicTracks[0]?.id||'').map(value=><span class='music-wave-bar' style={`--bar-height:${Math.round(4+value*26)}px`}></span>)}
          </div>
        </div>
        <input id={compact ? 'home-music-seek' : 'music-page-seek'} data-seek type='range' min='0' max='1000' value='0' step='1' aria-label='播放进度' />
      </div>
      <div class='music-times'><span data-current>0:00</span><span data-duration>--:--</span></div>
    </div>
    <div class='music-actions'>
      <button type='button' class='music-transport-button' data-previous aria-label='上一首' title='上一首'>⏮</button>
      <button type='button' class='music-main-button' data-play aria-label='播放' aria-pressed='false'><span data-play-symbol aria-hidden='true'>▶</span></button>
      <button type='button' class='music-transport-button' data-next aria-label='下一首' title='下一首'>⏭</button>
      <button type='button' class='music-transport-button' data-shuffle aria-label='随机播放' aria-pressed='false' title='随机播放'>⇄</button>
      <button type='button' class='music-transport-button' data-repeat aria-label='循环模式：关闭' aria-pressed='false' title='循环模式'>↻</button>
      <label class='music-volume'><span aria-hidden='true'>♫</span><input data-volume type='range' min='0' max='1' value='0.7' step='0.05' aria-label='音量' /></label>
      {compact && <a class='music-more' href={sitePath('/music/')} aria-label='打开完整音乐页面'>完整音乐页 ↗</a>}
    </div>
    <p class='music-status' data-status aria-live='polite'>点击播放开始收听 · 不会自动播放</p>
  </div>
  {!compact && <section class='music-side' aria-label='歌词与歌单'>
    <div class='music-tabs' role='tablist' aria-label='音乐内容'>
      <button type='button' role='tab' id='music-lyrics-tab' aria-controls='music-lyrics-panel' aria-selected='true' data-tab='lyrics'>歌词</button>
      <button type='button' role='tab' id='music-list-tab' aria-controls='music-list-panel' aria-selected='false' data-tab='list'>歌单</button>
    </div>
    <div class='music-pane' role='tabpanel' id='music-lyrics-panel' aria-labelledby='music-lyrics-tab' data-panel='lyrics'>
      <div class='music-empty'><span aria-hidden='true'>♪</span><p data-lyrics-title>音乐无需言语</p><small data-lyrics-body>当前曲目为纯音乐，暂无歌词。</small></div>
    </div>
    <div class='music-pane' role='tabpanel' id='music-list-panel' aria-labelledby='music-list-tab' data-panel='list' hidden>
      <label class='sr-only' for='music-song-search'>搜索歌单</label>
      <input id='music-song-search' class='music-search' type='search' data-search placeholder='搜索曲目或演奏者…' />
      <ol data-playlist class='music-playlist'>
        {musicTracks.map(track=><li data-track-id={track.id} data-search-text={`${track.title} ${track.artist}`.toLowerCase()}>
          <button type='button' data-select-song={track.id} class='music-track'><span class='music-track-symbol' aria-hidden='true'><span class='music-track-note'>♪</span><span class='music-track-equalizer'><i></i><i></i><i></i></span></span><span class='music-track-name'><b>{track.title}</b><small>{track.artist}</small></span><span class='music-track-provider'>{track.provider}</span></button>
        </li>)}
      </ol>
    </div>
    
  </section>}
</vesper-music-player>

<script>
  import { musicEngine } from '@/utils/music-engine'
  import type { MusicTrack } from '@/utils/music-engine'
  const formatTime = (value:number) => Number.isFinite(value) ? `${Math.floor(value/60)}:${String(Math.floor(value%60)).padStart(2,'0')}` : '--:--'
  class VesperMusicPlayer extends HTMLElement {
    private controller?:AbortController
    private unsubscribe?:()=>void
    connectedCallback() {
      this.controller?.abort()
      this.unsubscribe?.()
      this.controller=new AbortController()
      const {signal}=this.controller
      let tracks:MusicTrack[]=[]
      try { tracks=JSON.parse(this.dataset.tracks || '[]') } catch {}
      musicEngine.configure(tracks)
      let waveforms:Record<string,number[]>={}
      try{waveforms=JSON.parse(this.dataset.waveforms||'{}')}catch{}
      const play=this.querySelector<HTMLButtonElement>('[data-play]')!
      const repeat=this.querySelector<HTMLButtonElement>('[data-repeat]')!
      const shuffle=this.querySelector<HTMLButtonElement>('[data-shuffle]')!
      const symbol=this.querySelector<HTMLElement>('[data-play-symbol]')!
      const seek=this.querySelector<HTMLInputElement>('[data-seek]')!
      const waveSeek=this.querySelector<HTMLElement>('[data-wave-seek]')!
      const seekTooltip=this.querySelector<HTMLOutputElement>('[data-seek-tooltip]')!
      const waveRows=[...this.querySelectorAll<HTMLElement>('.music-wave-bars')]
      let currentWaveId=''
      const renderWave=(id:string)=>{if(id===currentWaveId)return;currentWaveId=id;const values=waveforms[id];const amplitudes=Array.isArray(values)&&values.length===64?values:Array(64).fill(.18);for(const row of waveRows){row.querySelectorAll<HTMLElement>('.music-wave-bar').forEach((bar,i)=>bar.style.setProperty('--bar-height',`${Math.round(4+Math.max(0,Math.min(1,Number(amplitudes[i])||0))*26)}px`))}}
      let dragging=false
      const volume=this.querySelector<HTMLInputElement>('[data-volume]')!
      const current=this.querySelector<HTMLElement>('[data-current]')!
      const duration=this.querySelector<HTMLElement>('[data-duration]')!
      const status=this.querySelector<HTMLElement>('[data-status]')!
      const title=this.querySelector<HTMLElement>('[data-song-title]')!
      const artist=this.querySelector<HTMLElement>('[data-song-artist]')!
      const cover=this.querySelector<HTMLImageElement>('[data-cover]')!
      const fallback=this.querySelector<HTMLElement>('[data-cover-fallback]')!
      const lyricsTitle=this.querySelector<HTMLElement>('[data-lyrics-title]')
      const lyricsBody=this.querySelector<HTMLElement>('[data-lyrics-body]')
      cover.addEventListener('error',()=>{cover.hidden=true;fallback.hidden=false},{signal})
      this.unsubscribe=musicEngine.subscribe(snapshot=>{
        const track=tracks.find(track=>track.id===snapshot.id)
        if(track){
          renderWave(track.id)
          title.textContent=track.title
          artist.textContent=track.artist
          const image=track.cover?.trim()
          if(image && image.startsWith('https://')) {
            if(cover.getAttribute('src')!==image) {cover.hidden=false;fallback.hidden=true;cover.src=image}
          } else {cover.hidden=true;fallback.hidden=false;cover.removeAttribute('src')}
          if(lyricsTitle && lyricsBody) {
            const words=track.lyrics?.trim()
            lyricsTitle.textContent=words?'歌词':'音乐无需言语'
            lyricsBody.textContent=words || '当前曲目为纯音乐，暂无歌词。'
            lyricsBody.classList.toggle('has-lyrics',Boolean(words))
          }
        }
        current.textContent=formatTime(snapshot.currentTime)
        duration.textContent=snapshot.duration?formatTime(snapshot.duration):'--:--'
        const fraction=snapshot.duration?Math.max(0,Math.min(1,snapshot.currentTime/snapshot.duration)):0
        if(!dragging){seek.value=String(Math.round(fraction*1000));waveSeek.style.setProperty('--music-progress',`${fraction*100}%`);seekTooltip.textContent=formatTime(snapshot.currentTime)}
        seek.setAttribute('aria-valuetext',`${formatTime(snapshot.currentTime)} / ${formatTime(snapshot.duration)}`)
        volume.value=String(snapshot.volume)
        status.textContent=snapshot.status
        play.setAttribute('aria-label',snapshot.playing?'暂停':'播放')
        play.setAttribute('aria-pressed',String(snapshot.playing))
        symbol.textContent=snapshot.playing?'Ⅱ':'▶'
        this.classList.toggle('is-playing',snapshot.playing)
        repeat.textContent=snapshot.repeat==='one'?'↻¹':'↻'
        repeat.setAttribute('aria-label',snapshot.repeat==='off'?'循环模式：关闭':snapshot.repeat==='all'?'循环模式：列表循环':'循环模式：单曲循环')
        repeat.setAttribute('aria-pressed',String(snapshot.repeat!=='off'))
        shuffle.setAttribute('aria-pressed',String(snapshot.shuffle))
        this.querySelectorAll<HTMLElement>('[data-track-id]').forEach(el=>{const active=el.dataset.trackId===snapshot.id;el.classList.toggle('is-active',active);el.classList.toggle('is-track-playing',active&&snapshot.playing);const button=el.querySelector('button');if(active)button?.setAttribute('aria-current','true');else button?.removeAttribute('aria-current')})
      })
      play.addEventListener('click',()=>{void musicEngine.toggle()},{signal})
      this.querySelector('[data-previous]')?.addEventListener('click',()=>{void musicEngine.previous()},{signal})
      this.querySelector('[data-next]')?.addEventListener('click',()=>{void musicEngine.next()},{signal})
      repeat.addEventListener('click',()=>musicEngine.cycleRepeat(),{signal})
      shuffle.addEventListener('click',()=>musicEngine.toggleShuffle(),{signal})
      const preview=()=>{const fraction=Number(seek.value)/1000;waveSeek.style.setProperty('--music-progress',`${fraction*100}%`);seekTooltip.textContent=formatTime(fraction*musicEngine.snapshot.duration);seek.setAttribute('aria-valuetext',`${seekTooltip.textContent} / ${formatTime(musicEngine.snapshot.duration)}`)}
      seek.addEventListener('pointerdown',()=>{dragging=true;waveSeek.classList.add('is-scrubbing')},{signal})
      const finish=()=>{dragging=false;waveSeek.classList.remove('is-scrubbing')}
      seek.addEventListener('pointerup',finish,{signal})
      seek.addEventListener('pointercancel',finish,{signal})
      seek.addEventListener('blur',finish,{signal})
      seek.addEventListener('input',()=>{preview();musicEngine.seek(Number(seek.value)/1000)},{signal})
      seek.addEventListener('change',finish,{signal})
      volume.addEventListener('input',()=>musicEngine.setVolume(Number(volume.value)),{signal})
      this.querySelectorAll<HTMLButtonElement>('[data-select-song]').forEach(button=>button.addEventListener('click',()=>musicEngine.select(button.dataset.selectSong||''),{signal}))
      const search=this.querySelector<HTMLInputElement>('[data-search]')
      search?.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();this.querySelectorAll<HTMLElement>('[data-search-text]').forEach(row=>{row.hidden=!(row.dataset.searchText||'').includes(q)})},{signal})
      const tabs=[...this.querySelectorAll<HTMLButtonElement>('[data-tab]')]
      tabs.forEach(tab=>tab.addEventListener('click',()=>{for(const button of tabs)button.setAttribute('aria-selected',String(button===tab));this.querySelectorAll<HTMLElement>('[data-panel]').forEach(panel=>{panel.hidden=panel.dataset.panel!==tab.dataset.tab})},{signal}))
    }
    disconnectedCallback(){this.controller?.abort();this.unsubscribe?.()}
  }
  if(!customElements.get('vesper-music-player'))customElements.define('vesper-music-player',VesperMusicPlayer)
</script>

<style>
  .vesper-music-player{--music-accent:hsl(var(--primary));display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:1.25rem;color:hsl(var(--foreground))}
  .music-deck,.music-side{min-width:0;min-height:430px;border:1px solid hsl(var(--border)/.7);border-radius:1.5rem;background:hsl(var(--background)/.76);box-shadow:0 12px 36px hsl(var(--foreground)/.055);padding:clamp(1rem,3vw,2rem)}
  .music-deck{display:flex;align-items:center;flex-direction:column;justify-content:center;text-align:center}
  .music-art{width:clamp(150px,20vw,240px);aspect-ratio:1;display:grid;place-items:center;margin:1rem auto 1.3rem;border-radius:50%;background:radial-gradient(circle at 55% 38%,hsl(var(--primary)/.28),transparent 60%);filter:drop-shadow(0 12px 22px hsl(var(--primary)/.18))}
  .music-art{position:relative;isolation:isolate}
  .music-tonearm{position:absolute;z-index:2;top:2%;right:3%;width:38%;height:58%;transform-origin:84% 11%;transform:rotate(-28deg);transition:transform .65s cubic-bezier(.22,.8,.3,1);pointer-events:none;filter:drop-shadow(0 3px 3px #0005)}
  .is-playing .music-tonearm{transform:rotate(0deg)}
  .music-tonearm-pivot{position:absolute;top:0;right:0;width:23%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 38% 34%,#f0f2f4,#8e99a7 55%,#3b4552 72%);box-shadow:0 0 0 3px #273346}
  .music-tonearm-rod{position:absolute;top:10%;right:9%;width:9%;height:77%;border-radius:999px;background:linear-gradient(90deg,#697483,#e2e8ee 45%,#8996a5);transform:rotate(-18deg);transform-origin:top center}
  .music-tonearm-head{position:absolute;bottom:6%;right:26%;width:27%;height:12%;border-radius:3px;background:linear-gradient(145deg,#cbd4df,#475467);transform:rotate(-18deg)}
  .music-spindle{position:absolute;z-index:3;width:5px;height:5px;border-radius:50%;background:linear-gradient(145deg,#fff,#74869b);box-shadow:0 0 0 2px #1c293a;pointer-events:none}
  .music-vinyl{position:relative;overflow:hidden;width:90%;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:repeating-radial-gradient(circle at center,transparent 0 3px,#ffffff0c 4px 5px,transparent 6px 9px),conic-gradient(from 30deg,#192238,#384865,#11192d,#536178,#172036,#192238);box-shadow:0 12px 26px #0004;animation:music-spin 24s linear infinite;animation-play-state:paused}
  .music-vinyl::after{content:'';position:absolute;inset:2%;border-radius:50%;pointer-events:none;background:conic-gradient(from 215deg,transparent 0deg,#ffffff12 38deg,transparent 62deg,transparent 220deg,#ffffff08 255deg,transparent 285deg)}
  .is-playing .music-vinyl{animation-play-state:running}
  .music-cover{width:100%;height:100%;object-fit:cover;border-radius:50%;grid-area:1/1}.music-cover[hidden],.music-vinyl-label[hidden]{display:none!important}
  .music-vinyl-label{grid-area:1/1;display:grid;place-items:center;width:28%;aspect-ratio:1;border-radius:50%;background:linear-gradient(130deg,#bdcfe0,#e4e9ee);color:#24324c;font-family:Georgia,serif;font-size:2rem}
  .music-info{min-height:5rem}.music-kicker{font-size:.63rem;letter-spacing:.17em;color:hsl(var(--muted-foreground))}.music-info h3{font-size:clamp(1.08rem,2.5vw,1.4rem);margin:.65rem 0 .2rem}.music-info p{font-size:.78rem;color:hsl(var(--muted-foreground));line-height:1.65}
  .music-timeline{width:100%;max-width:28rem;margin:1.35rem 0 .8rem}.music-timeline input{width:100%;accent-color:var(--music-accent);cursor:pointer}.music-times{display:flex;justify-content:space-between;color:hsl(var(--muted-foreground));font-size:.72rem;font-variant-numeric:tabular-nums}
  /* Decorative waveform, not a measured waveform of the remote recording. */
  .music-seek-tooltip{position:absolute;z-index:3;left:clamp(24px,var(--music-progress),calc(100% - 24px));top:-15px;transform:translate(-50%,-50%);padding:.24rem .42rem;border-radius:.4rem;background:hsl(var(--foreground));color:hsl(var(--background));font-size:.7rem;font-variant-numeric:tabular-nums;opacity:0;pointer-events:none;transition:opacity .12s;white-space:nowrap}
  .music-wave-seek:hover .music-seek-tooltip,.music-wave-seek:focus-within .music-seek-tooltip,.music-wave-seek.is-scrubbing .music-seek-tooltip{opacity:1}
  .music-wave-seek{position:relative;height:44px;width:100%;display:flex;align-items:center;--music-progress:0%}
  .music-wave-bars{position:absolute;inset:0;display:flex;align-items:center;gap:2px;pointer-events:none}
  .music-wave-bar{flex:1;min-width:0;height:var(--bar-height);max-height:30px;border-radius:999px;background:hsl(var(--muted-foreground)/.32)}
  .music-wave-played{position:absolute;inset:0;clip-path:inset(0 calc(100% - var(--music-progress)) 0 0);pointer-events:none}
  .music-wave-played .music-wave-bar{background:var(--music-accent)}
  .music-wave-seek input[type='range']{position:absolute;inset:0;width:100%;height:100%;margin:0;cursor:pointer;appearance:none;-webkit-appearance:none;background:transparent;touch-action:pan-y}
  .music-wave-seek input[type='range']::-webkit-slider-runnable-track{height:44px;background:transparent}
  .music-wave-seek input[type='range']::-moz-range-track{height:44px;background:transparent}
  .music-wave-seek input[type='range']::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:12px;height:12px;margin-top:16px;border-radius:50%;border:2px solid hsl(var(--background));background:var(--music-accent);box-shadow:0 1px 5px #0005}
  .music-wave-seek input[type='range']::-moz-range-thumb{width:12px;height:12px;border-radius:50%;border:2px solid hsl(var(--background));background:var(--music-accent);box-shadow:0 1px 5px #0005}
  .music-wave-seek:focus-within{outline:2px solid var(--music-accent);outline-offset:3px;border-radius:6px}
  .music-actions{width:100%;display:flex;align-items:center;justify-content:center;gap:1.25rem;flex-wrap:wrap}.music-main-button{border:0;background:var(--music-accent);color:hsl(var(--primary-foreground));width:3.4rem;height:3.4rem;min-width:48px;min-height:48px;border-radius:50%;cursor:pointer;box-shadow:0 5px 18px hsl(var(--primary)/.25);font-size:1.2rem}.music-volume{display:flex;align-items:center;gap:.4rem;font-size:.9rem;color:hsl(var(--muted-foreground))}.music-volume input{width:5rem;accent-color:var(--music-accent)}
  .music-transport-button{border:0;background:transparent;color:inherit;min-width:40px;min-height:40px;border-radius:50%;cursor:pointer;font-size:1.05rem}
  .music-transport-button[aria-pressed='true']{color:var(--music-accent);background:hsl(var(--primary)/.12)}
  .music-status{min-height:1.4rem;margin:.9rem 0 0;font-size:.71rem;color:hsl(var(--muted-foreground));line-height:1.5}
  .music-side{display:flex;flex-direction:column}.music-tabs{align-self:center;background:hsl(var(--muted)/.55);border-radius:999px;padding:.25rem;display:flex;gap:.25rem}.music-tabs button{border:0;background:transparent;padding:.55rem 1.7rem;border-radius:999px;color:inherit;cursor:pointer;min-height:40px;font-size:.85rem}.music-tabs button[aria-selected='true']{background:var(--music-accent);color:hsl(var(--primary-foreground))}.music-pane{flex:1;min-height:0;overflow:auto;padding:1.5rem .2rem}.music-pane[hidden]{display:none}.music-empty{min-height:250px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.7rem;text-align:center}.music-empty>span{font-size:2.5rem;color:var(--music-accent)}.music-empty p{font-size:1.1rem}.music-empty small{font-size:.78rem;color:hsl(var(--muted-foreground))}.music-side-note{border-top:1px solid hsl(var(--border)/.7);padding-top:1rem;font-size:.7rem;line-height:1.6;color:hsl(var(--muted-foreground))}.music-side-note a{text-decoration:underline;text-underline-offset:3px}
  .music-search{width:100%;padding:.7rem 1rem;border:1px solid hsl(var(--border));border-radius:999px;background:hsl(var(--background));color:inherit;font-size:.85rem}.music-playlist{list-style:none;margin:.75rem 0 0;padding:0}.music-playlist li[hidden]{display:none}.music-track{width:100%;display:flex;align-items:center;text-align:left;gap:.8rem;background:transparent;border:0;border-radius:.8rem;padding:.7rem;cursor:pointer;color:inherit}.music-track{position:relative;min-height:54px;transition:background-color .15s ease}.is-active .music-track::before{content:'';position:absolute;left:0;top:20%;bottom:20%;width:3px;border-radius:5px;background:var(--music-accent)}.music-track-equalizer{display:none;align-items:end;justify-content:center;gap:2px;height:16px}.music-track-equalizer i{width:3px;height:55%;border-radius:2px;background:currentColor}.music-track-equalizer i:nth-child(2){height:100%}.music-track-equalizer i:nth-child(3){height:72%}.is-active .music-track-note{display:none}.is-active .music-track-equalizer{display:flex}.is-track-playing .music-track-equalizer i{animation:music-meter .85s ease-in-out infinite alternate}.is-track-playing .music-track-equalizer i:nth-child(2){animation-delay:-.5s}.is-track-playing .music-track-equalizer i:nth-child(3){animation-delay:-.3s}.music-track:hover,.is-active .music-track{background:hsl(var(--primary)/.08)}.music-track-symbol{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:.65rem;background:hsl(var(--primary)/.15);color:var(--music-accent)}.music-track-name{display:grid;flex:1;min-width:0;gap:.2rem}.music-track-name b{font-size:.85rem}.music-track-name small,.music-track-provider{font-size:.68rem;color:hsl(var(--muted-foreground))}.music-track-provider{white-space:nowrap}
