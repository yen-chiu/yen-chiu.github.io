---
import type { MarkdownHeading } from 'astro'

import { generateToc } from '../../plugins/toc'
import TOCHeading from './TOCHeading.astro'

interface Props {
  headings: MarkdownHeading[]
  class?: string
  id?: string
}

const { headings, class: className, ...props } = Astro.props

const toc = generateToc(headings)
---

<toc-heading class={className} {...props}>
  <div class='flex items-center justify-between mb-0 flex-shrink-0'>
    <h2 class='font-medium'>TABLE OF CONTENTS</h2>
  </div>
  <div class='toc-content-wrapper'>
    <ul class='mt-4'>
      {toc.map((heading) => <TOCHeading heading={heading} />)}
    </ul>
  </div>
</toc-heading>

<script>
  // This script tag is useful only if you want to display the TOC alongside the blog post...
  // ... and highlight the section that the user is currently reading through.
  // Feel free to remove this tag if you don't need this type of functionality.

  interface TOCLink {
    element: HTMLAnchorElement
    progressBar: HTMLElement
    slug: string
  }

  interface HeadingProgress {
    inView: boolean
    progress: number
  }

  class TOC extends HTMLElement {
    headings: HTMLElement[] = []
    tocLinks: TOCLink[] = []
    headingProgress: Record<string, HeadingProgress> = {}

    constructor() {
      super()
      // Initialize the headings and tocLinks
      this.headings = Array.from(
        document.querySelectorAll(
          'article h1, article h2, article h3, article h4, article h5, article h6'
        )
      )
      this.tocLinks = Array.from(this.querySelectorAll('a.toc-item')).map((link) => ({
        element: link as HTMLAnchorElement,
        progressBar: link.previousElementSibling as HTMLElement,
        slug: (link.getAttribute('href') || '').substring(1)
      }))
    }

    updatePositionAndStyle = () => {
      const windowHeight = window.innerHeight
      const pageOffset =
        window.scrollY - ((document.querySelector('#content') as HTMLElement)?.offsetTop || 0)

      // 只高亮「当前正在读的那一节」：取最后一个已经越过阈值线的标题。
      // 旧实现按区间是否与视口相交打勾，短小节会让两三个标题同时亮，看起来像选中了一大块。
      const threshold = Math.min(180, windowHeight * 0.3)
      const positions = this.tocLinks.map(({ slug }) => {
        const heading = this.headings.find((el) => el.id === slug)
        return heading ? heading.offsetTop - pageOffset : Number.POSITIVE_INFINITY
      })

      let activeIndex = -1
      positions.forEach((top, i) => {
        if (top <= threshold) activeIndex = i
      })
      const atBottom =
        window.scrollY + windowHeight >= document.documentElement.scrollHeight - 4
      if (atBottom && positions.length) activeIndex = positions.length - 1

      this.tocLinks.forEach(({ element: el, progressBar: bar }, i) => {
        const top = positions[i]
        const nextTop = positions[i + 1] ?? Number.POSITIVE_INFINITY
        const span = Number.isFinite(nextTop) ? Math.max(nextTop - top, 1) : Math.max(windowHeight - top, 1)
        const progress = Number.isFinite(top)
          ? Math.max(0, Math.min(1, (threshold - top) / span))
          : 1
        const isActive = i === activeIndex
        const isRead = progress >= 1

        el.classList.toggle('highlight', isActive)
        el.classList.toggle('highlight-bg-translucent', isActive)
        el.classList.toggle('rounded-2xl', isActive)
        bar.classList.toggle('is-read', !isActive && isRead)
        bar.classList.toggle('highlight-bg', isActive)
        bar.style.setProperty('height', `${(isActive ? Math.max(progress, 0.35) : progress) * 90}%`)
      })
    }

    connectedCallback() {
      // Smooth scroll for TOC links
      this.tocLinks.forEach((link) => {
        link.element.addEventListener('click', (e) => {
          e.preventDefault()
          // Push the history to add the hash at the end of the URL
          const directHeading = this.headings.find((heading) => heading.id === link.slug)
          if (directHeading) {
            // Push the history to add the hash at the end of the URL
            history.pushState(
              null,
              directHeading.textContent || '',
              link.element.getAttribute('href')
            )
            directHeading.scrollIntoView({ behavior: 'smooth' })
          } else {
            console.warn(`No heading found for slug: ${link.slug}`)
          }
        })
      })

      // Initial first and listen to scroll event
      setInterval(this.updatePositionAndStyle, 100)
      window.addEventListener('scroll', this.updatePositionAndStyle)
    }
  }

  customElements.define('toc-heading', TOC)
</script>

<style>
  toc-heading {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100vh;
  }

  toc-heading .toc-content-wrapper {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 0;
  }

  toc-heading :global(.toc-item) {
    display: flow-root;
  }

  /* Custom scrollbar for TOC content */
  toc-heading .toc-content-wrapper::-webkit-scrollbar {
    width: 5px;
  }

  toc-heading .toc-content-wrapper::-webkit-scrollbar-thumb {
    background-color: hsl(var(--muted-foreground) / 0.3);
    border-radius: 999px;
  }

  toc-heading .toc-content-wrapper {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.3) transparent;
  }
</style>
