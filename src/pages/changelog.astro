---
import PageLayout from '@/layouts/BaseLayout.astro'
import KnowledgeIndexHero from '@/components/KnowledgeIndexHero.astro'
import UpdateList from '@/components/about/UpdateList.astro'
import { Giscus } from '@/components/giscus'
import { sitePath } from '@/utils/site-path'
import changelog from '../data/changelog.json'
import generations from '../data/site-generations.json'
import sites from '../data/sites.json'

const unreleased = changelog.filter(entry => entry.status === 'unreleased')
const released = changelog.filter(entry => entry.status !== 'unreleased')
const total = released.reduce((sum, entry) => sum + entry.items.length, 0)
const commits = generations.reduce((sum, gen) => sum + gen.commits, 0)
const siteOf = (entry: { site?: string }) => entry.site ?? 'main'
const siteOrder = (entry: { site?: string }) => {
  const index = sites.findIndex(site => site.id === siteOf(entry))
  return index === -1 ? sites.length : index
}
const versionOf = (gen: number, date: string) => `v${gen}.${date.replace(/-/g, '.')}`
const groups = [...generations].reverse().map(gen => {
  const entries = released.filter(entry => entry.gen === gen.gen)
  const byDate = new Map<string, typeof entries>()
  for (const entry of entries) {
    if (!entry.date) continue
    const bucket = byDate.get(entry.date) ?? []
    bucket.push(entry)
    byDate.set(entry.date, bucket)
  }
  const versions = [...byDate.entries()]
    .sort((a, b) => b[0].localeCompare(a[0]))
    .map(([date, dayEntries]) => ({
      date,
      version: versionOf(gen.gen, date),
      entries: [...dayEntries].sort((a, b) => siteOrder(a) - siteOrder(b)),
      items: dayEntries.reduce((sum, entry) => sum + entry.items.length, 0),
    }))
  return {
    ...gen,
    entries,
    items: entries.reduce((sum, entry) => sum + entry.items.length, 0),
    versions,
    siteCount: new Set(entries.map(siteOf)).size,
    from: entries[entries.length - 1]?.date,
    to: entries[0]?.date,
  }
})
const versionCount = groups.reduce((sum, group) => sum + group.versions.length, 0)
---

<PageLayout meta={{ title: '更新日志', description: '这个站的版本记录：按代次、站点与日期编号，每条标出改动方式，一天最多一个版本。' }}>
  <div class='reading-progress' aria-hidden='true'>
    <div id='changelog-progress-bar' class='reading-progress-bar'></div>
  </div>
  <main class='changelog-page'>
    <KnowledgeIndexHero
      icon='list'
      eyebrow='CHANGELOG'
      title='更新日志'
      description='只记站点本身真正变过的部分：先按代次、再按站点收拢，每条标出改动方式；文章发布不在这里。'
      stats={[
        { label: '代次', value: generations.length },
        { label: '版本', value: versionCount },
        { label: '条目', value: total + unreleased.reduce((sum, entry) => sum + entry.items.length, 0) }
      ]}
      statsLabel='更新概览'
      symbol='✳'
    />

    <div class='changelog-layout'>
      <div class='changelog-main'>
        {unreleased.length > 0 && <section class='changelog-list unreleased' aria-labelledby='unreleased-title'>
          <header class='list-head'>
            <h2 id='unreleased-title'>在途改动</h2>
            <span>规划中或已提交，尚未发布</span>
          </header>
          <UpdateList entries={unreleased} />
        </section>}

        <section class='gens' aria-labelledby='gens-title'>
          <header class='list-head'>
            <h2 id='gens-title'>站点沿革</h2>
            <span>{generations.length} 代 · {commits.toLocaleString('zh-CN')} 次提交</span>
          </header>
          <ol class='gen-list'>
            {generations.map(gen => <li>
              <span class='gen-mark'>G{gen.gen}</span>
              <div class='gen-main'>
                <div class='gen-name'>{gen.name}<span class='gen-engine'>{gen.engine}</span></div>
                <p class='gen-note'>{gen.note}</p>
              </div>
              <div class='gen-meta'><span>{gen.span}</span><span>{gen.commits.toLocaleString('zh-CN')} 次提交</span></div>
            </li>)}
          </ol>
        </section>

        <section class='changelog-list' aria-labelledby='changelog-list-title'>
          <header class='list-head'>
            <h2 id='changelog-list-title'>全部版本</h2>
            <div class='list-tools'>
              <span>{versionCount} 个版本 · {total} 项</span>
              <button type='button' class='bulk-toggle' data-toggle='all'>一键展开</button>
            </div>
          </header>
          <div class='groups'>
            {groups.filter(group => group.entries.length > 0).map(group => <details class='gen-group' open={group.gen === 3}>
              <summary>
                <span class='gen-mark'>G{group.gen}</span>
                <span class='group-name'>{group.name}</span>
                <span class='group-meta'>{group.from?.slice(0, 4)}–{group.to?.slice(0, 4)} · {group.versions.length} 个版本 · {group.siteCount} 个站点</span>
                <button type='button' class='bulk-toggle group-toggle' data-toggle='group'>展开全部</button>
                <span class='group-plus' aria-hidden='true'>＋</span>
              </summary>
              {group.versions.map(version => <details class='version-block' id={`ver-${group.gen}-${version.date}`} data-version={`ver-${group.gen}-${version.date}`}>
                <summary class='version-head'>
                  <span class='version-chip'>{version.version}</span>
                  <span class='version-count'>{version.entries.length > 1 ? `${version.entries.length} 个站点 · ` : ''}{version.items} 项</span>
                  <span class='version-plus' aria-hidden='true'>＋</span>
                </summary>
                <UpdateList entries={version.entries} showSite showVersion={false} showDate={false} />
                <div class='version-feedback' data-vkey={version.version}>
                  <span class='vf-q'>这版有用吗</span>
                  <button type='button' class='vf-btn' data-vote='up'>有用</button>
                  <button type='button' class='vf-btn' data-vote='down'>没用</button>
                  <button type='button' class='vf-note-toggle' data-vnote aria-expanded='false'>补充一句</button>
                  <span class='vf-state' data-vstate hidden></span>
                  <div class='vf-form' data-vform hidden>
                    <input type='text' name='note' maxlength='60' placeholder='一句话说清就行（60 字以内）' aria-label='补充说明' />
                    <button type='button' data-vsave>记下</button>
                    <span class='vf-limit'><span data-vcount>0</span>/60</span>
                    <button type='button' class='vf-move' data-vmove hidden>要细说？去下面写</button>
                  </div>
                </div>
              </details>)}
            </details>)}
          </div>
        </section>
        <p class='changelog-foot'>最近三个版本也会出现在<a href={sitePath('/about#changelog')}>关于页</a>底部；版本号怎么排、改动方式怎么选、站点怎么分，见<a href={sitePath('/docs/meta/changelog-convention')}>更新日志规范</a>。</p>

        <section class='changelog-feedback' id='changelog-comments' aria-labelledby='changelog-comments-title'>
          <header class='list-head'>
            <h2 id='changelog-comments-title'>说说这些改动</h2>
            <span>反馈与评论</span>
          </header>
          <p class='feedback-lede'>哪条写漏了、哪个版本说得不清楚，都可以留在这里。每条版本下面也能先点一下「有用 / 没用」，再决定要不要细说。</p>

          <div class='feedback-form' data-feedback>
            <label class='fb-field'>
              <span class='fb-label'>想说的话</span>
              <textarea name='message' rows='4' maxlength='2000' placeholder='比如：v2.2026.11.03 那条漏了…'></textarea>
            </label>
            <label class='fb-field'>
              <span class='fb-label'>怎么联系你（可选）</span>
              <input name='contact' type='text' maxlength='120' placeholder='邮箱 / GitHub 账号' />
            </label>
            <div class='fb-actions'>
              <button type='button' class='fb-submit' data-send>发送反馈</button>
              <button type='button' class='fb-copy' data-copy>复制内容</button>
            </div>
            <p class='fb-hint'>站点没有后端：发送会用你的邮件客户端打开一封填好的信；不想开邮件就点「复制内容」粘到别处。</p>
            <p class='fb-state' data-state hidden></p>
          </div>

          <details class='comments-details'>
            <summary><span class='when-closed'>展开评论</span><span class='when-open'>收起评论</span><span class='details-plus' aria-hidden='true'>＋</span></summary>
            <p class='comment-hint'>评论同步到 GitHub Discussions，和关于页留言板同一套。</p>
            <Giscus term='更新日志 | Wendell' defer />
          </details>
        </section>
      </div>

      <aside class='version-toc' aria-label='版本目录'>
        <span class='toc-grip' aria-hidden='true'></span>
        <div class='toc-head'>
          <p class='toc-title'>版本目录<span class='toc-pos'><span data-toc-pos>0</span>/<span data-toc-total>{groups[0]?.versions.length ?? 0}</span></span></p>
          <button type='button' class='toc-close' data-cl-toc-close aria-label='关闭目录'>
            <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true'>
              <path d='M6 6l12 12M18 6L6 18'></path>
            </svg>
          </button>
        </div>
        <div class='toc-wrap'>
          <div class='toc-gauge' aria-hidden='true'></div>
          <nav class='toc-body'>
            {groups.map(group => <details class='toc-group' data-gen={group.gen} open={group.gen === 3}>
              <summary>
                <span class='toc-gen'>G{group.gen}</span>
                <span class='toc-name'>{group.name}</span>
                <span class='toc-n'>{group.versions.length}</span>
              </summary>
              <ol>
                {group.versions.map(version => <li>
                  <a class='toc-link' href={`#ver-${group.gen}-${version.date}`} data-target={`ver-${group.gen}-${version.date}`}>{version.version}</a>
                </li>)}
              </ol>
            </details>)}
          </nav>
        </div>
      </aside>
    </div>

    <div class='cl-shade' data-cl-shade hidden></div>
    <div class='cl-actions' id='changelog-actions'>
      <button type='button' class='cl-btn' data-cl-comment aria-label='反馈与评论' title='反馈与评论'>
        <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z' />
        </svg>
      </button>
      <button type='button' class='cl-btn cl-toc-btn' data-cl-toc aria-label='版本目录' title='版本目录' aria-expanded='false'>
        <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true'>
          <path d='M4 6h16M4 12h11M4 18h7' />
        </svg>
      </button>
      <button type='button' class='cl-btn cl-top-btn' data-cl-top aria-label='收起浮动按钮' aria-expanded='false' title='收起'>
        <span class='cl-pct' data-cl-pct><span class='cl-num' data-cl-num>0</span><span class='cl-unit'>%</span></span>
        <svg class='cl-chev' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M15 5l-7 7 7 7'></path>
        </svg>
        <svg class='cl-up' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M12 19V5M5 12l7-7 7 7'></path>
        </svg>
      </button>
    </div>
  </main>
</PageLayout>

<style>
  .reading-progress {position:fixed;top:0;right:0;left:0;z-index:50;height:3px;pointer-events:none;}
  .reading-progress-bar {width:100%;height:100%;background:hsl(var(--primary));box-shadow:0 0 12px hsl(var(--primary)/.45);transform:scaleX(0);transform-origin:0 50%;transition:transform .1s linear;}
   .changelog-page {max-width:var(--vesper-width-content,60rem);margin:var(--vesper-section-space,2.5rem) auto 3rem;overflow-wrap:anywhere;padding-bottom:3.5rem;}
   .changelog-layout {display:grid;grid-template-columns:minmax(0,1fr) 10.5rem;gap:clamp(1.5rem,3vw,2.5rem);align-items:start;}
  .changelog-main {min-width:0;}
  .version-toc {position:sticky;top:5rem;max-height:min(56vh,30rem);overflow:hidden;font-size:.7rem;padding-top:2.4rem;}
  .toc-title {display:flex;align-items:baseline;justify-content:space-between;gap:.4rem;font-size:.66rem;letter-spacing:.08em;color:hsl(var(--muted-foreground));margin:0 0 .6rem;}
  .toc-pos {font-size:.6rem;letter-spacing:0;font-variant-numeric:tabular-nums;color:hsl(var(--primary));}
  .toc-wrap {display:grid;grid-template-columns:.22rem minmax(0,1fr);gap:.55rem;}
  .toc-gauge {display:flex;flex-direction:column;gap:2px;height:calc(min(56vh,30rem) - 2.6rem);min-height:4rem;}
  .toc-gauge .tick {flex:1 1 0;min-height:2px;border-radius:1px;background:hsl(var(--border));transition:background .2s ease;}
  .toc-gauge .tick.done {background:hsl(var(--muted-foreground)/.5);}
  .toc-gauge .tick.current {background:hsl(var(--primary));}
  .toc-body {max-height:calc(min(56vh,30rem) - 2.6rem);overflow:auto;scrollbar-width:thin;padding-right:.2rem;padding-bottom:.9rem;}
  /* 只在还有内容被卷起来的那一侧做渐隐，顶部一进来就别蒙住第一条 */
  .toc-body.can-up {mask-image:linear-gradient(to bottom,transparent 0,#000 .9rem);-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 .9rem);}
  .toc-body.can-down {mask-image:linear-gradient(to bottom,#000 calc(100% - .9rem),transparent 100%);-webkit-mask-image:linear-gradient(to bottom,#000 calc(100% - .9rem),transparent 100%);}
  .toc-body.can-up.can-down {mask-image:linear-gradient(to bottom,transparent 0,#000 .9rem,#000 calc(100% - .9rem),transparent 100%);-webkit-mask-image:linear-gradient(to bottom,transparent 0,#000 .9rem,#000 calc(100% - .9rem),transparent 100%);}
  .toc-group {margin-bottom:.55rem;}
  .toc-group > summary {display:flex;align-items:baseline;gap:.3rem;padding:.15rem 0;cursor:pointer;list-style:none;color:hsl(var(--muted-foreground));}
  .toc-group > summary::-webkit-details-marker {display:none;}
  .toc-group > summary:hover {color:hsl(var(--primary));}
  .toc-group[open] > summary {color:hsl(var(--foreground));}
  .toc-gen {font-size:.62rem;border:1px solid hsl(var(--primary)/.3);border-radius:.25rem;padding:0 .22rem;color:hsl(var(--primary));}
  .toc-name {font-size:.64rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .toc-n {margin-left:auto;font-size:.6rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;}
  /* One quiet, shared index rail; contiguous rows show the visible range. */
  .toc-group ol {list-style:none;margin:.3rem 0 .2rem;padding:0;}
  .toc-group li {min-width:0;}
  .toc-body a {display:block;margin:0;padding:.25rem .45rem;color:hsl(var(--muted-foreground));text-decoration:none;font-variant-numeric:tabular-nums;line-height:1.65;overflow-wrap:anywhere;transition:background .18s ease,color .18s ease;}
  .toc-body a:hover,.toc-body a:focus-visible {color:hsl(var(--primary));background:hsl(var(--primary)/.07);border-radius:.65rem;}
  .toc-body a.is-current {color:hsl(var(--primary));background:hsl(var(--primary)/.1);font-weight:600;}
  .toc-body a.range-start {border-radius:.8rem .8rem 0 0;}
  .toc-body a.range-end {border-radius:0 0 .8rem .8rem;}
  .toc-body a.range-start.range-end {border-radius:.8rem;}
  @media (prefers-reduced-motion:reduce) {.toc-body a {transition:none;}}
  .cl-actions {position:fixed;right:.9rem;bottom:1rem;z-index:62;display:flex;flex-direction:row;align-items:center;gap:0;padding:.28rem;border:1px solid hsl(var(--border));border-radius:999px;background:hsl(var(--background)/.95);backdrop-filter:blur(10px);box-shadow:0 1px 2px hsl(var(--foreground)/.05),0 10px 24px -16px hsl(var(--foreground)/.45);opacity:0;transform:translateY(.4rem);pointer-events:none;transition:opacity .22s ease,transform .22s ease;}
  .cl-actions.is-visible {opacity:1;transform:none;pointer-events:auto;}
  .cl-btn {display:inline-flex;align-items:center;justify-content:center;width:2.2rem;height:2.2rem;border:0;border-radius:999px;background:transparent;color:hsl(var(--muted-foreground));cursor:pointer;transition:color .18s ease,background .18s ease,width .26s cubic-bezier(.32,.72,0,1),opacity .2s ease,margin .26s cubic-bezier(.32,.72,0,1),transform .26s cubic-bezier(.32,.72,0,1);}
  .cl-btn svg {width:1.05rem;height:1.05rem;flex:0 0 auto;}
  .cl-btn:hover {color:hsl(var(--primary));background:hsl(var(--primary)/.08);}
  .cl-actions:not(.is-collapsed) .cl-btn[data-cl-comment] {transition-delay:.06s;}
  .cl-actions:not(.is-collapsed) .cl-btn[data-cl-toc] {transition-delay:.03s;}
  .cl-actions.is-collapsed .cl-btn[data-cl-comment],
  .cl-actions.is-collapsed .cl-btn[data-cl-toc] {width:0;opacity:0;margin:0;pointer-events:none;transform:translateX(.5rem);overflow:hidden;}
  .cl-top-btn {position:relative;display:grid;place-items:center;min-width:2.2rem;width:auto;padding:0 .5rem;}
  .cl-pct {grid-area:1/1;display:inline-flex;align-items:baseline;gap:.01em;font-size:1rem;line-height:1;font-variant-numeric:tabular-nums;transition:opacity .16s ease;}
  .cl-unit {font-size:.75rem;}
  .cl-chev {grid-area:1/1;width:1rem;height:1rem;opacity:0;transition:opacity .16s ease,transform .2s ease;}
  .cl-up {grid-area:1/1;width:1.05rem;height:1.05rem;opacity:0;transition:opacity .16s ease;}
  /* 收起态：显示进度；桌面鼠标移上去才换成「‹」，示意可以往左展开（触屏不套 hover，否则会一直停在箭头） */
  .cl-actions.is-collapsed .cl-pct {opacity:1;}
  @media (hover: hover) and (pointer: fine) {
    .cl-actions.is-collapsed .cl-top-btn:hover .cl-pct {opacity:0;}
    .cl-actions.is-collapsed .cl-top-btn:hover .cl-chev {opacity:1;}
    .cl-actions.is-collapsed.at-end .cl-top-btn:hover .cl-chev {opacity:0;}
  }
  .cl-actions.is-collapsed .cl-top-btn:focus-visible .cl-pct {opacity:0;}
  .cl-actions.is-collapsed .cl-top-btn:focus-visible .cl-chev {opacity:1;}
  .cl-actions.is-collapsed.at-end .cl-top-btn:focus-visible .cl-chev {opacity:0;}
  /* 收起态到页底：进度换回向上箭头 */
  .cl-actions.is-collapsed.at-end .cl-pct {opacity:0;}
  .cl-actions.is-collapsed.at-end .cl-up {opacity:1;}
  /* 展开态：向上箭头，点一下收起所有版本并上滑 */
  .cl-actions:not(.is-collapsed) .cl-pct {opacity:0;}
  .cl-actions:not(.is-collapsed) .cl-chev {opacity:0;}
  .cl-actions:not(.is-collapsed) .cl-up {opacity:1;}
  .cl-actions.hide-comment [data-cl-comment] {display:none;}
  .cl-actions.is-collapsed .cl-top-btn {padding:0;width:2.5rem;min-width:2.5rem;height:2.5rem;}
  .cl-toc-btn[aria-expanded='true'] {color:hsl(var(--primary));background:hsl(var(--primary)/.1);}
  .cl-shade {position:fixed;inset:0;z-index:60;background:hsl(var(--foreground)/.28);backdrop-filter:blur(2px);}
  .cl-shade[hidden] {display:none;}
  .toc-head {display:flex;align-items:center;gap:.5rem;}
  .toc-close,.toc-grip {display:none;}
  .version-toc.is-sheet {display:flex;position:fixed;inset:auto 0 0 0;z-index:61;top:auto;max-height:74vh;flex-direction:column;padding:0 1rem calc(1rem + env(safe-area-inset-bottom,0px));border-top:1px solid hsl(var(--border));border-radius:1.1rem 1.1rem 0 0;background:hsl(var(--background));box-shadow:0 -18px 48px -30px hsl(var(--foreground)/.5);}
  .version-toc.is-sheet .toc-grip {display:block;width:2.4rem;height:.28rem;margin:.55rem auto .2rem;border-radius:999px;background:hsl(var(--border));flex:0 0 auto;}
  .version-toc.is-sheet .toc-head {padding:.35rem 0 .55rem;border-bottom:1px solid hsl(var(--border)/.7);flex:0 0 auto;}
  .version-toc.is-sheet .toc-title {margin:0;font-size:.95rem;font-weight:600;letter-spacing:0;color:hsl(var(--foreground));}
  .version-toc.is-sheet .toc-pos {margin-left:.5rem;font-size:.72rem;letter-spacing:0;color:hsl(var(--primary));}
  .version-toc.is-sheet .toc-close {display:inline-flex;align-items:center;justify-content:center;margin-left:auto;width:1.9rem;height:1.9rem;border-radius:999px;border:1px solid hsl(var(--border));background:transparent;color:hsl(var(--muted-foreground));cursor:pointer;}
  .version-toc.is-sheet .toc-close svg {width:.9rem;height:.9rem;}
  .version-toc.is-sheet .toc-close:hover {color:hsl(var(--primary));border-color:hsl(var(--primary)/.45);}
  .version-toc.is-sheet .toc-wrap {display:grid;grid-template-columns:minmax(0,1fr);gap:0;flex:1 1 auto;min-height:0;overflow:hidden;}
  .version-toc.is-sheet .toc-gauge {display:none;}
  .version-toc.is-sheet .toc-body {max-height:none;min-height:0;padding:.2rem 0 0;font-size:.82rem;}
  .version-toc.is-sheet .toc-group {margin-bottom:.35rem;}
  .version-toc.is-sheet .toc-group > summary {position:sticky;top:0;z-index:1;gap:.4rem;padding:.5rem .2rem .35rem;background:hsl(var(--background));border-bottom:1px solid hsl(var(--border)/.6);font-size:.72rem;}
  .version-toc.is-sheet .toc-gen {font-size:.66rem;}
  .version-toc.is-sheet .toc-group ol {margin-top:.15rem;}
  .version-toc.is-sheet .toc-body a {display:flex;align-items:center;min-height:2.4rem;padding:.45rem .7rem;margin:0;font-size:.86rem;color:hsl(var(--muted-foreground));}
  .version-toc.is-sheet .toc-body a.is-current {background:hsl(var(--primary)/.1);color:hsl(var(--primary));font-weight:600;}
  html.cl-toc-open,html.cl-toc-open body {overflow:hidden;}
  html.cl-toc-open .cl-actions {display:none;}
  .version-block {scroll-margin-top:5rem;}
  .changelog-list h2, .gens h2 {scroll-margin-top:5.5rem;}
  .changelog-list {margin-top:2.5rem;}
  .changelog-list.unreleased {margin-top:1.5rem;}
  .changelog-list.unreleased .list-head h2 {color:hsl(var(--primary));}
  .gens {margin-top:2.5rem;}
  .gen-list {list-style:none;padding:0;margin:0;}
  .gen-list li {display:grid;grid-template-columns:2.2rem minmax(0,1fr) auto;gap:.9rem;align-items:baseline;padding:.85rem 0;border-bottom:1px solid hsl(var(--border)/.6);min-width:0;}
  .gen-list li:last-child {border-bottom:0;}
  .gen-mark {font-size:.68rem;font-variant-numeric:tabular-nums;color:hsl(var(--primary));border:1px solid hsl(var(--primary)/.35);border-radius:.3rem;padding:.1rem .3rem;text-align:center;}
  .gen-name {font-size:.86rem;font-weight:600;}
  .gen-engine {font-size:.66rem;font-weight:400;color:hsl(var(--muted-foreground));margin-left:.5rem;}
  .gen-note {font-size:.74rem;color:hsl(var(--muted-foreground));line-height:1.7;margin:.15rem 0 0;}
  .gen-meta {display:flex;flex-direction:column;align-items:flex-end;gap:.15rem;font-size:.68rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;white-space:nowrap;}
   .list-head {display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-bottom:1rem;border-bottom:1px solid hsl(var(--border));}
  .list-head h2 {font-size:clamp(1.2rem,2.4vw,1.5rem);font-weight:650;letter-spacing:-.02em;}
  .list-head span {font-size:.75rem;color:hsl(var(--muted-foreground));}
  .list-tools {display:flex;align-items:center;gap:.7rem;flex-wrap:wrap;justify-content:flex-end;}
  .bulk-toggle {font-size:.7rem;color:hsl(var(--primary));border:1px solid hsl(var(--primary)/.24);border-radius:.35rem;padding:.35rem .65rem;background:hsl(var(--primary)/.09);cursor:pointer;line-height:1.6;transition:background .18s ease,border-color .18s ease,color .18s ease;}
  .bulk-toggle:hover {color:hsl(var(--primary));border-color:hsl(var(--primary)/.5);background:hsl(var(--primary)/.15);}
  .bulk-toggle {transition-duration:var(--vesper-interaction-duration,180ms);}
  .version-plus,.group-plus {transition-duration:var(--vesper-interaction-duration,180ms);}
  .bulk-toggle:focus-visible,.gen-group > summary:focus-visible,.version-head:focus-visible {outline:2px solid hsl(var(--primary)/.65);outline-offset:3px;}
  .groups {margin-top:.5rem;}
  .gen-group {border-bottom:1px solid hsl(var(--border));}
  .gen-group:last-of-type {border-bottom:0;}
  .gen-group > summary {display:flex;align-items:center;gap:.6rem;padding:1rem 0;cursor:pointer;list-style:none;}
  .gen-group > summary::-webkit-details-marker {display:none;}
  .group-toggle {margin-left:auto;}
  .group-name {font-size:.92rem;font-weight:600;}
  .group-meta {font-size:.7rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;}
  .group-plus {display:inline-grid;place-items:center;flex:0 0 2rem;width:2rem;height:2rem;border-radius:.4rem;background:hsl(var(--primary)/.09);color:hsl(var(--primary));font-size:.9rem;transition:transform .2s ease,background .2s ease;}
  .gen-group[open] .group-plus {transform:rotate(45deg);}
  .version-block {border-bottom:1px solid hsl(var(--border)/.6);}
  .version-block:last-child {border-bottom:0;}
  .version-head {display:flex;align-items:center;gap:.6rem;padding:.75rem 0;font-size:.7rem;color:hsl(var(--muted-foreground));cursor:pointer;list-style:none;}
  .version-head::-webkit-details-marker {display:none;}
  .version-block[open] > .version-head {padding-bottom:.35rem;}
  .version-plus {display:inline-grid;place-items:center;flex:0 0 2.25rem;width:2.25rem;height:2.25rem;border-radius:.4rem;background:hsl(var(--primary)/.09);color:hsl(var(--primary));font-size:1rem;line-height:1;transition:transform .2s ease,background .2s ease;}
  .version-block[open] .version-plus {transform:rotate(45deg);}
  .version-chip {font-variant-numeric:tabular-nums;font-size:.7rem;letter-spacing:.02em;color:hsl(var(--foreground));border:1px solid hsl(var(--primary)/.15);border-radius:.3rem;padding:.2rem .45rem;background:hsl(var(--primary)/.045);}
  .version-count {margin-left:auto;font-variant-numeric:tabular-nums;}
  .version-block > .updates {padding-left:0;}
  .version-feedback {display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;padding:.7rem 0 1rem;margin-top:.35rem;border-top:1px dashed hsl(var(--border)/.8);font-size:.72rem;color:hsl(var(--muted-foreground));}
  .vf-q {margin-right:.15rem;}
  .vf-btn {font-size:.72rem;line-height:1.6;padding:.28rem .6rem;border-radius:.35rem;border:1px solid hsl(var(--border));background:none;color:hsl(var(--muted-foreground));cursor:pointer;min-height:1.9rem;}
  .vf-btn:hover {color:hsl(var(--primary));border-color:hsl(var(--primary)/.45);}
  .vf-btn.is-on {color:hsl(var(--primary));border-color:hsl(var(--primary)/.6);background:hsl(var(--primary)/.08);}
  .vf-form {display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;flex-basis:100%;margin-top:.25rem;}
  .vf-form[hidden] {display:none;}
  .vf-form input {flex:1 1 12rem;min-width:0;font-size:.74rem;padding:.4rem .55rem;border:1px solid hsl(var(--border));border-radius:.35rem;background:hsl(var(--background));color:hsl(var(--foreground));}
  .vf-form button {font-size:.72rem;padding:.35rem .7rem;border-radius:.35rem;border:1px solid hsl(var(--primary)/.5);background:none;color:hsl(var(--primary));cursor:pointer;}
  .vf-limit {font-size:.66rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;white-space:nowrap;}
  .vf-move {border-color:hsl(var(--border))!important;color:hsl(var(--muted-foreground))!important;text-decoration:underline;text-underline-offset:.2em;}
  .vf-move:hover {color:hsl(var(--primary))!important;border-color:hsl(var(--primary)/.45)!important;}
  .vf-note-toggle {font-size:.72rem;line-height:1.6;padding:.28rem .5rem;border:0;background:none;color:hsl(var(--muted-foreground));text-decoration:underline;text-underline-offset:.2em;cursor:pointer;}
  .vf-note-toggle:hover {color:hsl(var(--primary));}
  .vf-state {color:hsl(var(--primary));}
  .changelog-feedback {margin-top:3.5rem;padding-top:.5rem;scroll-margin-top:5rem;}
  .feedback-lede {font-size:.82rem;color:hsl(var(--muted-foreground));line-height:1.9;padding:.9rem 0 1.4rem;max-width:42rem;}
  .feedback-form {border:1px solid hsl(var(--border));border-radius:.8rem;padding:1.1rem 1.2rem;display:flex;flex-direction:column;gap:.9rem;}
  .fb-field {display:flex;flex-direction:column;gap:.35rem;}
  .fb-label {font-size:.74rem;color:hsl(var(--muted-foreground));}
  .fb-field textarea, .fb-field input {width:100%;font-size:.82rem;font-family:inherit;padding:.55rem .7rem;border:1px solid hsl(var(--border));border-radius:.45rem;background:hsl(var(--background));color:hsl(var(--foreground));line-height:1.7;resize:vertical;}
  .fb-field textarea:focus, .fb-field input:focus {outline:2px solid hsl(var(--primary)/.35);outline-offset:1px;}
  .fb-actions {display:flex;gap:.6rem;flex-wrap:wrap;}
  .fb-submit {font-size:.8rem;padding:.5rem 1.1rem;border-radius:.5rem;border:1px solid hsl(var(--primary)/.55);background:hsl(var(--primary)/.1);color:hsl(var(--primary));cursor:pointer;}
  .fb-copy {font-size:.8rem;padding:.5rem 1rem;border-radius:.5rem;border:1px solid hsl(var(--border));background:none;color:hsl(var(--muted-foreground));cursor:pointer;}
  .fb-submit:hover {background:hsl(var(--primary)/.16);}
  .fb-copy:hover {color:hsl(var(--primary));border-color:hsl(var(--primary)/.45);}
  .fb-hint {font-size:.7rem;color:hsl(var(--muted-foreground));line-height:1.8;margin:0;}
  .fb-state {font-size:.74rem;color:hsl(var(--primary));margin:0;}
  .comments-details {margin-top:1.2rem;border:1px solid hsl(var(--border));border-radius:.8rem;}
  .comments-details > summary {display:flex;justify-content:space-between;align-items:center;gap:.75rem;padding:1rem 1.2rem;min-height:52px;cursor:pointer;font-size:.85rem;list-style:none;}
  .comments-details > summary::-webkit-details-marker {display:none;}
  .comments-details > summary:hover {color:hsl(var(--primary));}
  .when-open {display:none;}
  .comments-details[open] > summary .when-closed {display:none;}
  .comments-details[open] > summary .when-open {display:inline;}
  .comments-details[open] > summary .details-plus {transform:rotate(45deg);}
  .details-plus {font-size:1.2rem;color:hsl(var(--primary));}
  .comments-details[open] {padding:0 1.2rem 1.2rem;}
  .comments-details[open] > summary {padding-inline:0;}
  .comment-hint {font-size:.75rem;color:hsl(var(--muted-foreground));}
  .changelog-foot {font-size:.78rem;color:hsl(var(--muted-foreground));line-height:1.9;margin-top:1.5rem;}
  .changelog-foot a {color:hsl(var(--primary));text-underline-offset:.25em;}
  .changelog-foot a:hover {text-decoration:underline;}
  @media(max-width:1024px) {
    .changelog-layout {grid-template-columns:minmax(0,1fr);gap:0;}
    .version-toc {display:none;}
    .version-toc.is-sheet {display:flex;}
  }
  @media(min-width:1025px) {
    .cl-toc-btn {display:none;}
  }
  @media(max-width:640px) {
    .changelog-page {margin-top:1rem;}
    .group-meta {display:none;}
    .group-toggle {font-size:.66rem;padding:.3rem .5rem;}
    .list-head {flex-direction:column;align-items:flex-start;row-gap:.65rem;}
    .list-tools {width:100%;justify-content:space-between;gap:.5rem;}
    .list-tools > span {font-size:.72rem;}
    .gen-group > summary {flex-wrap:wrap;row-gap:.65rem;}
    .group-name {min-width:0;overflow-wrap:anywhere;}
    .group-toggle {margin-left:auto;}
    .version-head {min-height:3.25rem;gap:.5rem;}
    .version-chip {font-size:.72rem;}
    .version-plus {flex-basis:2.5rem;width:2.5rem;height:2.5rem;}
    .changelog-page {margin-top:1.5rem;}
    .gen-list li {grid-template-columns:2rem minmax(0,1fr);row-gap:.35rem;}
    .gen-meta {grid-column:2;flex-direction:row;gap:.6rem;justify-content:flex-start;align-items:baseline;white-space:normal;}
  }
</style>

<script>
  const reduceMotion = () => ((globalThis as any).wendellMotion?.reduce?.() ?? matchMedia('(prefers-reduced-motion: reduce)').matches)
  const label = (element: HTMLElement, expand: boolean) => {
    element.textContent = expand ? '一键收起' : '一键展开'
  }

  document.addEventListener(
    'click',
    (event) => {
      const button = (event.target as HTMLElement | null)?.closest?.('button[data-toggle]') as HTMLElement | null
      if (!button) return
      // 按钮长在 <summary> 里，阻止它顺手把上一级折叠切换掉。
      event.preventDefault()
      event.stopPropagation()

      if (button.dataset.toggle === 'all') {
        const groups = [...document.querySelectorAll<HTMLDetailsElement>('details.gen-group')]
        const shouldOpen = groups.some(group => !group.open)
        groups.forEach((group) => {
          group.open = shouldOpen
          group.querySelectorAll<HTMLDetailsElement>('details.version-block').forEach((version) => {
            version.open = shouldOpen
          })
          const groupButton = group.querySelector<HTMLElement>('button[data-toggle="group"]')
          if (groupButton) groupButton.textContent = shouldOpen ? '收起全部' : '展开全部'
        })
        label(button, shouldOpen)
        return
      }

      const group = button.closest('details.gen-group') as HTMLDetailsElement | null
      if (!group) return
      const versions = [...group.querySelectorAll<HTMLDetailsElement>('details.version-block')]
      const shouldOpen = !group.open || versions.some(version => !version.open)
      if (shouldOpen) group.open = true
      versions.forEach((version) => { version.open = shouldOpen })
      button.textContent = shouldOpen ? '收起全部' : '展开全部'
    },
    true,
  )

  const tocBody = document.querySelector<HTMLElement>('.toc-body')
  const gauge = document.querySelector<HTMLElement>('.toc-gauge')
  const posLabel = document.querySelector<HTMLElement>('[data-toc-pos]')
  const totalLabel = document.querySelector<HTMLElement>('[data-toc-total]')

  const updateTocFade = () => {
    if (!tocBody) return
    const max = tocBody.scrollHeight - tocBody.clientHeight
    tocBody.classList.toggle('can-up', tocBody.scrollTop > 2)
    tocBody.classList.toggle('can-down', max > 2 && tocBody.scrollTop < max - 2)
  }

  // Keep a single index rail for the visible generation, not a bar per version.
  const paintToc = (links: HTMLElement[], visibleIds: Set<string>, firstLink: HTMLElement | null) => {
    const group = firstLink?.closest<HTMLElement>('details.toc-group') ?? null
    const groupLinks = group ? [...group.querySelectorAll<HTMLElement>('a.toc-link')] : []
    const groupKey = group?.dataset.gen ?? ''
    if (gauge && gauge.dataset.group !== groupKey) {
      gauge.replaceChildren(...groupLinks.map(link => {
        const tick = document.createElement('span')
        tick.className = 'tick'
        tick.dataset.target = link.dataset.target ?? ''
        return tick
      }))
      gauge.dataset.group = groupKey
    }
    if (totalLabel) totalLabel.textContent = String(groupLinks.length)
    const firstIndex = firstLink ? groupLinks.indexOf(firstLink) : -1
    if (posLabel) posLabel.textContent = String(firstIndex >= 0 ? firstIndex + 1 : 0)
    gauge?.querySelectorAll<HTMLElement>('.tick').forEach((tick, index) => {
      tick.classList.toggle('current', visibleIds.has(tick.dataset.target ?? ''))
      tick.classList.toggle('done', firstIndex > index)
    })
    links.forEach((link, i) => {
      const active = visibleIds.has(link.dataset.target ?? '')
      const prev = links[i - 1]
      const next = links[i + 1]
      const sameGroup = (other: HTMLElement | undefined) => other?.closest('.toc-group') === link.closest('.toc-group')
      link.classList.toggle('is-current', active)
      link.classList.toggle('range-start', active && !(sameGroup(prev) && visibleIds.has(prev?.dataset.target ?? '')))
      link.classList.toggle('range-end', active && !(sameGroup(next) && visibleIds.has(next?.dataset.target ?? '')))
    })
    updateTocFade()
  }

  const revealToc = (firstLink: HTMLElement) => {
    const group = firstLink.closest<HTMLDetailsElement>('details.toc-group')
    document.querySelectorAll<HTMLDetailsElement>('.toc-group').forEach((item) => {
      item.open = item === group
    })
  }

  let tocRaf = 0
  let tocKey = ''
  let tocUserScrolledAt = 0
  let tocUnlockTimer = 0

  // Match the article TOC: keep the current visible version centered in the
  // directory viewport, but never fight the user's own directory scrolling.
  const centerCurrentTocItem = (target: HTMLElement | null) => {
    if (!tocBody || !target || Date.now() - tocUserScrolledAt < 1200) return
    const max = tocBody.scrollHeight - tocBody.clientHeight
    if (max <= 2) return
    const itemRect = target.getBoundingClientRect()
    const bodyRect = tocBody.getBoundingClientRect()
    const offset = itemRect.top - bodyRect.top + tocBody.scrollTop
    const next = Math.max(0, Math.min(max, offset - (tocBody.clientHeight - itemRect.height) / 2))
    if (Math.abs(tocBody.scrollTop - next) < 4) return
    tocBody.scrollTop = next
    updateTocFade()
  }

  const markTocUserScroll = () => {
    tocUserScrolledAt = Date.now()
    window.clearTimeout(tocUnlockTimer)
    tocUnlockTimer = window.setTimeout(() => {
      syncToc()
    }, 1250)
  }
  const syncToc = () => {
    tocRaf = 0
    const vh = window.innerHeight
    const topEdge = 60
    const bottomEdge = vh - 60
    const blocks = [...document.querySelectorAll<HTMLElement>('details.version-block')]
    const links = [...document.querySelectorAll<HTMLElement>('a.toc-link')]
    // Only take actual on-screen version rows into account: a closed parent
    // generation keeps its descendants in the DOM, but they have no layout box.
    const visible = blocks.filter((block) => {
      if (block.closest('details.gen-group:not([open])')) return false
      const rect = block.getBoundingClientRect()
      return rect.height > 0 && rect.top < bottomEdge && rect.bottom > topEdge
    })
    // The footer is beyond the versions: anchor the index to the oldest
    // chronological entry, not whichever 2026 entry happened to stay selected.
    const atPageEnd = window.scrollY + vh >= document.documentElement.scrollHeight - 16
    if (atPageEnd && blocks.length) {
      visible.splice(0, visible.length, blocks[blocks.length - 1])
    } else if (!visible.length) {
      const passed = blocks.filter((block) => {
        if (block.closest('details.gen-group:not([open])')) return false
        const rect = block.getBoundingClientRect()
        return rect.height > 0 && rect.top <= bottomEdge
      })
      if (passed.length) visible.push(passed[passed.length - 1])
      else {
        const first = blocks.find((block) => !block.closest('details.gen-group:not([open])'))
        if (first) visible.push(first)
      }
    }
    const visibleIds = new Set(visible.map((block) => block.id))
    const firstBlock = visible[0]
    const lastBlock = visible[visible.length - 1]
    const firstLink = firstBlock ? links.find((link) => link.dataset.target === firstBlock.id) ?? null : null
    const lastLink = lastBlock ? links.find((link) => link.dataset.target === lastBlock.id) ?? null : null
    const key = visible.map((block) => block.id).join('|')
    if (key !== tocKey) {
      tocKey = key
      if (firstLink) revealToc(firstLink)
    }
    paintToc(links, visibleIds, firstLink)
    centerCurrentTocItem(firstLink)
  }

  tocBody?.addEventListener('wheel', markTocUserScroll, { passive: true })
  tocBody?.addEventListener('touchmove', markTocUserScroll, { passive: true })
  tocBody?.addEventListener('pointerdown', markTocUserScroll)
  window.addEventListener('scroll', () => {
    if (!tocRaf) tocRaf = requestAnimationFrame(syncToc)
  }, { passive: true })
  window.addEventListener('resize', syncToc)
  tocBody?.addEventListener('scroll', updateTocFade, { passive: true })
  window.addEventListener('resize', updateTocFade)
  syncToc()

  const openVersion = (id: string) => {
    const target = document.getElementById(id)
    let node: HTMLElement | null = target
    while (node) {
      if (node instanceof HTMLDetailsElement) node.open = true
      node = node.parentElement
    }
    return target
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as HTMLElement | null)?.closest?.('a.toc-link') as HTMLAnchorElement | null
    if (!link) return
    const id = link.dataset.target
    if (!id) return
    event.preventDefault()
    const target = openVersion(id)
    rebase(1400)
    target?.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'start' })
  })

  document.querySelectorAll<HTMLDetailsElement>('details.version-block').forEach((version) => {
    version.addEventListener('toggle', () => {
      if (version.open) syncToc()
    })
  })

  const feedbackSection = document.getElementById('changelog-comments')

  // —— 浮动操作条：反馈与评论 / 版本目录 / 进度与回顶（同时收起全部版本）——
  const actions = document.getElementById('changelog-actions')
  const actionComment = actions?.querySelector<HTMLButtonElement>('[data-cl-comment]')
  const actionToc = actions?.querySelector<HTMLButtonElement>('[data-cl-toc]')
  const actionTop = actions?.querySelector<HTMLButtonElement>('[data-cl-top]')
  const actionPct = actions?.querySelector<HTMLElement>('[data-cl-num]')
  const progressBar = document.getElementById('changelog-progress-bar')
  const tocPanel = document.querySelector<HTMLElement>('.version-toc')
  const tocShade = document.querySelector<HTMLElement>('[data-cl-shade]')
  let rebaseUntil = 0
  // 程序自己滚动（点评论、点目录、回顶）时别把「滚过一段」算作用户在滚
  const rebase = (ms = 900) => {
    rebaseUntil = Date.now() + ms
  }

  const setTocPanel = (open: boolean) => {
    if (!tocPanel) return
    tocPanel.classList.toggle('is-sheet', open)
    if (tocShade) tocShade.hidden = !open
    actionToc?.setAttribute('aria-expanded', String(open))
    document.documentElement.classList.toggle('cl-toc-open', open)
    if (open) {
      requestAnimationFrame(() => {
        const body = tocPanel.querySelector<HTMLElement>('.toc-body')
        const current = tocPanel.querySelector<HTMLElement>('a.toc-link.is-current')
        if (!body || !current) return
        const box = body.getBoundingClientRect()
        const item = current.getBoundingClientRect()
        body.scrollTop += item.top - box.top - box.height / 2 + item.height / 2
      })
    }
  }

  actionComment?.addEventListener('click', () => {
    if (!feedbackSection) return
    const align = () => {
      const top = window.scrollY + feedbackSection.getBoundingClientRect().top - 72
      // 一次到位：长距离平滑滚动在手机上常被下一次手势打断，变成「点一下走一段」
      window.scrollTo({ top: Math.max(0, top), behavior: 'auto' })
    }
    align()
    requestAnimationFrame(() => {
      align()
      window.setTimeout(align, 320)
    })
    rebase()
    collapse()
  })
  actionToc?.addEventListener('click', () => {
    setTocPanel(!tocPanel?.classList.contains('is-sheet'))
  })
  tocShade?.addEventListener('click', () => setTocPanel(false))
  document.querySelector('[data-cl-toc-close]')?.addEventListener('click', () => setTocPanel(false))
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setTocPanel(false)
  })
  document.addEventListener('click', (event) => {
    if (!tocPanel?.classList.contains('is-sheet')) return
    const target = event.target as HTMLElement | null
    if (target?.closest('a.toc-link')) {
      setTocPanel(false)
      rebase()
    }
  })
  // 抽屉是手机形态；窗口放大到桌面宽度就把面板关掉，否则会盖满屏还锁着滚动
  const wideQuery = window.matchMedia('(min-width: 1025px)')
  const closeOnWide = () => {
    if (wideQuery.matches) setTocPanel(false)
  }
  wideQuery.addEventListener('change', closeOnWide)
  window.addEventListener('resize', closeOnWide, { passive: true })

  const updateProgress = () => {
    const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight)
    const percent = Math.min(100, Math.max(0, Math.round((window.scrollY / max) * 100)))
    if (actionPct) actionPct.textContent = `${percent}`
    actions?.classList.toggle('at-end', percent >= 99)
    actions?.classList.toggle('is-visible', window.scrollY > 220)
    if (progressBar) progressBar.style.transform = `scaleX(${percent / 100})`
    // 反馈区滚到视口上沿（或已到页底）时，评论气泡就没必要留着了
    if (feedbackSection) {
      const top = feedbackSection.getBoundingClientRect().top
      const near = top < 150 || percent >= 97
      actions?.classList.toggle('hide-comment', near)
    }
  }
  // 每帧最多算一次
  let progressRaf = 0
  const scheduleProgress = () => {
    if (progressRaf) return
    progressRaf = requestAnimationFrame(() => {
      progressRaf = 0
      updateProgress()
    })
  }
  window.addEventListener('scroll', scheduleProgress, { passive: true })
  window.addEventListener('resize', scheduleProgress)
  // 展开/收起版本块、评论 iframe 载入都会改变页面高度，百分比要跟着重算
  if ('ResizeObserver' in window) {
    new ResizeObserver(scheduleProgress).observe(document.body)
  }
  scheduleProgress()

  // —— 胶囊：收起时只剩「进度数字」，点开才向左展开另两颗；展开时该键变成向上箭头 ——
  //    展开后只要屏幕滚过一段距离就自动收回，回到「显示进度数字」的样子
  const COLLAPSE_SCROLL = 140
  let expandY = 0
  const expanded = () => !!actions && !actions.classList.contains('is-collapsed')
  const collapse = () => {
    actions?.classList.add('is-collapsed')
    actionTop?.setAttribute('aria-expanded', 'false')
    actionTop?.setAttribute('aria-label', '展开浮动按钮')
    actionTop?.setAttribute('title', '展开')
  }
  const expand = () => {
    actions?.classList.remove('is-collapsed')
    expandY = window.scrollY
    actionTop?.setAttribute('aria-expanded', 'true')
    actionTop?.setAttribute('aria-label', '收起所有版本并上滑')
    actionTop?.setAttribute('title', '收起所有版本并上滑')
  }
  collapse()
  window.addEventListener('scroll', () => {
    if (!expanded()) return
    // 程序滚动期间把基准跟着挪，只有用户自己滚才收起
    if (Date.now() < rebaseUntil) {
      expandY = window.scrollY
      return
    }
    if (Math.abs(window.scrollY - expandY) >= COLLAPSE_SCROLL) collapse()
  }, { passive: true })

  actionTop?.addEventListener('click', () => {
    if (!expanded()) {
      // 收起态：到页底时这一下是回顶，否则是展开左侧两颗
      if (actions?.classList.contains('at-end')) {
        document.querySelectorAll<HTMLDetailsElement>('details.version-block').forEach((version) => { version.open = false })
        rebase()
        window.scrollTo({ top: 0, behavior: reduceMotion() ? 'auto' : 'smooth' })
        syncToc()
        return
      }
      expand()
      return
    }
    // 展开态：收起所有版本 + 上滑回顶，胶囊自己缩回去
    document.querySelectorAll<HTMLDetailsElement>('details.version-block').forEach((version) => { version.open = false })
    rebase()
    window.scrollTo({ top: 0, behavior: reduceMotion() ? 'auto' : 'smooth' })
    syncToc()
    collapse()
  })

  // —— 版本级轻反馈：只记在本机，不假造汇总数字 ——
  const STORE_KEY = 'changelog-feedback:v1'
  type Vote = { vote: 'up' | 'down'; note?: string; at: string }

  const readVotes = (): Record<string, Vote> => {
    try {
      const raw = localStorage.getItem(STORE_KEY)
      const parsed = raw ? JSON.parse(raw) : {}
      return parsed && typeof parsed === 'object' ? parsed : {}
    } catch {
      return {}
    }
  }

  const writeVotes = (votes: Record<string, Vote>) => {
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify(votes))
    } catch {
      /* 隐私模式下写不进去就算了 */
    }
  }

  const paintRow = (row: HTMLElement) => {
    const key = row.dataset.vkey
    if (!key) return
    const record = readVotes()[key]
    row.querySelectorAll<HTMLElement>('[data-vote]').forEach((button) => {
      button.classList.toggle('is-on', !!record && button.dataset.vote === record.vote)
    })
    const state = row.querySelector<HTMLElement>('[data-vstate]')
    if (!state) return
    if (record?.note) {
      state.textContent = `已记下：${record.note}`
      state.hidden = false
    } else if (record) {
      state.textContent = '已记下'
      state.hidden = false
    } else {
      state.textContent = ''
      state.hidden = true
    }
  }

  const paintAll = () => {
    document.querySelectorAll<HTMLElement>('.version-feedback').forEach(paintRow)
  }

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null
    const row = target?.closest?.('.version-feedback') as HTMLElement | null
    if (!row || !target) return
    const key = row.dataset.vkey
    if (!key) return

    const voteButton = target.closest<HTMLElement>('[data-vote]')
    if (voteButton) {
      event.preventDefault()
      const votes = readVotes()
      const current = votes[key]
      const vote = voteButton.dataset.vote === 'down' ? 'down' : 'up'
      if (current && current.vote === vote) delete votes[key]
      else votes[key] = { vote, note: current?.note, at: new Date().toISOString() }
      writeVotes(votes)
      paintRow(row)
      return
    }

    const noteButton = target.closest<HTMLElement>('[data-vnote]')
    if (noteButton) {
      event.preventDefault()
      const form = row.querySelector<HTMLElement>('[data-vform]')
      if (!form) return
      const next = form.hidden
      form.hidden = !next
      noteButton.setAttribute('aria-expanded', String(next))
      if (next) form.querySelector<HTMLInputElement>('input[name="note"]')?.focus()
      return
    }

    const saveButton = target.closest<HTMLElement>('[data-vsave]')
    if (saveButton) {
      event.preventDefault()
      const input = row.querySelector<HTMLInputElement>('[data-vform] input[name="note"]')
      const text = (input?.value ?? '').trim().slice(0, 60)
      const votes = readVotes()
      const current = votes[key]
      if (!text) {
        const state = row.querySelector<HTMLElement>('[data-vstate]')
        if (state) {
          state.textContent = '写一句再记下。'
          state.hidden = false
        }
        input?.focus()
        return
      }
      votes[key] = {
        vote: current?.vote ?? 'up',
        note: text,
        at: new Date().toISOString(),
      }
      writeVotes(votes)
      paintRow(row)
      const form = row.querySelector<HTMLElement>('[data-vform]')
      if (form) form.hidden = true
      row.querySelector<HTMLElement>('[data-vnote]')?.setAttribute('aria-expanded', 'false')
      return
    }

    const moveButton = target.closest<HTMLElement>('[data-vmove]')
    if (moveButton) {
      event.preventDefault()
      const input = row.querySelector<HTMLInputElement>('[data-vform] input[name="note"]')
      const text = (input?.value ?? '').trim()
      const area = document.querySelector<HTMLTextAreaElement>('[data-feedback] textarea[name="message"]')
      if (!area) return
      const prefix = `关于 ${key} 的补充：`
      area.value = text ? `${prefix}${text}` : prefix
      const form = row.querySelector<HTMLElement>('[data-vform]')
      if (form) form.hidden = true
      row.querySelector<HTMLElement>('[data-vnote]')?.setAttribute('aria-expanded', 'false')
      if (input) input.value = ''
      const count = row.querySelector<HTMLElement>('[data-vcount]')
      if (count) count.textContent = '0'
      moveButton.setAttribute('hidden', '')
      showState('已挪到下面的反馈框，接着写完再发送。')
      document.getElementById('changelog-comments')?.scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'start' })
      area.focus({ preventScroll: true })
      const end = area.value.length
      area.setSelectionRange(end, end)
    }
  })

  document.addEventListener('input', (event) => {
    const input = event.target
    if (!(input instanceof HTMLInputElement) || !input.matches('[data-vform] input[name="note"]')) return
    const row = input.closest<HTMLElement>('.version-feedback')
    if (!row) return
    const count = row.querySelector<HTMLElement>('[data-vcount]')
    if (count) count.textContent = String(input.value.length)
    const move = row.querySelector<HTMLElement>('[data-vmove]')
    if (move) move.hidden = input.value.trim().length < 24
  })

  // —— 页面级反馈表单：没有后端，走邮件或复制 ——
  const MAIL = 'yenchiu.he@gmail.com'

  const readFeedback = () => {
    const panel = document.querySelector<HTMLElement>('[data-feedback]')
    const message = (panel?.querySelector<HTMLTextAreaElement>('textarea[name="message"]')?.value ?? '').trim()
    const contact = (panel?.querySelector<HTMLInputElement>('input[name="contact"]')?.value ?? '').trim()
    return { message, contact }
  }

  const collectReport = () => {
    const { message, contact } = readFeedback()
    const votes = readVotes()
    const marked = Object.entries(votes).map(([key, value]) => `${key} ${value.vote === 'up' ? '有用' : '没用'}${value.note ? `（${value.note}）` : ''}`)
    return [
      message,
      contact ? `联系方式：${contact}` : '',
      marked.length ? `点过的版本：\n${marked.join('\n')}` : '',
      `页面：${location.href}`,
      `时间：${new Date().toLocaleString('zh-CN', { hour12: false })}`,
    ].filter(Boolean).join('\n\n')
  }

  const showState = (text: string) => {
    const state = document.querySelector<HTMLElement>('[data-feedback] [data-state]')
    if (!state) return
    state.textContent = text
    state.hidden = false
  }

  document.querySelector<HTMLElement>('[data-send]')?.addEventListener('click', () => {
    const { message } = readFeedback()
    if (!message) {
      showState('先写点什么再发送。')
      document.querySelector<HTMLTextAreaElement>('[data-feedback] textarea[name="message"]')?.focus()
      return
    }
    const report = collectReport()
    const subject = '站点反馈 · 更新日志'
    location.href = `mailto:${MAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(report)}`
    showState('已调起邮件客户端；如果没有反应，点「复制内容」再粘到别处。')
  })

  const legacyCopy = (text: string) => {
    const area = document.createElement('textarea')
    area.value = text
    area.setAttribute('readonly', '')
    area.style.position = 'fixed'
    area.style.top = '-1000px'
    area.style.opacity = '0'
    document.body.appendChild(area)
    area.select()
    let ok = false
    try {
      ok = document.execCommand('copy')
    } catch {
      ok = false
    }
    area.remove()
    return ok
  }

  const copyText = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      const written = await Promise.race([
        navigator.clipboard.writeText(text).then(() => true).catch(() => false),
        new Promise<boolean>(resolve => setTimeout(() => resolve(false), 800)),
      ])
      if (written) return true
    }
    return legacyCopy(text)
  }

  document.querySelector<HTMLElement>('[data-copy]')?.addEventListener('click', async () => {
    const report = collectReport()
    if (!report) return
    if (await copyText(report)) {
      showState('已复制到剪贴板。')
      return
    }
    const area = document.querySelector<HTMLTextAreaElement>('[data-feedback] textarea[name="message"]')
    if (area) {
      area.focus()
      area.select()
      showState('浏览器不让脚本复制，内容已选中，按 Ctrl / ⌘ + C 复制。')
      return
    }
    showState('复制被浏览器拦住了，手动全选文字复制一下。')
  })

  paintAll()
  document.addEventListener('astro:page-load', paintAll)
</script>
