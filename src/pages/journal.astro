---
import PageLayout from '@/layouts/BaseLayout.astro'
import { sitePath } from '@/utils/site-path'

const paper = {
  title: '多模态视觉的机制、边界与前沿',
  subtitle: '从图像表示到统一 token 空间的综述',
  author: 'Wendell',
  pages: 'pp. 1–13',
  url: 'https://yenchiu.com/journal/2026-01-multimodal-vision/',
  pdf: 'https://yenchiu.com/WendellManual/assets/files/yubai/2026-01-multimodal-vision.pdf'
}

// 封面用的程序化“halftone”网格：一张图被采样成点阵，轮廓用点色标出。
const cols = 30
const rows = 15
const cell = 8
const cx = cols * 0.44
const cy = rows * 0.5
const sx = cols * 0.24
const sy = rows * 0.3
const mosaic = []
for (let y = 0; y < rows; y += 1) {
  for (let x = 0; x < cols; x += 1) {
    const d = Math.exp(
      -(((x - cx) * (x - cx)) / (2 * sx * sx) + ((y - cy) * (y - cy)) / (2 * sy * sy))
    )
    const contour = d > 0.22 && d < 0.4
    const opacity = contour ? 0.95 : Number(Math.max(0.05, d * 0.82).toFixed(3))
    mosaic.push({ x: x * cell, y: y * cell, opacity, accent: contour })
  }
}
---

<PageLayout meta={{ title: '余白 · Margin', description: '个人自出版中文期刊，关注机器如何看。' }}>
  <main class='journal-page'>
    <section class='cover' aria-labelledby='cover-title'>
      <div class='cover__text'>
        <p class='cover__issue'>第 1 卷 · 第 1 期 · 2026</p>
        <h1 id='cover-title' class='cover__title'>
          <span class='cover__title-cn'>余白</span>
          <span class='cover__title-en'>Margin</span>
        </h1>
        <p class='cover__lead'>
          第一期聊「机器怎么看图片」。从基础概念读起，能说明白的尽量说明白，没弄清的也不遮掩。
        </p>
        <p class='cover__meta'>{paper.author} · {paper.pages} · 开放获取 · CC BY 4.0</p>
      </div>

      <div class='cover__visual' aria-hidden='true'>
        <svg viewBox={`0 0 ${cols * cell} ${rows * cell}`} role='presentation'>
          {mosaic.map((item) => (
            <rect
              x={item.x}
              y={item.y}
              width={cell - 1.6}
              height={cell - 1.6}
              opacity={item.opacity}
              class={item.accent ? 'cell cell--accent' : 'cell'}
            />
          ))}
        </svg>
        <p class='cover__caption'>图像 → 切块 → token</p>
      </div>
    </section>

    <section class='issue-toc'>
      <h2 class='label'>本期目录</h2>
      <a class='paper' href={paper.url}>
        <span class='paper__no'>01</span>
        <span class='paper__body'>
          <span class='paper__title'>{paper.title}</span>
          <span class='paper__sub'>{paper.subtitle}</span>
          <span class='paper__meta'>综述 · {paper.pages} · 中文</span>
        </span>
        <span class='paper__go'>阅读全文</span>
      </a>
      <p class='issue-toc__pdf'>
        <a href={paper.pdf}>下载 PDF</a>
        <span>适合离线阅读与打印</span>
      </p>
    </section>

    <section class='about'>
      <h2 class='label'>关于本刊</h2>
      <div class='about__body'>
        <p>
          「余白」就是页面上故意留着的空白。每期挑一个题目，从问题、方法一路写到目前还没解决的地方，
          写到哪儿算哪儿，不硬凑一个漂亮结论。
        </p>
        <p>
          由 Wendell 个人编辑与出版，开放获取，暂无 ISSN，未实行外部同行评审。
          文章以 CC BY 4.0 协议授权，欢迎引用、翻译与讨论。
        </p>
      </div>
      <p class='about__back'><a href={sitePath('/docs')}>← 返回文档与期刊</a></p>
    </section>
  </main>
</PageLayout>

<style>
  .journal-page {
    padding-block: 1.5rem 5rem;
  }

  .cover {
    /* 封面是一张“印出来的纸”，不跟随明暗主题翻转。 */
    --cover-paper: hsl(240 12% 7%);
    --cover-ink: hsl(40 24% 96%);
    --cover-accent: hsl(267 74% 70%);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 2.5rem;
    align-items: center;
    min-height: clamp(19rem, 38vh, 24rem);
    padding: clamp(1.8rem, 4.5vw, 3.25rem);
    background: var(--cover-paper);
    color: var(--cover-ink);
  }

  .cover__issue {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    opacity: 0.6;
  }

  .cover__title {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    margin: 1.1rem 0 0;
    line-height: 0.95;
  }

  .cover__title-cn {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 680;
    letter-spacing: -0.04em;
  }

  .cover__title-en {
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    opacity: 0.55;
  }

  .cover__lead {
    max-width: 26em;
    margin: 1.35rem 0 0;
    font-size: 0.95rem;
    line-height: 1.85;
    opacity: 0.82;
  }

  .cover__meta {
    margin: 1.6rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    opacity: 0.55;
  }

  .cover__visual {
    justify-self: end;
    width: 100%;
    max-width: 22rem;
  }

  .cover__visual svg {
    display: block;
    width: 100%;
    height: auto;
    shape-rendering: crispEdges;
  }

  .cover__visual .cell {
    fill: var(--cover-ink);
  }

  .cover__visual .cell--accent {
    fill: var(--cover-accent);
  }

  .cover__caption {
    margin: 0.7rem 0 0;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-align: right;
    opacity: 0.5;
  }

  .label {
    margin: 0 0 1.1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: hsl(var(--muted-foreground));
  }

  .issue-toc {
    margin-top: 3.25rem;
  }

  .paper {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.5rem 0.4rem 1.5rem 0;
    border-top: 2.5px solid hsl(var(--foreground));
    border-bottom: 1px solid hsl(var(--border));
    color: inherit;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }

  .paper:hover {
    background: hsl(var(--foreground) / 0.022);
  }

  .paper__no {
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
    font-variant-numeric: tabular-nums;
  }

  .paper__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .paper__title {
    font-size: clamp(1.2rem, 2.4vw, 1.55rem);
    font-weight: 620;
    letter-spacing: -0.02em;
    line-height: 1.35;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.18s ease;
  }

  .paper:hover .paper__title {
    text-decoration-color: hsl(var(--primary));
  }

  .paper__sub {
    font-size: 0.9rem;
    line-height: 1.75;
    color: hsl(var(--muted-foreground));
  }

  .paper__meta {
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: hsl(var(--muted-foreground));
  }

  .paper__go {
    font-size: 0.84rem;
    color: hsl(var(--foreground));
    border-bottom: 1px solid hsl(var(--primary));
    padding-bottom: 0.15rem;
    white-space: nowrap;
  }

  .issue-toc__pdf {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin: 1rem 0 0;
    font-size: 0.84rem;
    color: hsl(var(--muted-foreground));
  }

  .issue-toc__pdf a {
    color: hsl(var(--foreground));
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    text-decoration-color: hsl(var(--muted-foreground) / 0.5);
  }

  .issue-toc__pdf a:hover {
    color: hsl(var(--primary));
    text-decoration-color: hsl(var(--primary));
  }

  .about {
    margin-top: 3.25rem;
  }

  .about__body {
    max-width: 38em;
  }

  .about__body p {
    margin: 0 0 1.1em;
    font-size: 0.92rem;
    line-height: 1.85;
    color: hsl(var(--muted-foreground));
  }

  .about__back {
    margin: 1.8rem 0 0;
    font-size: 0.85rem;
  }

  .about__back a {
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    border-bottom: 1px solid hsl(var(--border));
    padding-bottom: 0.15rem;
  }

  .about__back a:hover {
    color: hsl(var(--primary));
    border-bottom-color: hsl(var(--primary));
  }

  @media (max-width: 820px) {
    .cover {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
      align-items: start;
    }

    .cover__visual {
      justify-self: start;
      max-width: 16rem;
      order: -1;
    }

    .cover__caption {
      text-align: left;
    }

    .paper {
      grid-template-columns: 2rem minmax(0, 1fr);
      gap: 0.75rem;
    }

    .paper__go {
      display: none;
    }
  }
</style>
