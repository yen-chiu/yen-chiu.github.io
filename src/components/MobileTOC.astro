---
interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  headings: Heading[]
  label?: string
  /** 只在窄屏显示，默认 769px 以下 */
  breakpoint?: number
}

const { headings, label = '目录', breakpoint = 769 } = Astro.props
const items = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .map((heading) => ({ ...heading, text: heading.text.replace(/#+\s*$/, '').trim() }))
  .filter((heading) => heading.text.length > 0)
---

{
  items.length > 1 && (
    <div class='mm-toc' data-mobile-toc data-breakpoint={breakpoint}>
      <button class='mm-toc-fab' type='button' aria-expanded='false' aria-controls='mm-toc-sheet' aria-label={`打开${label}`}>
        <svg viewBox='0 0 24 24' aria-hidden='true' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'>
          <path d='M4 6h16M4 12h11M4 18h7' />
        </svg>
        <span>{label}</span>
      </button>
      <div class='mm-toc-backdrop' data-mm-close hidden />
      <div class='mm-toc-sheet' id='mm-toc-sheet' role='dialog' aria-modal='true' aria-labelledby='mm-toc-title' hidden>
        <header class='mm-toc-head'>
          <p id='mm-toc-title'>{label}</p>
          <button class='mm-toc-close' type='button' data-mm-close aria-label='关闭目录'>
            <svg viewBox='0 0 24 24' aria-hidden='true' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'>
              <path d='M6 6l12 12M18 6L6 18' />
            </svg>
          </button>
        </header>
        <nav class='mm-toc-body'>
          <ol class='mm-toc-list'>
            {items.map((heading) => (
              <li class={`mm-toc-item mm-toc-h${heading.depth}`}>
                <a href={`#${heading.slug}`} data-mm-link>
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  )
}

<style>
  .mm-toc-fab {
    position: fixed;
    right: 0.85rem;
    bottom: 4.6rem;
    z-index: 55;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.8rem 0.5rem 0.65rem;
    border: 1px solid hsl(var(--border));
    border-radius: 999px;
    background: hsl(var(--background) / 0.92);
    backdrop-filter: blur(10px);
    color: hsl(var(--muted-foreground));
    font-size: 0.78rem;
    line-height: 1;
    box-shadow:
      0 1px 2px hsl(var(--foreground) / 0.05),
      0 12px 28px -18px hsl(var(--foreground) / 0.45);
    cursor: pointer;
    transition:
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .mm-toc-fab svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .mm-toc-fab:hover,
  .mm-toc-fab[aria-expanded='true'] {
    color: hsl(var(--primary));
    border-color: hsl(var(--primary) / 0.45);
  }

  .mm-toc-fab:active {
    transform: scale(0.97);
  }

  .mm-toc-backdrop {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: hsl(var(--foreground) / 0.28);
    backdrop-filter: blur(2px);
  }

  .mm-toc-sheet {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 61;
    max-height: 72vh;
    display: flex;
    flex-direction: column;
    padding: 0.9rem 0.9rem calc(0.9rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid hsl(var(--border));
    border-radius: 1.15rem 1.15rem 0 0;
    background: hsl(var(--background));
    box-shadow: 0 -18px 48px -30px hsl(var(--foreground) / 0.5);
  }

  .mm-toc-sheet[hidden],
  .mm-toc-backdrop[hidden] {
    display: none;
  }

  .mm-toc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid hsl(var(--border));
  }

  .mm-toc-head p {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: hsl(var(--foreground));
  }

  .mm-toc-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid transparent;
    color: hsl(var(--muted-foreground));
    background: transparent;
    cursor: pointer;
  }

  .mm-toc-close:hover {
    color: hsl(var(--primary));
    border-color: hsl(var(--border));
  }

  .mm-toc-close svg {
    width: 1rem;
    height: 1rem;
  }

  .mm-toc-body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-top: 0.4rem;
    min-height: 0;
  }

  .mm-toc-list {
    margin: 0;
    padding: 0 0 0.2rem;
    list-style: none;
    counter-reset: mm-toc;
  }

  .mm-toc-item a {
    display: block;
    padding: 0.55rem 0.6rem;
    border-radius: 0.55rem;
    font-size: 0.88rem;
    line-height: 1.45;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
  }

  .mm-toc-h2 > a {
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .mm-toc-h3 > a {
    padding-left: 1.7rem;
    font-size: 0.84rem;
  }

  .mm-toc-item a:hover {
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.07);
  }

  .mm-toc-item a[aria-current='true'] {
    color: hsl(var(--primary));
    background: hsl(var(--primary) / 0.1);
    font-weight: 600;
  }

  html.mm-toc-open,
  html.mm-toc-open body {
    overflow: hidden;
  }

  @media (min-width: 770px) {
    .mm-toc {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .mm-toc-sheet[data-entering] {
      animation: mm-toc-up 220ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .mm-toc-backdrop[data-entering] {
      animation: mm-toc-fade 180ms ease-out;
    }
  }

  @keyframes mm-toc-up {
    from {
      transform: translateY(8%);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes mm-toc-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

<script>
  const setup = (root: HTMLElement) => {
    if (root.dataset.ready === 'true') return
    root.dataset.ready = 'true'

    const fab = root.querySelector<HTMLButtonElement>('.mm-toc-fab')
    const sheet = root.querySelector<HTMLElement>('.mm-toc-sheet')
    const backdrop = root.querySelector<HTMLElement>('.mm-toc-backdrop')
    const closeButton = root.querySelector<HTMLButtonElement>('.mm-toc-close')
    const links = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-mm-link]'))
    if (!fab || !sheet || !backdrop) return

    let lastFocus: HTMLElement | null = null

    const open = () => {
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
      sheet.hidden = false
      backdrop.hidden = false
      sheet.setAttribute('data-entering', '')
      backdrop.setAttribute('data-entering', '')
      fab.setAttribute('aria-expanded', 'true')
      document.documentElement.classList.add('mm-toc-open')
      window.setTimeout(() => {
        sheet.removeAttribute('data-entering')
        backdrop.removeAttribute('data-entering')
      }, 260)
      closeButton?.focus({ preventScroll: true })
    }

    const close = () => {
      if (sheet.hidden) return
      sheet.hidden = true
      backdrop.hidden = true
      fab.setAttribute('aria-expanded', 'false')
      document.documentElement.classList.remove('mm-toc-open')
      if (lastFocus) lastFocus.focus({ preventScroll: true })
    }

    fab.addEventListener('click', () => (sheet.hidden ? open() : close()))
    root.querySelectorAll('[data-mm-close]').forEach((node) => node.addEventListener('click', close))
    links.forEach((link) => link.addEventListener('click', () => window.setTimeout(close, 40)))
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close()
    })

    // 当前小节高亮（只在本组件打开时才需要滚动位置）
    const headings = links
      .map((link) => {
        const id = decodeURIComponent(link.hash.replace(/^#/, ''))
        const target = document.getElementById(id)
        return target ? { link, target } : null
      })
      .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => item !== null)

    if (headings.length && 'IntersectionObserver' in window) {
      const setCurrent = (active: HTMLElement | null) => {
        headings.forEach(({ link }) => link.removeAttribute('aria-current'))
        if (active) active.setAttribute('aria-current', 'true')
      }
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting)
          if (!visible.length) return
          const top = visible
            .map((entry) => entry.target)
            .sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top)[0]
          const match = headings.find((item) => item.target === top)
          if (match) setCurrent(match.link)
        },
        { rootMargin: '-88px 0px -70% 0px', threshold: 0 }
      )
      headings.forEach(({ target }) => observer.observe(target))
    }
  }

  const boot = () => {
    document.querySelectorAll<HTMLElement>('[data-mobile-toc]').forEach(setup)
  }

  boot()
  document.addEventListener('astro:page-load', boot)
</script>
