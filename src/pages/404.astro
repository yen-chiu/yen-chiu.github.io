---
import PageLayout from '@/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog')).filter((post) => !post.data.draft)
const base = (import.meta.env?.BASE_URL ?? '/').replace(/\/$/, '')

const nfItems = posts.map((post) => ({
  title: post.data.title,
  url: `${base}/blog/${post.data.slug}`,
  date: post.data.publishDate ? post.data.publishDate.toISOString() : '',
  search: [post.data.title, post.data.description, ...(post.data.tags ?? [])].filter(Boolean).join(' ')
}))

const nfIndex = JSON.stringify(nfItems)

const meta = {
  title: '404 · 这一页没有被印出来',
  description: '地址可能改过，也可能它只是草稿里的一句话。',
  noindex: true
}
---

<PageLayout {meta}>
  <div class='nf-wrap'>
    <svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute;left:-9999px" aria-hidden="true" focusable="false"><symbol id="nf-fox" viewBox="0 0 153 191">
