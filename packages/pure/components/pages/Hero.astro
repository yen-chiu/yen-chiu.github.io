---
import { Image } from 'astro:assets'
import type { InferEntrySchema } from 'astro:content'

import { FormattedDate, Icon } from '../user'

interface Props {
  data: InferEntrySchema<'blog'>
  remarkPluginFrontmatter: Record<string, unknown>
}

const {
  data: { title, description, draft, heroImage, publishDate, updatedDate, tags, language },
  remarkPluginFrontmatter
} = Astro.props

const dateTimeOptions: Intl.DateTimeFormatOptions = {
  month: 'short'
}
---

{
  heroImage && (
    <div class='hero-image relative mb-6'>
      <Image
        alt={heroImage.alt || title}
        class='cover-image relative z-10 h-auto w-full max-w-[65ch] rounded-2xl object-contain'
        {...heroImage}
        fetchpriority='high'
        loading='eager'
        decoding='async'
        widths={[360, 540, 720, 960, 1200]}
        sizes='(max-width: 767px) calc(100vw - 2rem), (max-width: 1200px) 75vw, 65ch'
      />
    </div>
  )
}

{draft ? <span class='text-red-500'>(Draft)</span> : null}

<div class='article-info max-lg:mx-auto'>
  <div class='article-meta flex flex-wrap gap-x-4 gap-y-2 text-xs leading-6 text-muted-foreground'>
    {/* Article date */}
    <div class='flex items-center gap-1'>
      <Icon name='calendar' class='size-5' />
      <FormattedDate class='font-sans' date={publishDate} dateTimeOptions={dateTimeOptions} />
      {
        updatedDate && (
          <div class='flex items-center gap-1'>
            <span> / </span>
            <span>
              Update
              <FormattedDate
                class='font-sans'
                date={updatedDate}
                dateTimeOptions={dateTimeOptions}
              />
            </span>
          </div>
        )
      }
    </div>
    {/* Times read */}
    <div class='flex items-center gap-1'>
      <Icon name='time' class='size-5' />
      {remarkPluginFrontmatter.minutesRead}
    </div>
    {
      // Language
      language && (
        <span class='flex items-center gap-1'>
          <Icon name='earth' class='size-5' />
          {language}
        </span>
      )
    }

  </div>

  <h1 class='article-title mt-4 text-2xl font-medium sm:mb-2 sm:mt-6 sm:text-3xl'>
    {title}
  </h1>

  <div class='article-intro mt-3'>
    <p class='article-summary text-sm text-muted-foreground'>{description}</p>
    <slot name='description' />
  </div>
  <div class='article-tags-row'>
    {
      // Tags
      !!tags?.length && (
        <div class='article-tags' aria-label='文章标签'>
          <Icon name='hashtag' class='size-5' />
          <div class='article-tags__list'>
            {tags.map((tag: string) => (
              <a aria-label={`查看标签 ${tag} 的文章`} data-pagefind-filter='tag'
                href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
            ))}
          </div>
        </div>
      )
    }
  </div>
</div>

{/* Dividing line */}
<div class='article-divider mt-6 border-t'></div>



<style>
  .article-info { display: flex; flex-direction: column; }
  .article-title { order: 1; max-width: 28ch; line-height: 1.32; letter-spacing: -.025em; text-wrap: pretty; }
  .article-intro { order: 2; }
  .article-tags-row { order: 3; margin-top: 1rem; }
  .article-meta { order: 0; }
  .article-divider { width: 100%; margin-top: 2rem; margin-bottom: 2.5rem; border-color: hsl(var(--foreground) / .16); }
  .article-summary { max-width: 65ch; margin: 0; font-style: normal; line-height: 1.8; overflow-wrap: anywhere; }
  .article-intro { margin-top: .8rem; }
  @media (max-width: 767px) {
    .article-meta { gap: .35rem .9rem; font-size: .76rem; }
    .article-meta :global(svg) { width: 1rem; height: 1rem; }
    .article-title { font-size: clamp(1.65rem, 6.3vw, 2.1rem); line-height: 1.38; margin-top: 1.1rem; font-weight: 650; }
    .article-summary { font-size: .92rem; line-height: 1.75; }
    .article-tags { margin-top: .35rem; }
    .article-tags__list a { font-size: .72rem; padding: .08rem .5rem; border-radius: 999px; }
    .article-title { font-weight: 600; }
    .article-intro { margin-top: 1rem; }
    .article-tags-row { margin-top: .85rem; }
    .article-divider { margin-top: 1.65rem; margin-bottom: 2.25rem; width: 100%; margin-inline: 0; }
  }
  .article-tags{display:flex;align-items:flex-start;gap:.4rem;min-width:0;max-width:100%;flex-basis:100%;}
  .article-tags :global(svg){flex-shrink:0;margin-top:.2rem;}
  .article-tags__list{display:flex;flex-wrap:wrap;gap:.3rem .4rem;min-width:0;}
  .article-tags__list a{display:inline-block;max-width:100%;padding:.05rem .45rem;border:1px solid hsl(var(--border));border-radius:.4rem;line-height:1.7;overflow-wrap:anywhere;background:hsl(var(--muted)/.4);}
  .article-tags__list a:hover{color:hsl(var(--primary));border-color:hsl(var(--primary));}

</style>
