---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import config from 'virtual:config'
import { Icon } from 'astro-pure/user'
import Search from './Search.astro'
import AppearancePanel from './appearance/AppearancePanel.astro'
import InteractiveAvatar from './InteractiveAvatar.astro'
import { sitePath } from '@/utils/site-path'

const images=import.meta.glob<{default:ImageMetadata}>('/src/assets/*.{jpeg,jpg,png,gif,avif,webp}')
const logoImage=images[config.logo.src] ? await images[config.logo.src]() : null
// Icon-labelled groups and single expanded section follow Mizuki's NavMenuPanel.
const groups=[
  {title:'阅读',icon:'document',items:[
    {title:'分类',icon:'package',href:'/categories'},
    {title:'标签',icon:'hashtag',href:'/tags'},{title:'时光机',icon:'calendar',href:'/archives'}
  ]},
  {title:'探索',icon:'earth',items:[
    {title:'知识图谱',icon:'earth',action:'graph'},{title:'文件管理器',icon:'package',action:'folders'},
    {title:'标签云',icon:'hashtag',action:'tags'},{title:'文档',icon:'document',href:'/docs'},
    {title:'链接',icon:'link',href:'/links'},{title:'项目',icon:'bulb',href:'/projects'}
  ]},
  {title:'念真',icon:'moon',items:[
    {title:'念真介绍',icon:'moon',href:'/persona'},{title:'进入聊天',icon:'link',href:'https://yenchiu.com/chat/'}
  ]},
  {title:'关于',icon:'info',items:[
    {title:'关于我',icon:'info',href:'/about'},{title:'站点历程',icon:'time',href:'/about#journey'},
    {title:'更新日志',icon:'list',href:'/about#changelog'}
  ]}
] as const
---
<!-- Recreate the header on navigation so scoped styles and markup stay in sync after deployments. -->
<header-component class='site-header group'>
  <div class='brand'>
    {logoImage && <InteractiveAvatar variant='header' label='Wendell 的头像'><Image id='header-avatar' src={logoImage.default} alt={config.logo.alt || 'Avatar'} width={64} height={64} loading='eager' /></InteractiveAvatar>}
    <a href={sitePath('/')} aria-label={`${config.title}，返回首页`} data-astro-prefetch><span>{config.title}</span></a>
  </div>
  <div id='headerExpandContent' class='navigation-panel'>
    <nav aria-label='主导航'>
      <a class='nav-reading' href={sitePath('/blog')}>
        <svg class='cat-writing' viewBox='0 0 32 32' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M17 26H12C6 26 3 22 3 17c0-3 1-5 3-7L7 3l6 5h6l6-5 1 8'/>
          <path d='M9 16q2-3 4 0m4 0q2-3 4 0M7 20l2 .5m5 .5 1 1 1-1'/>
          <g class='cat-pen'><path d='m18 27 2-7L27 13a2.1 2.1 0 0 1 3 3l-7 7-5 4Zm2-7 3 3m-5 4 4-5'/></g>
        </svg>
        <span>博客</span>
        <svg class='ink-sparkle' viewBox='0 0 12 12' fill='currentColor' aria-hidden='true'><path d='M6 0 7.5 4.5 12 6 7.5 7.5 6 12 4.5 7.5 0 6 4.5 4.5Z'/></svg>
      </a>
      <a class='nav-home' href={sitePath('/')}><Icon name='location' />首页</a>
      {groups.map(group=><details class='nav-group'>
        <summary><Icon name={group.icon}/><span>{group.title}</span><i class='chevron' aria-hidden='true'></i></summary>
        <div class='nav-submenu'>
          {group.items.map(item=>'href' in item ?
            <a href={sitePath(item.href)} target={item.href.startsWith('https:')?'_blank':undefined} rel={item.href.startsWith('https:')?'noopener noreferrer':undefined}>
              <Icon name={item.icon}/><span>{item.title}</span>{item.href.startsWith('https:')&&<small aria-hidden='true'>↗</small>}
            </a> :
            <button type='button' data-graph-open={item.action==='graph'?'':undefined} data-category-open={item.action==='folders'?'':undefined} data-tagcloud-trigger={item.action==='tags'?'':undefined}><Icon name={item.icon}/><span>{item.title}</span></button>
          )}
        </div>
      </details>)}
    </nav>
  </div>
  <div class='header-tools'>
    <a class='mobile-reading' href={sitePath('/blog')}>博客 <span aria-hidden='true'>↗</span></a>
    <Search />
    <button type='button' id='toggleAppearance' aria-label='外观设置' aria-expanded='false' aria-controls='appearance-panel'>
      <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' aria-hidden='true'><path d='M12 3a9 9 0 1 0 0 18h1a2.5 2.5 0 0 0 1.8-4.2c-.8-.8-.2-2.1.9-2.1H18a3 3 0 0 0 3-3C21 6.8 17 3 12 3Z'/><circle cx='7.5' cy='11' r='.8'/><circle cx='10' cy='7' r='.8'/><circle cx='15' cy='7.5' r='.8'/></svg>
    </button>
    <button type='button' id='toggleMenu' aria-label='菜单' aria-controls='headerExpandContent' aria-expanded='false'><Icon name='menu'/></button>
  </div>
  <AppearancePanel/>
</header-component>
<script>
  class HeaderComponent extends HTMLElement {
    private controller?:AbortController
    connectedCallback(){
      this.controller?.abort();this.controller=new AbortController()
      const {signal}=this.controller
      const menu=this.querySelector<HTMLButtonElement>('#toggleMenu')!
      const appearance=this.querySelector<HTMLButtonElement>('#toggleAppearance')!
      const panel=this.querySelector<HTMLElement>('#appearance-panel')!
      const closeGroups=()=>this.querySelectorAll<HTMLDetailsElement>('.nav-group[open]').forEach(d=>d.open=false)
      const closeNav=()=>{this.classList.remove('expanded');menu.setAttribute('aria-expanded','false');closeGroups()}
      const closeAppearance=()=>{panel.hidden=true;appearance.setAttribute('aria-expanded','false')}
      const closeAll=()=>{closeNav();closeAppearance()}
      menu.addEventListener('click',()=>{
        const open=!this.classList.contains('expanded')
        closeAll();this.classList.toggle('expanded',open);menu.setAttribute('aria-expanded',String(open))
      },{signal})
      appearance.addEventListener('click',()=>{
        const open=panel.hidden;closeAll();panel.hidden=!open;appearance.setAttribute('aria-expanded',String(open))
      },{signal})
      this.querySelector('[data-appearance-close]')?.addEventListener('click',()=>{closeAppearance();appearance.focus()},{signal})
      this.addEventListener('toggle',event=>{
        const target=event.target
        if(!(target instanceof HTMLDetailsElement)||!target.classList.contains('nav-group')||!target.open)return
        this.querySelectorAll<HTMLDetailsElement>('.nav-group').forEach(other=>{if(other!==target)other.open=false})
      },{capture:true,signal})
      this.addEventListener('click',event=>{
        const target=event.target as Element
        if(target.closest('summary'))closeAppearance()
        if(target.closest('a,[data-graph-open],[data-tagcloud-trigger],[data-category-open],.search-button'))closeAll()
      },{signal})
      document.addEventListener('pointerdown',event=>{if(!this.contains(event.target as Node))closeAll()},{signal})
      document.addEventListener('keydown',event=>{
        if(event.key!=='Escape')return
        const wasAppearance=!panel.hidden,wasMenu=this.classList.contains('expanded')||!!this.querySelector('.nav-group[open]')
        closeAll()
        if(wasAppearance)appearance.focus()
        else if(wasMenu&&matchMedia('(max-width:900px)').matches)menu.focus()
      },{signal})
      document.addEventListener('astro:before-swap',closeAll,{signal})
      document.addEventListener('focusin',event=>{if(!this.contains(event.target as Node))closeAll()},{signal})
      const sync=()=>{
        closeAll()
        const path=location.pathname.replace(/\/$/,'')
        this.querySelectorAll<HTMLAnchorElement>('nav a,.mobile-reading').forEach(a=>{
          const destination=new URL(a.href).pathname.replace(/\/$/,'')
          const readingLink=a.matches('.mobile-reading,.nav-reading')
          const current=!a.hash&&(destination===path||(readingLink&&path.startsWith(destination+'/')))
          if(current)a.setAttribute('aria-current','page');else a.removeAttribute('aria-current')
        })
      }
      document.addEventListener('astro:page-load',sync,{signal});sync()
    }
    disconnectedCallback(){this.controller?.abort()}
  }
  if(!customElements.get('header-component'))customElements.define('header-component',HeaderComponent)
</script>
<style>
  header-component{display:flex;align-items:center;justify-content:space-between;gap:1rem;position:sticky;top:1rem;z-index:50;isolation:isolate;margin:0 0 2rem;padding:.55rem .7rem;min-height:58px;border:1px solid hsl(var(--border)/.7);border-radius:1rem;}
  header-component::before{content:'';position:absolute;inset:0;z-index:-1;background:hsl(var(--background)/.84);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-radius:inherit;box-shadow:0 6px 24px hsl(var(--foreground)/.05);pointer-events:none;}
  .brand{display:flex;align-items:center;gap:.55rem;font-size:1.1rem;font-weight:650;white-space:nowrap;flex-shrink:0;}
  .brand :global(img){width:34px;height:34px;border-radius:50%;object-fit:cover;border:1px solid hsl(var(--border));}
  .header-tools{display:flex;align-items:center;gap:.15rem;}
  .header-tools>button{display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:.7rem;background:transparent;cursor:pointer;color:inherit;flex-shrink:0;}
  .header-tools :global(.search-button){width:44px;height:44px;padding:0;border-radius:.7rem;}
  .header-tools :global(svg){width:21px;height:21px;}
  .header-tools>button:hover,.header-tools>button[aria-expanded=true]{background:hsl(var(--primary)/.1);color:hsl(var(--primary));}
  #toggleMenu{display:none;}
  nav{display:flex;gap:.15rem;}
  .nav-group{position:relative;}
  summary,.nav-home,.nav-reading{display:flex;align-items:center;gap:.45rem;min-height:40px;padding:.4rem .65rem;border-radius:.6rem;font-size:.85rem;font-weight:550;cursor:pointer;list-style:none;}
  summary::-webkit-details-marker{display:none;}
  summary :global(svg),.nav-home :global(svg),.nav-reading :global(svg),.nav-submenu :global(svg){width:18px;height:18px;flex-shrink:0;color:hsl(var(--primary));}
  summary:hover,.nav-group[open]>summary{color:hsl(var(--primary));background:hsl(var(--primary)/.09);}
  .chevron{width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(45deg);margin-left:auto;}
  .nav-group[open]>summary .chevron{transform:rotate(225deg);}
  .nav-submenu{position:absolute;top:calc(100% + .55rem);left:0;width:13rem;padding:.4rem;background:hsl(var(--background)/.92);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid hsl(var(--border)/.7);border-radius:.85rem;box-shadow:0 12px 35px hsl(var(--foreground)/.12);}
  .nav-submenu :is(a,button){display:flex;align-items:center;gap:.65rem;width:100%;min-height:42px;padding:.55rem .65rem;border:0;border-radius:.5rem;text-align:left;font:inherit;font-size:.82rem;color:inherit;background:transparent;cursor:pointer;}
  .nav-submenu :is(a,button):hover,.nav-submenu a[aria-current=page]{background:hsl(var(--primary)/.1);color:hsl(var(--primary));}
  .nav-submenu small{margin-left:auto;}
  .nav-home,.mobile-reading{display:none;}
  .nav-reading{display:inline-flex;flex-direction:row;position:relative;white-space:nowrap;color:inherit;transition:background .2s,color .2s;}
  .nav-reading .cat-writing{width:24px;height:24px;overflow:visible;color:hsl(var(--primary));}
  .cat-pen{transform-origin:23px 21px;transition:transform .2s;}
  .ink-sparkle{position:absolute;right:3px;top:3px;width:9px!important;height:9px!important;opacity:0;transform:scale(.5);transition:opacity .2s,transform .2s;pointer-events:none;}
  .nav-reading:is(:hover,:focus-visible){color:hsl(var(--primary));}
  .nav-reading:is(:hover,:focus-visible) .ink-sparkle{opacity:1;transform:scale(1);}
  .nav-reading:is(:hover,:focus-visible) .cat-pen{transform:rotate(-8deg);}
  .mobile-reading{color:hsl(var(--primary));}
  @media(prefers-reduced-motion:reduce){.nav-reading,.cat-pen,.ink-sparkle{transition:none;}.nav-reading:is(:hover,:focus-visible) .cat-pen{transform:none;}}
  .nav-reading:hover,.nav-reading[aria-current=page],.mobile-reading{background:hsl(var(--primary)/.1);}
  .mobile-reading{align-items:center;gap:.35rem;min-height:44px;padding:.45rem .8rem;border-radius:.7rem;font-size:.85rem;font-weight:600;white-space:nowrap;}
  :is(a,button,summary):focus-visible{outline:2px solid hsl(var(--primary));outline-offset:2px;}
  @media(max-width:1050px){summary{padding-inline:.45rem;gap:.3rem;}summary :global(svg){display:none;}.brand span{font-size:1rem;}}
  @media(max-width:900px){
    #toggleMenu{display:grid;}
    .mobile-reading{display:flex;}
    .nav-reading{display:none;}
    .navigation-panel{display:none;position:absolute;top:calc(100% + .6rem);right:0;width:min(17.5rem,calc(100vw - 2rem));max-height:calc(100dvh - 6rem);overflow:auto;overscroll-behavior:contain;padding:.5rem;border:1px solid hsl(var(--border)/.7);border-radius:1.1rem;background:hsl(var(--background)/.88);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 14px 40px hsl(var(--foreground)/.14);}
    .expanded .navigation-panel{display:block;}
    nav{display:block;}
    summary,.nav-home,.nav-reading{min-height:44px;padding:.65rem .7rem;font-size:.88rem;gap:.7rem;}
    summary :global(svg){display:block;}
    .nav-home{display:flex;}
    .nav-group{position:static;}
    .nav-submenu{position:static;width:100%;padding:.1rem 0 .35rem 1.1rem;background:transparent;backdrop-filter:none;border:0;box-shadow:none;}
    .nav-submenu :is(a,button){min-height:42px;font-size:.82rem;}
  }
  @media(max-width:600px){header-component{gap:.3rem;padding:.4rem .5rem;margin-bottom:1.25rem;}.brand span{display:none;}.brand :global(img){width:32px;height:32px;}.header-tools{gap:0;}}
  @media(max-width:370px){.mobile-reading{padding-inline:.6rem;}.mobile-reading span{display:none;}}
</style>
