---
const { label = '轻触头像，打个招呼', variant = 'default' } = Astro.props
---

<interactive-avatar data-variant={variant}><span class='avatar-aura' aria-hidden='true'></span><span class='avatar-orbit' aria-hidden='true'><span class='avatar-star'></span></span><button type='button' aria-label={label}><slot /></button><span class='avatar-ripple' aria-hidden='true'></span></interactive-avatar>
<script>
  import { createAvatarTapCounter, FOCUS_URL } from '@/utils/avatar-easter-egg'
  class InteractiveAvatar extends HTMLElement {
    private controller?: AbortController
    private ripple?: Animation
    private verificationTimer = 0
    private verificationOverlay?: HTMLDivElement
    private clearVerification() {
      window.clearTimeout(this.verificationTimer)
      this.verificationOverlay?.remove()
      this.verificationOverlay = undefined
    }
    private startVerification() {
      if (document.querySelector('[data-verification-transition]')) return
      const overlay = document.createElement('div')
      overlay.className = 'verification-transition'
      overlay.dataset.verificationTransition = ''
      overlay.setAttribute('role', 'status')
      overlay.setAttribute('aria-live', 'polite')
      overlay.tabIndex = -1
      overlay.innerHTML = `<div class="verification-transition-copy"><span class="verification-spinner" aria-hidden="true"></span><strong>正在检查访问环境…</strong><span>请稍候，即将继续访问</span></div>`
      document.body.appendChild(overlay)
      this.verificationOverlay = overlay
      overlay.focus()
      this.verificationTimer = window.setTimeout(() => window.location.assign(FOCUS_URL), 1100)
    }
    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller,
        button = this.querySelector('button')!
      const reduced = matchMedia('(prefers-reduced-motion: reduce)')
      const motionReduced = () => (globalThis as any).wendellMotion?.reduce?.() ?? reduced.matches
      const tappedFiveTimes = createAvatarTapCounter()
      button.addEventListener(
        'click',
        () => {
          this.ripple?.cancel()
          if (tappedFiveTimes(performance.now())) {
            this.startVerification()
            return
          }
          if (!motionReduced()) {
            const ripple = this.querySelector<HTMLElement>('.avatar-ripple')
            this.ripple = ripple?.animate(
              [
                { transform: 'scale(.78)', opacity: 0.65 },
                { transform: 'scale(1.45)', opacity: 0 }
              ],
              { duration: 650, easing: 'cubic-bezier(.2,.7,.3,1)' }
            )
          }
        },
        { signal }
      )
      document.addEventListener(
        'astro:before-swap',
        () => {
          this.ripple?.cancel()
          this.clearVerification()
        },
        { signal }
      )
      window.addEventListener('pagehide', () => this.clearVerification(), { signal })
    }
    disconnectedCallback() {
      this.controller?.abort()
      this.ripple?.cancel()
      this.clearVerification()
    }
  }
  if (!customElements.get('interactive-avatar'))
    customElements.define('interactive-avatar', InteractiveAvatar)
</script>
<style>
  :global(.verification-transition) {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: grid;
    place-items: center;
    background: #f6f7f9;
    color: #253044;
    animation: verification-enter 180ms ease-out;
  }
  :global(.verification-transition-copy) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    padding: 24px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Microsoft YaHei', sans-serif;
  }
  :global(.verification-transition-copy strong) { font-size: 17px; font-weight: 550; }
  :global(.verification-transition-copy > span:last-child) { font-size: 12px; color: #788292; }
  :global(.verification-spinner) {
    width: 28px;
    height: 28px;
    margin-bottom: 6px;
    border: 2px solid #dce2eb;
    border-top-color: #3569ab;
    border-radius: 50%;
    animation: verification-spin 800ms linear infinite;
  }
  @keyframes verification-enter { from { opacity: 0; } to { opacity: 1; } }
  @keyframes verification-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    :global(.verification-transition), :global(.verification-spinner) { animation: none; }
  }
  interactive-avatar {
    --avatar-gold: hsl(39 65% 73%);
    position: relative;
    display: inline-grid;
    place-items: center;
    isolation: isolate;
    border-radius: 50%;
  }
  .avatar-aura,
  .avatar-orbit,
  .avatar-ripple {
    position: absolute;
    inset: -9px;
    border-radius: 50%;
    pointer-events: none;
  }
  .avatar-aura {
    z-index: -1;
    inset: -13px;
    background: radial-gradient(circle, hsl(var(--primary) / .14) 44%, hsl(39 65% 73% / .12) 58%, transparent 73%);
    animation: avatar-breathe 6s ease-in-out infinite;
  }
  .avatar-orbit {
    z-index: 2;
    border: 1px solid hsl(39 65% 73% / .18);
    opacity: .35;
    transition: opacity .4s ease, border-color .4s ease;
  }
  .avatar-star {
    position: absolute;
    top: -2px;
    left: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--avatar-gold);
    box-shadow: 0 0 8px 2px hsl(39 65% 73% / .3);
    transform: translateX(-50%);
    opacity: 0;
  }
  .avatar-ripple {
    z-index: 3;
    inset: -5px;
    border: 1px solid var(--avatar-gold);
    opacity: 0;
  }
  button {
    position: relative;
    z-index: 1;
    display: block;
    border: 0;
    background: transparent;
    padding: 0;
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 0 0 1px hsl(var(--primary) / .12);
  }
  interactive-avatar:hover .avatar-orbit,
  interactive-avatar:focus-within .avatar-orbit {
    opacity: .85;
    border-color: hsl(39 65% 73% / .5);
  }
  interactive-avatar:hover .avatar-star,
  interactive-avatar:focus-within .avatar-star {
    opacity: 1;
    animation: avatar-star-pass .8s ease-in-out both;
  }
  interactive-avatar[data-variant='header'] .avatar-aura,
  interactive-avatar[data-variant='header'] .avatar-orbit,
  interactive-avatar[data-variant='header'] .avatar-ripple { display: none; }
  button:focus-visible {
    outline: 3px solid hsl(var(--primary));
    outline-offset: 6px;
  }
  button :global(img) {
    display: block;
    border-radius: 50%;
    object-fit: cover;
  }
  @keyframes avatar-breathe {
    0%, 100% { opacity: .32; }
    50% { opacity: .65; }
  }
  @keyframes avatar-star-pass {
    0% { transform: translateX(-50%) rotate(0deg) translateY(0); opacity: 0; }
    25% { opacity: 1; }
    100% { transform: translateX(-50%) translate(24px, 7px); opacity: 0; }
  }
  @media (hover: none) {
    interactive-avatar:hover .avatar-star { animation: none; opacity: 0; }
    interactive-avatar:hover .avatar-orbit { opacity: .35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar-aura, .avatar-star { animation: none !important; }
    .avatar-aura { opacity: .32; }
    .avatar-orbit { transition: none; }
  }
</style>
