---
import { BackToTop } from 'astro-pure/components/pages'
import type { SiteMeta } from 'astro-pure/types'
import { Button, Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import { integ } from '@/site-config'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  back?: string
  hideBack?: boolean
  mainClass?: string
  sidebarClass?: string
  mode?: 'default' | 'article' | 'centered' | 'wide'
  commentTarget?: string
  graphTarget?: string
}

const {
  meta,
  highlightColor,
  back = '/',
  hideBack = false,
  mainClass,
  sidebarClass,
  mode = 'default',
  commentTarget,
  graphTarget,
  ...props
} = Astro.props

const hasSidebar = mode === 'default' || mode === 'article'
const isSingleColumn = mode === 'centered' || mode === 'wide'
---

<PageLayout {meta} {highlightColor} {...props}>
  <div class='reading-progress' aria-hidden='true'>
    <div id='reading-progress-bar' class='reading-progress-bar'></div>
  </div>
  {
    !hideBack && mode !== 'article' && (
      <Button
        title='Back'
        href={back}
        onclick='history.back(); return false;'
        data-astro-prefetch='false'
        variant='back'
      />
    )
  }
  <main
    class={cn(
      'mt-6 items-start',
      mode === 'article'
        ? 'article-reading-layout'
        : isSingleColumn
          ? mode === 'wide'
            ? 'single-page-layout single-page-wide'
            : 'single-page-layout single-page-centered'
          : 'gap-x-10 md:flex',
      mainClass
    )}
  >
    {
      mode === 'article' && (
        <aside class='article-left-rail animate'>
          <slot name='left-sidebar' />
        </aside>
      )
    }
    {
      hasSidebar && (
        <>
          {/* Sidebar */}
          <aside
            class={cn(
              'animate top-20 min-w-48 basis-60 overflow-y-scroll max-md:hidden z-40 fixed md:sticky md:order-2 lg:shrink-0 max-md:border max-md:px-4 max-md:py-3 max-md:bg-muted max-md:rounded-xl',
              mode === 'article' && 'article-toc-rail',
              sidebarClass
            )}
            style='max-height:calc(100vh - 7rem); display: flex; flex-direction: column;'
            id='sidebar'
          >
            <div class='drawer-head'>
              <span class='drawer-title'>本文目录</span>
              <span class='drawer-count' data-drawer-count></span>
              <button type='button' class='drawer-close' data-drawer-close aria-label='关闭目录'>
                <svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' aria-hidden='true'>
                  <path d='M6 6l12 12M18 6L6 18'></path>
                </svg>
              </button>
            </div>
            <div class='drawer-progress' aria-hidden='true'><span data-drawer-progress></span></div>
            <slot name='sidebar' />
          </aside>
          <div
            id='sidebar-shade'
            class='fixed top-0 start-0 w-full h-full'
            style='display:none;background-color:#00000091;z-index:31'
          />
        </>
      )
    }

    <article
      class={cn(
        'min-w-0 grow',
        mode === 'article' && 'article-reading-column',
        isSingleColumn && 'single-page-column'
      )}
    >
      {/* Content header */}
      <div id='content-header' class='animate'>
        <slot name='header' />
      </div>

      {/* Content */}
      <div
        id='content'
        class={cn(
          'max-w-none animate mt-4 md:min-w-[45ch] overflow-x-hidden',
          integ.typography.class
        )}
      >
        <slot />
      </div>
      <slot name='content-after' />
    </article>
  </main>

  <div
    class={cn(
      'bottom mt-6 items-start gap-x-10 md:flex',
      mode === 'article' && 'article-bottom',
      isSingleColumn && [
        'single-page-bottom',
        mode === 'wide' ? 'single-page-wide' : 'single-page-centered'
      ]
    )}
  >
    {/* Bottom */}
    <div class='flex-1 text-muted-foreground md:min-w-[50ch]'>
      <slot name='bottom' />
    </div>
    <div class='min-w-48 basis-60'>
      <slot name='bottom-sidebar' />
    </div>
  </div>

  <BackToTop header='content-header' content='content' slot='overlay'>
    {
      graphTarget && (
        <button
          slot='other-icons'
          type='button'
          aria-label='跳转到知识图谱'
          title='知识图谱'
          class='size-10 flex items-center justify-center rounded-full border-2 border-transparent bg-muted text-muted-foreground duration-300 hover:border-border/75 hover:text-primary sm:size-12'
          data-graph-jump={graphTarget}
        >
          <svg
            viewBox='0 0 24 24'
            class='size-5'
            fill='none'
            stroke='currentColor'
            stroke-width='1.8'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <circle cx='6' cy='6' r='2.25' />
            <circle cx='18' cy='7' r='2.25' />
            <circle cx='8' cy='18' r='2.25' />
            <circle cx='18' cy='17' r='2.25' />
            <path d='m8 6.3 7.8.5M7.2 8l-.4 7.8m3.2 1.8 5.8-.5m1-7.9.4 5.5M8 8l8 7.2' />
          </svg>
        </button>
      )
    }
    {
      commentTarget && (
        <button
          slot='other-icons'
          type='button'
          aria-label='跳转到评论'
          title='评论'
          class='size-10 flex items-center justify-center rounded-full border-2 border-transparent bg-muted text-muted-foreground duration-300 hover:border-border/75 hover:text-primary sm:size-12'
          data-comment-jump={commentTarget}
        >
          <svg
            viewBox='0 0 24 24'
            class='size-5'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            aria-hidden='true'
          >
            <path d='M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z' />
          </svg>
        </button>
      )
    }
    {
      hasSidebar && (
        <button
          slot='other-icons'
          aria-label='Toggle sidebar'
          class='size-10 flex items-center justify-center rounded-full border-2 border-transparent bg-muted text-muted-foreground duration-300 hover:border-border/75 md:hidden sm:size-12'
          id='sidebar-btn'
        >
          <Icon name='list' />
        </button>
      )
    }
  </BackToTop>
</PageLayout>

<script>
  function setupSidebar() {
    const sidebar = document.getElementById('sidebar')
    const sidebarBtn = document.getElementById('sidebar-btn')
    const sidebarShade = document.getElementById('sidebar-shade')

    if (!sidebar || !sidebarBtn || !sidebarShade || sidebarBtn.dataset.sidebarReady === 'true')
      return

    sidebarBtn.dataset.sidebarReady = 'true'

    function toggleSidebar() {
      sidebar?.classList.toggle('show')
      sidebarShade?.classList.toggle('show')
    }

    sidebarBtn.addEventListener('click', toggleSidebar)
    sidebarShade.addEventListener('click', toggleSidebar)

    const closeButton = sidebar.querySelector<HTMLButtonElement>('[data-drawer-close]')
    closeButton?.addEventListener('click', () => {
      sidebar.classList.remove('show')
      sidebarShade.classList.remove('show')
    })

    // 点目录项后立刻收起抽屉，否则跳转被面板挡住看不见
    sidebar.addEventListener('click', (event) => {
      if (!(event.target as HTMLElement | null)?.closest('.toc-item')) return
      sidebar.classList.remove('show')
      sidebarShade.classList.remove('show')
    })

    const counter = sidebar.querySelector<HTMLElement>('[data-drawer-count]')
    if (counter) {
      const total = sidebar.querySelectorAll('a.toc-item').length
      counter.textContent = total > 0 ? `${total} 节` : ''
    }
  }

  function setupReadingProgress() {
    const progressBar = document.getElementById('reading-progress-bar')
    const drawerBar = document.querySelector<HTMLElement>('[data-drawer-progress]')
    const contentEl = document.getElementById('content')
    if (!progressBar || !contentEl || progressBar.dataset.ready === 'true') return

    progressBar.dataset.ready = 'true'
    let ticking = false

    const updateReadingProgress = () => {
      const scrollTop = Math.max(0, window.scrollY || document.documentElement.scrollTop)
      const maxScrollable = Math.max(
        0,
        contentEl.offsetTop + contentEl.scrollHeight - window.innerHeight
      )
      const progress = maxScrollable === 0 ? 0 : Math.min(1, Math.max(0, scrollTop / maxScrollable))
      progressBar.style.transform = `scaleX(${progress})`
      if (drawerBar) drawerBar.style.transform = `scaleX(${progress})`
      ticking = false
    }

    const requestProgressUpdate = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(updateReadingProgress)
    }

    document.addEventListener('scroll', requestProgressUpdate, { passive: true })
    window.addEventListener('resize', requestProgressUpdate)
    updateReadingProgress()
  }

  function setupCommentJump() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-comment-jump]')
    if (!buttons.length) return

    buttons.forEach((button) => {
      if (button.dataset.ready === 'true') return
      button.dataset.ready = 'true'
      button.addEventListener('click', () => {
        const el = document.querySelector(button.dataset.commentJump || '')
        if (!el) return
        // 一次到位：长距离的平滑滚动在手机上容易被下一次手势打断，变成「点一下走一段」；
        // 跳完再补一次校正，防止评论 iframe 撑开后把位置顶下去
        const align = () => window.scrollTo({ top: Math.max(0, window.scrollY + el.getBoundingClientRect().top - 72), behavior: 'auto' })
        align()
        requestAnimationFrame(() => {
          align()
          window.setTimeout(align, 320)
          window.setTimeout(align, 900)
        })
      })
    })

    const actions = document.getElementById('action-buttons')
    const target = document.querySelector(buttons[0].dataset.commentJump || '')
    if (!actions || !target) return

    // 评论已经出现在视野里，就不必再留一个「跳到评论」的按钮
    let ticking = false
    const update = () => {
      ticking = false
      const near = target.getBoundingClientRect().top < 150
      actions.classList.toggle('comment-near', near)
    }
    const request = () => {
      if (ticking) return
      ticking = true
      requestAnimationFrame(update)
    }
    document.addEventListener('scroll', request, { passive: true })
    window.addEventListener('resize', request)
    update()
  }

  function setupGraphJump() {
    document.querySelectorAll<HTMLButtonElement>('[data-graph-jump]').forEach((button) => {
      if (button.dataset.ready === 'true') return
      button.dataset.ready = 'true'
      button.addEventListener('click', () => {
        const target = document.querySelector(button.dataset.graphJump || '')
        if (!target) return

        target.scrollIntoView({ behavior: 'smooth', block: 'center' })
        target.classList.remove('graph-view-locate-highlight')
        void (target as HTMLElement).offsetWidth
        target.classList.add('graph-view-locate-highlight')
        setTimeout(() => target.classList.remove('graph-view-locate-highlight'), 2200)
      })
    })
  }

  setupSidebar()
  setupReadingProgress()
  setupCommentJump()
  setupGraphJump()
  document.addEventListener('astro:page-load', () => {
    setupSidebar()
    setupReadingProgress()
    setupCommentJump()
    setupGraphJump()
  })
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 50;
    height: 3px;
    pointer-events: none;
  }

  :global(.graph-view-locate-highlight .graph-canvas) {
    animation: graph-view-locate 720ms ease-in-out 3;
  }

  @keyframes graph-view-locate {
    0%,
    100% {
      border-color: hsl(var(--border) / 0.6);
      box-shadow: 0 0 0 0 hsl(var(--primary) / 0);
    }
    50% {
      border-color: hsl(var(--primary) / 0.72);
      box-shadow: 0 0 0 0.28rem hsl(var(--primary) / 0.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.graph-view-locate-highlight .graph-canvas) {
      animation: none;
      border-color: hsl(var(--primary) / 0.72);
    }
  }

  .reading-progress-bar {
    width: 100%;
    height: 100%;
    background: hsl(var(--primary));
    box-shadow: 0 0 12px hsl(var(--primary) / 0.45);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 60ms ease-out;
  }

  .drawer-head,
  .drawer-progress {
    display: none;
  }

  :global(#action-buttons.comment-near [data-comment-jump]) {
    display: none;
  }

  @media (min-width: 770px) {
    #sidebar-shade {
      display: none !important;
    }
  }

  @media (max-width: 769px) {
    #sidebar.show {
      display: flex !important;
      pointer-events: auto;
    }

    #sidebar-shade.show {
      display: block !important;
      opacity: 1;
      pointer-events: auto;
      animation: 300ms fade-in-side !important;
      animation-fill-mode: forwards;
    }

    @keyframes fade-in-side {
      0% {
        transform: translateX(50%);
        opacity: 0;
      }
      100% {
        transform: translateX(0);
        opacity: 1;
      }
    }
    #sidebar {
      display: none !important;
      pointer-events: none;
      animation: none !important;
      position: fixed !important;
      right: 0;
      top: 4.25rem !important;
      height: calc(100vh - 4.25rem) !important;
      max-height: calc(100vh - 4.25rem) !important;
      min-width: 40vw !important;
      max-width: 75vw !important;
      overflow: hidden !important;
      border-top-left-radius: 1rem !important;
      border-top-right-radius: 0 !important;
      border-bottom-right-radius: 0 !important;
      border-bottom-left-radius: 0 !important;
      padding: 0 !important;
      background-color: hsl(var(--background)) !important;
      box-shadow: -18px 0 48px -32px hsl(var(--foreground) / 0.55);
    }

    .drawer-head {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex: 0 0 auto;
      padding: 0.95rem 0.9rem 0.7rem 1.1rem;
      border-bottom: 1px solid hsl(var(--border) / 0.7);
    }

    .drawer-title {
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .drawer-count {
      font-size: 0.72rem;
      font-variant-numeric: tabular-nums;
      color: hsl(var(--muted-foreground));
    }

    .drawer-close {
      margin-left: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.9rem;
      height: 1.9rem;
      border-radius: 999px;
      border: 1px solid hsl(var(--border));
      color: hsl(var(--muted-foreground));
      background: transparent;
      cursor: pointer;
    }

    .drawer-close svg {
      width: 0.9rem;
      height: 0.9rem;
    }

    .drawer-close:hover {
      color: hsl(var(--primary));
      border-color: hsl(var(--primary) / 0.45);
    }

    .drawer-progress {
      display: block;
      flex: 0 0 auto;
      height: 2px;
      background: hsl(var(--border) / 0.6);
    }

    .drawer-progress span {
      display: block;
      height: 100%;
      width: 100%;
      transform: scaleX(0);
      transform-origin: left;
      background: hsl(var(--primary));
      transition: transform 80ms linear;
    }

    #sidebar toc-heading {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    /* 抽屉里用我们自己的头部，隐藏主题自带的英文标题 */
    :global(#sidebar toc-heading > div:first-child) {
      display: none !important;
    }

    :global(#sidebar toc-heading) {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    :global(#sidebar .toc-content-wrapper) {
      padding: 0.4rem 0.55rem calc(1rem + env(safe-area-inset-bottom, 0px));
      overflow-y: auto !important;
      scrollbar-width: none;
    }

    :global(#sidebar .toc-content-wrapper::-webkit-scrollbar) {
      display: none;
    }

    :global(#sidebar .toc-content-wrapper ul) {
      margin-top: 0 !important;
    }

    :global(#sidebar .toc-item) {
      display: flex;
      align-items: center;
      min-height: 2.5rem;
      margin: 0 0 1px;
      padding: 0.5rem 0.7rem !important;
      border-radius: 0.6rem;
      font-size: 0.9rem;
      line-height: 1.45;
      color: hsl(var(--muted-foreground)) !important;
    }

    :global(#sidebar .toc-item.ps-7) {
      min-height: 2.2rem;
      font-size: 0.82rem;
      padding-inline-start: 1.9rem !important;
    }

    /* 抽屉里不需要那根浮动的小竖条，用胶囊底表达当前项 */
    :global(#sidebar li > div > span) {
      display: none !important;
    }

    :global(#sidebar .toc-item.highlight-bg-translucent) {
      background: hsl(var(--primary) / 0.1) !important;
      color: hsl(var(--primary)) !important;
      font-weight: 600;
    }

    :global(#action-buttons button) {
      pointer-events: auto !important;
    }
    #sidebar-shade {
      animation: 300ms fade-in;
    }
  }
  @media (max-width: 640px) {
    #sidebar {
      min-width: 55vw !important;
    }
  }
</style>

<style is:global>
  .article-reading-layout {
    width: min(78rem, calc(100vw - 3rem));
    margin-left: calc((100% - min(78rem, calc(100vw - 3rem))) / 2);
    margin-right: 0;
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 44rem) minmax(10rem, 1fr);
    gap: clamp(1rem, 2.5vw, 2rem);
    transform: none;
  }

  .article-reading-column {
    grid-column: 2;
  }

  .article-left-rail {
    position: sticky;
    top: 8.5rem !important;
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    min-width: 0;
    max-height: calc(100vh - 9rem) !important;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    overflow-wrap: anywhere;
    scrollbar-width: thin;
  }

  .article-toc-rail {
    grid-column: 3;
    grid-row: 1;
    align-self: start;
    order: initial;
    min-width: 0;
    max-height: calc(100vh - 9rem) !important;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    position: sticky;
    top: 8.5rem !important;
    scrollbar-width: thin;
  }

  .article-bottom {
    width: min(44rem, 100%);
    margin-inline: auto;
    display: block;
  }

  .article-bottom > :first-child {
    width: 100%;
  }

  .article-bottom > :last-child {
    display: none;
  }

  .single-page-layout,
  .single-page-bottom {
    width: 100%;
    margin-inline: auto;
  }

  .single-page-centered {
    max-width: 52rem;
  }

  .single-page-wide {
    max-width: 64rem;
  }

  .single-page-column,
  .single-page-bottom > :first-child {
    width: 100%;
  }

  .single-page-bottom {
    display: block;
  }

  .single-page-bottom > :last-child {
    display: none;
  }

  @media (max-width: 1199px) and (min-width: 770px) {
    .article-reading-layout {
      width: 100%;
      margin-inline: 0;
      grid-template-columns: minmax(0, 44rem) minmax(11rem, 14rem);
      justify-content: center;
      transform: none;
    }

    .article-reading-column {
      grid-column: 1;
    }

    .article-left-rail {
      display: none;
    }

    .article-toc-rail {
      grid-column: 2;
    }
  }

  /* Mobile: collapse the floating icons into one opaque horizontal capsule so
     they stop cutting into the text block. */
  @media (max-width: 769px) {
    #action-buttons {
      bottom: 0.9rem;
      right: 0.7rem;
      flex-direction: row;
      gap: 0.15rem;
      padding: 0.25rem;
      border: 1px solid hsl(var(--border));
      border-radius: 999px;
      background: hsl(var(--background));
      box-shadow:
        0 1px 2px hsl(var(--foreground) / 0.05),
        0 10px 24px -16px hsl(var(--foreground) / 0.45);
    }

    #action-buttons button {
      width: 2.1rem;
      height: 2.1rem;
      background: transparent;
      color: hsl(var(--muted-foreground));
    }

    #action-buttons button:hover {
      color: hsl(var(--primary));
    }

    /* The graph entry is also reachable from the 探索 menu on mobile. */
    #action-buttons button[data-graph-jump] {
      display: none;
    }

    .article-reading-layout {
      width: 100%;
      margin-inline: 0;
      display: block;
      transform: none;
    }

    /* Keep header, prose and metadata on the same comfortable reading inset.
       The outer site shell already supplies 1rem; this is article-only spacing. */
    .article-reading-column {
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
      padding-inline: clamp(.875rem, 3.5vw, 1.25rem);
    }

    .article-reading-column #content,
    .article-reading-column #content-header {
      min-width: 0;
      max-width: 100%;
    }

    .article-left-rail {
      display: none;
    }

    .article-bottom {
      width: 100%;
    }
  }
</style>
