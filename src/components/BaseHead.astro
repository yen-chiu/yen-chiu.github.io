---

import config from 'virtual:config'
import { sitePath } from '@/utils/site-path'

import { prod } from 'astro-pure/server'
import type { SiteMeta } from 'astro-pure/types'

type Props = SiteMeta & { robots?: 'index, follow' | 'noindex, follow' }

const { articleDate, description, ogImage, title, robots = 'index, follow' } = Astro.props

// 首页等把站点名当作页面标题的场景不要再拼一次站点名，否则会出现「Wendell • Wendell」
const siteTitle = !title || title === config.title ? config.title : `${title} ${config.titleDelimiter} ${config.title}`
// Canonical should reflect the published route, not historical migration URLs or page titles.
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url)
const socialImageURL = new URL(sitePath(ogImage || config.socialCard), Astro.site ?? Astro.url).href
---

<meta charset='utf-8' />
<meta name='robots' content={robots} />
<meta
  content='width=device-width, initial-scale=1.0, shrink-to-fit=no, viewport-fit=cover'
  name='viewport'
/>
<meta content='IE=edge' http-equiv='X-UA-Compatible' />
<title>{siteTitle}</title>

{/* Preconnect hints for third-party origins */}
<link rel='preconnect' href='https://cdn.jsdelivr.net' crossorigin />
<link rel='preconnect' href='https://giscus.app' crossorigin />
<link rel='dns-prefetch' href='https://dummyjson.com' />

{/* Icons / Favicon */}
<link rel='icon' type='image/x-icon' sizes='16x16 32x32 48x48 64x64 128x128 256x256' href={sitePath('/favicon/wendell-avatar.ico')} />
<link rel='icon' type='image/png' sizes='32x32' href={sitePath('/favicon/wendell-avatar-32.png')} />
<link rel='icon' type={config.favicon.type} sizes={config.favicon.type === 'image/svg+xml' ? 'any' : '192x192'} href={sitePath(config.favicon.href)} />
<link rel='apple-touch-icon' sizes='180x180' href={sitePath('/favicon/wendell-avatar-180.png')} />
<link rel='manifest' href={sitePath('/favicon/wendell-avatar.webmanifest')} />

{/* Service worker: network-passthrough, only there so the site is installable */}
{
  prod && (
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function () {})
        })
      }
    </script>
  )
}

{/* Font preloads */}
<style>
  body {
    font-family: system-ui, "PingFang SC", "Microsoft YaHei", sans-serif;
  }
</style>

{/* Canonical URL */}
<link rel='canonical' href={canonicalURL} />

{/* Primary Meta Tags */}
<meta content={siteTitle} name='title' />
<meta content={description} name='description' />
<meta content={config.author} name='author' />

{/* Theme Color */}
{/* <meta content='' name='theme-color' /> */}
<meta name='color-scheme' content='light dark' />

{/* Open Graph / Facebook */}
<meta content={articleDate ? 'article' : 'website'} property='og:type' />
<meta content={title} property='og:title' />
<meta content={description} property='og:description' />
<meta content={canonicalURL} property='og:url' />
<meta content={config.title} property='og:site_name' />
<meta content={config.locale.attrs} property='og:locale' />
<meta content={socialImageURL} property='og:image' />
<meta content='1200' property='og:image:width' />
<meta content='630' property='og:image:height' />
{
  articleDate && (
    <>
      <meta content={config.author} property='article:author' />
      <meta content={articleDate} property='article:published_time' />
    </>
  )
}

{/* Twitter */}
<meta content='summary_large_image' property='twitter:card' />
<meta content={canonicalURL} property='twitter:url' />
<meta content={title} property='twitter:title' />
<meta content={description} property='twitter:description' />
<meta content={socialImageURL} property='twitter:image' />

{/* Sitemap */}
<link href='/sitemap-index.xml' rel='sitemap' />

{/* RSS auto-discovery */}
<link
  rel='alternate'
  type='application/rss+xml'
  title={config.title}
  href={`${Astro.site}rss.xml`}
/>

<meta content={Astro.generator} name='generator' />

{
  /* User script*/
  prod && (
    <script>
      console.log( '%c Astro Theme Vesper 暮星 %c https://github.com/yen-chiu/yen-chiu.github.io/',
      'color:#fff;background:linear-gradient(90deg,#448bff,#44e9ff);padding:5px 0;',
      'color:#000;background:linear-gradient(90deg,#44e9ff,#ffffff);padding:5px 10px 5px 0px;' )
    </script>
  )
}
