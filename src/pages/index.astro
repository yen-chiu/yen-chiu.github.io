---
import PageLayout from '@/layouts/CommonPage.astro'
import { getCollection } from 'astro:content'
const posts = (await getCollection('blog')).filter(p => !p.data.draft).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf())
---
<PageLayout title="Wendell" hideTitle hideBack layout="wide">
<section class="py-12"><h1 class="text-4xl font-bold">Wendell</h1><p class="mt-4 text-muted-foreground">读书，买花，长大。</p>
<nav class="flex gap-6 my-8"><a href="/blog">文章</a><a href="/persona">念真</a><a href="https://yenchiu.com/chat/">与念真聊天</a><a href="/about">关于</a></nav>
<div class="grid gap-6">{posts.map(post=><article class="border rounded-xl p-6"><a href={`/blog/${post.data.slug}`}><h2 class="text-xl font-bold">{post.data.title}</h2></a><p class="mt-2 text-muted-foreground">{post.data.description}</p><time>{post.data.publishDate.toLocaleDateString('zh-CN',{timeZone:'Asia/Shanghai'})}</time></article>)}</div>
</section></PageLayout>
