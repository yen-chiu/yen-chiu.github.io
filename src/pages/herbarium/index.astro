---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { sitePath } from '@/utils/site-path'
import { currentAnniversaryYear, period, statusForYear } from '@/utils/herbarium'
const current = currentAnniversaryYear()
const years = Array.from({ length: current - 2023 + 1 }, (_, i) => current - i)
const statusText = { open: '生长中', pending: '待整理', sealed: '已封存', revised: '已修订' }
---
<BaseLayout meta={{ title: '岁月标本馆', description: 'Vesper 的年度记忆档案：真实作品、Git 提交、重要事件与年度手记。' }}>
  <main class='herbarium'>
    <header class='intro'>
      <p class='eyebrow'>VESPER / THE HERBARIUM</p>
      <h1>岁月标本馆</h1>
      <p class='lede'>把一年的风，夹进时间的书页。</p>
      <p>这里按年收好文章、作品和重要事件。没整理完的年份会标成“待整理”，不装作什么都记全了。</p>
      <a class='tree-link' href={sitePath('/about#vesper-tree')}>回到一树春秋 ↗</a>
    </header>
    <section aria-labelledby='archive-heading'>
      <h2 id='archive-heading'>年度标本</h2>
      <div class='specimens'>
        {years.map((year) => <a class='specimen' href={sitePath(`/herbarium/${year}`)}>
          <span class='no'>SPECIMEN / {String(year - 2022).padStart(3, '0')}</span>
          <span class='year'>{year}</span>
          <span class='period'>{period(year).start} — {period(year).endExclusive}（不含终点）</span>
          <span class='state'>{statusText[statusForYear(year)]}</span>
          <span class='more'>翻阅这一年 ↗</span>
        </a>)}
      </div>
    </section>
    <p class='disclaimer'>每年从 3 月 12 日算起。树的样子是时间模拟；文章和事件则只收有记录可查的内容。</p>
  </main>
</BaseLayout>
<style>
  .herbarium{max-width:960px;margin:0 auto;padding:clamp(5rem,10vw,8rem) 1.2rem 6rem;color:var(--text-color,var(--foreground))}
  .intro{max-width:690px;margin-bottom:3rem}.eyebrow,.no{font-size:.75rem;letter-spacing:.13em;opacity:.65}.intro h1{font-size:clamp(2.2rem,6vw,3.5rem);margin:.6rem 0}.intro p{line-height:1.9}.lede{font-size:1.15rem}.tree-link{display:inline-block;margin-top:1rem;text-decoration:underline;text-underline-offset:4px}
  h2{font-size:1.25rem;margin:1.5rem 0}.specimens{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:1rem}
  .specimen{display:flex;flex-direction:column;gap:.8rem;padding:1.5rem;border:1px solid var(--line-color,rgba(128,128,128,.3));border-radius:1rem;text-decoration:none;color:inherit;background:rgba(128,128,128,.035);transition:transform .2s,border-color .2s}
  .specimen:hover,.specimen:focus-visible{transform:translateY(-3px);border-color:currentColor}.year{font-size:2.5rem;font-weight:650}.period,.state,.more{font-size:.85rem}.period{opacity:.7}.state{align-self:start;border:1px solid currentColor;border-radius:2rem;padding:.2rem .6rem}.more{margin-top:auto}.disclaimer{font-size:.8rem;opacity:.7;line-height:1.8;margin-top:2rem}
  @media(prefers-reduced-motion:reduce){.specimen{transition:none}.specimen:hover{transform:none}}
</style>
