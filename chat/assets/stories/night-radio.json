  "endings": {
    "e_dawn": {
      "title": "天亮之前",
      "summary": "你从楼上下来，看见路灯下真的有一个人。十年没见，第一句话却轻得像昨天刚分开。",
      "quote": "「好久不见。」",
      "hint": "在她要走的那一晚，真的动身下楼。"
    },
    "e_quiet": {
      "title": "安静的退出",
      "summary": "你说早点睡。头像灰下去以后，屋子安静得能听见冰箱在响。",
      "quote": "「晚安。」",
      "hint": "把这段对话交还给深夜。"
    },
    "e_letter": {
      "title": "第二天的消息",
      "summary": "火车开走七个小时后，手机震了一下：一张模糊的车窗，和一句「我到了」。",
      "quote": "「要记得回我。」",
      "hint": "不追出去，但把线留着。"
    },
    "e_unsent": {
      "title": "未寄出的那句",
      "summary": "你打了很久，删了又打。天亮时输入框还亮着，草稿里存着一句没有发出去的话。",
      "quote": "「别走。」",
      "hint": "有些话，说出口和留下来一样难。"
    }
  },
