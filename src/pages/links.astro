---
import BaseLayout from '@/layouts/BaseLayout.astro'
import KnowledgeIndexHero from '@/components/KnowledgeIndexHero.astro'
import { sitePath } from '@/utils/site-path'

import links from '../../public/links.json'
import health from '../../public/links-status.json'
import feedData from '../../public/links-feed.json'
import historyData from '../../public/links-history.json'
import FriendApplyGuide from '@/components/links/FriendApplyGuide.astro'

const groups = links.friends,
  total = groups.reduce((n, g) => n + g.link_list.length, 0)
const info = `名称：Wendell · Vesper
简介：读书，买花，长大。
博客：https://yenchiu.com/
头像：https://yenchiu.com/favicon/wendell-avatar-192.png`
interface HealthEntry { url: string; state: 'healthy' | 'suspect' | 'down'; code: number | null }
interface HistoryEntry { action: string; name: string; url: string; date: string; commit: string }
interface FeedEntry { title: string; url: string; site: string; publishedAt: string | null }
const healthSnapshot = health as { checkedAt: string | null; summary: { healthy: number; suspect: number; down: number }; links: HealthEntry[] }
const healthByUrl = new Map(healthSnapshot.links.map(item => [item.url, item]))
const history = historyData as HistoryEntry[]
const posts = feedData.items as FeedEntry[]
const friendGroup = groups.find(group => group.id_name === 'friends')
const friendDownCount = (friendGroup?.link_list ?? []).filter(link => healthByUrl.get(link.link)?.state === 'down').length
const friendActiveCount = (friendGroup?.link_list.length ?? 0) - friendDownCount
const pendingCount = (friendGroup?.link_list ?? []).filter(link => !healthByUrl.has(link.link)).length
const friendInfo = [
  { name: '名称', val: 'Wendell · Vesper' },
  { name: '简介', val: '读书，买花，长大。' },
  { name: '博客', val: 'https://yenchiu.com/' },
  { name: '头像', val: 'https://yenchiu.com/favicon/wendell-avatar-192.png' }
]
---

<BaseLayout meta={{ title: '链接', description: '我的网络角落、开源主题和友好邻居。' }}>
  <main class='links-page'>
    <KnowledgeIndexHero
      icon='link'
      eyebrow='WEB NEIGHBORHOOD'
      title='链接'
      description='常去的地方，认真做的站点，以及慢慢认识的朋友。'
      stats={[
        { label: '收录站点', value: total },
        { label: '分组', value: groups.length },
        { label: '友好邻居', value: groups.find(group=>group.id_name==='friends')?.link_list.length??0 }
      ]}
      statsLabel='链接统计'
      symbol='↗'
    />
    <link-directory>
      <div class='directory-tools'>
        <div class='group-tabs' role='tablist' aria-label='链接分类'>
          {groups.map((group, index) => (
            <button type='button' role='tab'
              id={'link-tab-' + group.id_name}
              aria-controls={'link-panel-' + group.id_name}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-link-tab={group.id_name}>
              {group.title}<span class='tab-count'>{group.link_list.length}</span>
            </button>
          ))}
        </div>
        <label class='link-search'>
          <span aria-hidden='true'>⌕</span>
          <input type='search' aria-label='搜索链接' placeholder='搜索名称或简介' autocomplete='off' />
        </label>
      </div>

      {groups.map((group, index) => (
        <section class='link-panel' role='tabpanel'
          id={'link-panel-' + group.id_name}
          aria-labelledby={'link-tab-' + group.id_name}
          data-link-panel={group.id_name}
          hidden={index !== 0}>
          <header class='group-heading'>
            <span class='group-icon' aria-hidden='true'>
              {group.id_name === 'friends' ? '∞' : group.id_name === 'own' ? '⌂' : '✦'}
            </span>
            <div class='group-title'>
              <h2>{group.title}</h2>
              <p>{group.desc}</p>
            </div>
            <strong class='group-total'>{group.link_list.length}</strong>
          </header>
          {group.id_name === 'friends' && (
            <>
              <div class='friend-tabs' role='tablist' aria-label='友好邻居内容'>
                <button type='button' role='tab' data-friend-tab='active' id='friend-tab-active'
                  aria-controls='friend-links-grid' aria-selected='true' tabindex='0'>
                  收录链接 <span>{friendActiveCount}</span>
                </button>
                <button type='button' role='tab' data-friend-tab='down' id='friend-tab-down'
                  aria-controls='friend-links-grid' aria-selected='false' tabindex='-1'>
                  异常链接 <span>{friendDownCount}</span>
                </button>
                <button type='button' role='tab' data-friend-tab='history' id='friend-tab-history'
                  aria-controls='friend-history-panel' aria-selected='false' tabindex='-1'>
                  变更记录 <span>{history.length}</span>
                </button>
              </div>
              <p class='health-meta'>
                {healthSnapshot.checkedAt
                  ? '最近检查：' + new Date(healthSnapshot.checkedAt).toLocaleDateString('zh-CN') + ' · 连续三次失败才标记异常'
                  : '尚无健康检测结果，收录链接不代表可访问性已经验证。'}
                {pendingCount > 0 && ' · ' + pendingCount + ' 个站点待检查'}
              </p>
            </>
          )}
          <div class='link-cards' id={group.id_name === 'friends' ? 'friend-links-grid' : undefined}
            role={group.id_name === 'friends' ? 'tabpanel' : undefined}
            aria-labelledby={group.id_name === 'friends' ? 'friend-tab-active' : undefined}
            data-card-grid>
            {group.link_list.map(link => (
              <a class='link-card' href={link.link} target='_blank' rel='noopener noreferrer'
                data-link-card data-link-state={healthByUrl.get(link.link)?.state ?? 'unknown'}
                data-search={[link.name, link.intro, new URL(link.link).hostname].join(' ').toLowerCase()}>
                {link.avatar && (
                  <img class='card-backdrop' src={sitePath(link.avatar)} alt='' aria-hidden='true'
                    loading='lazy' data-avatar-fallback={sitePath('/favicon/wendell-avatar-192.png')} />
                )}
                <span class='card-shade' aria-hidden='true'></span>
                <span class='link-mark' aria-hidden='true'>
                  {link.avatar ? (
                    <img src={sitePath(link.avatar)} width='56' height='56' alt=''
                      loading='lazy' data-avatar-fallback={sitePath('/favicon/wendell-avatar-192.png')} />
                  ) : 'mark' in link ? link.mark : '↗'}
                </span>
                <span class='link-copy'>
                  <strong>{link.name}</strong>
                  <small>{link.intro}</small>
                  {healthByUrl.get(link.link)?.state === 'down' && (
                    <span class='link-health' data-health='down'>连续检测异常 · 待复核</span>
                  )}
                  {healthByUrl.get(link.link)?.state === 'suspect' && (
                    <span class='link-health' data-health='suspect'>暂时无法访问 · 待复核</span>
                  )}
                </span>
                <span class='link-arrow' aria-hidden='true'>↗</span>
              </a>
            ))}
          </div>
          <p class='directory-empty' data-link-empty hidden>
            {group.id_name === 'friends' ? '这里为新朋友留了位置，也可以试试其他分类。' : '没有找到匹配的链接，试试其他关键词。'}
          </p>
          {group.id_name === 'friends' && (
            <section class='friend-history' id='friend-history-panel' role='tabpanel'
              aria-labelledby='friend-tab-history' data-history-pane hidden>
              {history.length > 0 ? (
                <ul class='history-list'>
                  {history.slice(0, 30).map(entry => (
                    <li class='history-row' data-history-row data-search={[entry.name, entry.action].join(' ').toLowerCase()}>
                      <span class='history-action' data-action={entry.action}>
                        {entry.action === 'added' ? '新增' : entry.action === 'removed' ? '移除' : '更新'}
                      </span>
                      <a href={entry.url} rel='noopener noreferrer' target='_blank'>{entry.name}</a>
                      <time datetime={entry.date}>{entry.date.slice(0, 10)}</time>
                    </li>
                  ))}
                </ul>
              ) : <p class='directory-empty'>还没有生成变更记录，后续构建会根据 Git 历史更新。</p>}
              <p class='directory-empty' data-history-empty hidden>没有找到匹配的变更记录。</p>
            </section>
          )}
        </section>
      ))}
      <p class='directory-count' data-link-status aria-live='polite'></p>
    </link-directory>
    <section class='link-about' aria-labelledby='exchange-title'>
      <div>
        <p class='kicker'>SAY HELLO</p><h2 id='exchange-title'>交换一个小小的入口</h2><p>
          如果也在认真记录，欢迎带着站点名称、地址和一句介绍来打个招呼。
        </p><a href={sitePath('/about#comments')}>去留言板认识一下 ↗</a>
      </div><details>
        <summary>本站信息与收录说明 <span aria-hidden='true'>＋</span></summary><pre
          id='site-link-info'>{info}</pre><button type='button' data-copy-link-info
          >复制本站信息</button
        ><span class='copy-result' data-copy-result aria-live='polite'></span><ul>
          <li>博客地址使用正式域名；头像由本站公开静态资源提供。</li><li>
            友链由维护者人工确认，开源参考站单独分类。
          </li><li>请提供可公开访问的个人站点和简短介绍。</li>
        </ul>
      </details>
    </section>

    <section class='link-extra rss-panel' aria-labelledby='friend-feed-heading'>
      <span class='kicker'>NEIGHBORHOOD FEED</span>
      <h2 id='friend-feed-heading'>邻站动态</h2>
      <p>通过 RSS / Atom 收集友好邻居最近发表的文章。</p>
      {posts.length ? (
        <ul>
          {posts.slice(0, 8).map(post => (
            <li>
              <a href={post.url} rel='noopener noreferrer' target='_blank'>{post.title}</a>
              <span>{post.site}</span>
              {post.publishedAt && <time datetime={post.publishedAt}>{post.publishedAt.slice(0, 10)}</time>}
            </li>
          ))}
        </ul>
      ) : <p class='empty-note'>还没有邻站动态。友链添加 RSS 地址并完成聚合后会出现在这里。</p>}
    </section>
    <FriendApplyGuide
      info={friendInfo}
      applyUrl='https://github.com/yen-chiu/yen-chiu.github.io/issues/new?template=friend-link.yml'
      editUrl='https://github.com/yen-chiu/yen-chiu.github.io/edit/main/public/links.json'
    />
  </main>
</BaseLayout>
<script>
  class LinkDirectory extends HTMLElement {
    private controller?: AbortController
    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      const groupTabs = [...this.querySelectorAll<HTMLButtonElement>('[data-link-tab]')]
      const friendTabs = [...this.querySelectorAll<HTMLButtonElement>('[data-friend-tab]')]
      const panels = [...this.querySelectorAll<HTMLElement>('[data-link-panel]')]
      const input = this.querySelector<HTMLInputElement>('.link-search input')
      const status = this.querySelector<HTMLElement>('[data-link-status]')
      if (!groupTabs.length || !input || !status) return
      const friendGrid = this.querySelector<HTMLElement>('[data-link-panel="friends"] [data-card-grid]')
      if (friendGrid) {
        const cards = [...friendGrid.children]
        for (let i = cards.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1))
          ;[cards[i], cards[j]] = [cards[j], cards[i]]
        }
        friendGrid.replaceChildren(...cards)
      }
      this.querySelectorAll<HTMLImageElement>('[data-avatar-fallback]').forEach(img => {
        img.addEventListener('error', () => {
          const fallback = img.dataset.avatarFallback
          if (fallback && img.src !== new URL(fallback, location.href).href) img.src = fallback
        }, { signal })
      })
      let currentGroup = groupTabs[0].dataset.linkTab
      let currentFriendView = 'active'
      const update = () => {
        const query = input.value.trim().toLocaleLowerCase()
        groupTabs.forEach(tab => {
          const active = tab.dataset.linkTab === currentGroup
          tab.setAttribute('aria-selected', String(active))
          tab.tabIndex = active ? 0 : -1
        })
        friendTabs.forEach(tab => {
          const active = tab.dataset.friendTab === currentFriendView
          tab.setAttribute('aria-selected', String(active))
          tab.tabIndex = active ? 0 : -1
        })
        if (friendGrid) {
          // 收录/异常两个视图共用同一块面板，标签指向当前选中的那个
          friendGrid.setAttribute(
            'aria-labelledby',
            currentFriendView === 'down' ? 'friend-tab-down' : 'friend-tab-active'
          )
        }
        let count = 0
        panels.forEach(panel => {
          const active = panel.dataset.linkPanel === currentGroup
          panel.hidden = !active
          const friends = panel.dataset.linkPanel === 'friends'
          const showingHistory = friends && currentFriendView === 'history'
          const grid = panel.querySelector<HTMLElement>('[data-card-grid]')
          const historyPanel = panel.querySelector<HTMLElement>('[data-history-pane]')
          if (grid) grid.hidden = showingHistory
          if (historyPanel) historyPanel.hidden = !showingHistory
          let visible = 0
          panel.querySelectorAll<HTMLElement>('[data-link-card]').forEach(card => {
            const allowed = !friends || (currentFriendView === 'down'
              ? card.dataset.linkState === 'down'
              : card.dataset.linkState !== 'down')
            const matched = (card.dataset.search ?? '').includes(query)
            card.hidden = !allowed || !matched
            if (!card.hidden && !showingHistory) visible++
          })
          const empty = panel.querySelector<HTMLElement>('[data-link-empty]')
          if (empty) {
            empty.hidden = showingHistory || visible > 0
            if (!showingHistory && friends) {
              empty.textContent = currentFriendView === 'down'
                ? '没有连续检测异常的友情链接。'
                : '还没有符合条件的友链，欢迎来认识。'
              if (query) empty.textContent = '没有找到匹配的链接，试试其他关键词。'
            }
          }
          if (showingHistory) {
            visible = 0
            panel.querySelectorAll<HTMLElement>('[data-history-row]').forEach(row => {
              row.hidden = !(row.dataset.search ?? '').includes(query)
              if (!row.hidden) visible++
            })
            const historyEmpty = panel.querySelector<HTMLElement>('[data-history-empty]')
            if (historyEmpty) historyEmpty.hidden = visible > 0 || !query
          }
          if (active) count = visible
        })
        status.textContent = currentGroup === 'friends' && currentFriendView === 'history'
          ? '当前显示 ' + count + ' 条变更记录'
          : '当前分组显示 ' + count + ' 个站点'
      }
      const bindTabs = (
        tabs: HTMLButtonElement[],
        pick: (tab: HTMLButtonElement) => void
      ) => {
        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => { pick(tab); update() }, { signal })
          tab.addEventListener('keydown', e => {
            let next = index
            if (e.key === 'ArrowRight') next = (index + 1) % tabs.length
            else if (e.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length
            else if (e.key === 'Home') next = 0
            else if (e.key === 'End') next = tabs.length - 1
            else return
            e.preventDefault()
            pick(tabs[next])
            update()
            tabs[next].focus()
          }, { signal })
        })
      }
      bindTabs(groupTabs, tab => { currentGroup = tab.dataset.linkTab })
      bindTabs(friendTabs, tab => { currentFriendView = tab.dataset.friendTab ?? 'active' })
      input.addEventListener('input', update, { signal })
      update()
    }
    disconnectedCallback() { this.controller?.abort() }
  }
  if (!customElements.get('link-directory')) customElements.define('link-directory', LinkDirectory)
  const setupCopy = () => {
    const button = document.querySelector<HTMLButtonElement>('[data-copy-link-info]')
    const info = document.querySelector<HTMLElement>('#site-link-info')
    const result = document.querySelector<HTMLElement>('[data-copy-result]')
    if (!button || !info || !result) return
    button.onclick = async () => {
      try {
        await navigator.clipboard.writeText(info.textContent ?? '')
        result.textContent = '已复制'
      } catch {
        result.textContent = '无法自动复制，请长按上方文字复制。'
      }
    }
  }
  setupCopy()
  document.addEventListener('astro:page-load', setupCopy)
</script>
<style>
  .links-page { max-width: 68rem; margin: 1.5rem auto 3rem; }
  link-directory { display: block; margin-top: 1.6rem; }
  .directory-tools {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.2rem;
    border-bottom: 1px solid hsl(var(--border));
  }
  .group-tabs, .friend-tabs { display: flex; align-items: center; flex-wrap: wrap; }
  .group-tabs { gap: 1.25rem; }
  .group-tabs [role='tab'] {
    display: inline-flex; align-items: center; gap: .5rem;
    position: relative; cursor: pointer; padding: .85rem .2rem;
    min-height: 44px; background: transparent; border: 0;
    color: hsl(var(--muted-foreground)); font-size: .85rem;
    transition: color 160ms ease;
  }
  .group-tabs [role='tab']::after {
    position: absolute; bottom: -1px; left: 0; right: 0;
    height: 2px; border-radius: 4px; background: hsl(var(--primary));
    content: ''; transform: scaleX(0); transition: transform 180ms ease;
  }
  .group-tabs [role='tab'][aria-selected='true'] { color: hsl(var(--primary)); font-weight: 650; }
  .group-tabs [role='tab'][aria-selected='true']::after { transform: scaleX(1); }
  .tab-count {
    border-radius: .5rem; padding: .15rem .42rem;
    background: hsl(var(--primary) / .08); color: hsl(var(--muted-foreground));
    font-size: .68rem; font-weight: 500;
  }
  .link-search {
    display: flex; align-items: center; flex: 0 1 15rem; gap: .5rem;
    min-width: 10rem; border: 1px solid hsl(var(--border));
    border-radius: .8rem; padding: .3rem .75rem; margin-bottom: .45rem;
    background: hsl(var(--background) / .65);
  }
  .link-search span { font-size: 1.4rem; color: hsl(var(--primary)); }
  .link-search input {
    min-width: 0; width: 100%; min-height: 32px; border: 0; outline: 0;
    background: transparent; color: hsl(var(--foreground)); font-size: .75rem;
  }
  .link-panel {
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid hsl(var(--border));
    border-radius: 1.5rem;
    background: radial-gradient(ellipse at 95% 0, hsl(var(--primary) / .07), transparent 45%),
      hsl(var(--background) / .85);
    box-shadow: inset 0 1px 0 hsl(var(--foreground) / .025);
  }
  .link-panel[hidden], .link-card[hidden], [data-card-grid][hidden],
  .friend-history[hidden], .history-row[hidden], .directory-empty[hidden] { display: none !important; }
  .group-heading { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .group-icon {
    display: grid; place-items: center; width: 3.45rem; height: 3.45rem;
    flex-shrink: 0; border: 1px solid hsl(var(--primary) / .18);
    border-radius: 1rem; background: hsl(var(--primary) / .09);
    color: hsl(var(--primary)); font-size: 1.8rem; line-height: 1;
  }
  .group-title { flex: 1; min-width: 0; }
  .group-heading h2 { margin: 0; font-size: clamp(1.1rem, 2.5vw, 1.45rem); font-weight: 650; }
  .group-heading p { margin: .35rem 0 0; color: hsl(var(--muted-foreground)); font-size: .78rem; }
  .group-total { font-size: 1.65rem; font-weight: 450; color: hsl(var(--primary) / .62); }
  .friend-tabs {
    gap: .25rem; margin: -.15rem 0 0; padding: .35rem;
    border-radius: .9rem; background: hsl(var(--muted) / .42);
    width: fit-content; max-width: 100%;
  }
  .friend-tabs [role='tab'] {
    cursor: pointer; border: 1px solid transparent; border-radius: .7rem;
    background: transparent; padding: .55rem .78rem; min-height: 42px;
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: .78rem; color: hsl(var(--muted-foreground));
  }
  .friend-tabs [role='tab'] span { font-size: .7rem; color: hsl(var(--primary)); }
  .friend-tabs [role='tab'][aria-selected='true'] {
    border-color: hsl(var(--primary) / .3);
    background: hsl(var(--background)); color: hsl(var(--foreground)); font-weight: 650;
    box-shadow: 0 2px 9px hsl(var(--foreground) / .04);
  }
  .health-meta { margin: .65rem 0 1.15rem; font-size: .67rem; color: hsl(var(--muted-foreground)); line-height: 1.6; }
  .link-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .9rem; }
  .link-card {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; align-items: center; gap: .85rem;
    min-width: 0; min-height: 104px; padding: 1.05rem;
    border: 1px solid rgb(170 161 196 / .24); border-radius: 1.15rem;
    background: radial-gradient(circle at 8% 0, rgb(126 102 155 / .28), transparent 55%), #111018;
    color: #f5f1f9; text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }
  .link-card:hover {
    transform: translateY(-2px); border-color: hsl(var(--primary) / .65);
    box-shadow: 0 10px 28px rgb(18 13 34 / .16);
  }
  .card-backdrop {
    position: absolute; inset: -15%; width: 130%; height: 130%; z-index: -2;
    object-fit: cover; object-position: left center;
    filter: blur(9px) saturate(.7); opacity: .24; pointer-events: none;
    transform: scale(1.06);
  }
  .card-shade {
    position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(90deg, rgb(12 11 18 / .54), rgb(12 11 18 / .82) 70%),
      radial-gradient(circle at 100% 100%, rgb(155 122 191 / .12), transparent 45%);
  }
  .link-mark {
    flex: 0 0 52px; width: 52px; height: 52px;
    display: grid; place-items: center; overflow: hidden;
    border-radius: 50%; border: 1px solid rgb(241 232 255 / .2);
    background: rgb(154 118 194 / .22);
    color: #e2c6ff; font-size: 1.4rem; font-weight: 650;
    box-shadow: 0 0 0 3px rgb(255 255 255 / .045);
  }
  .link-mark img { width: 100%; height: 100%; object-fit: cover; }
  .link-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: .3rem; }
  .link-copy strong { font-size: .91rem; line-height: 1.35; font-weight: 650; overflow-wrap: anywhere; }
  .link-copy small {
    font-size: .75rem; color: rgb(223 216 236 / .81);
    line-height: 1.55; display: -webkit-box; -webkit-box-orient: vertical;
    -webkit-line-clamp: 2; overflow: hidden;
