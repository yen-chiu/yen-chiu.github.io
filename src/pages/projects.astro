---
import PageLayout from '@/layouts/BaseLayout.astro'
import KnowledgeIndexHero from '@/components/KnowledgeIndexHero.astro'
import { sitePath } from '@/utils/site-path'

import { projects } from '../data/projects'

const groups = [
  {
    id: 'interactive',
    title: '交互作品',
    description: '从一个问题或一段故事开始，做成可以亲手体验的东西。'
  },
  { id: 'building', title: '网站与文档', description: '写作、整理，也维护这些作品背后的基础。' }
]
const external = (href: string) => href.startsWith('https:')
---

<PageLayout meta={{ title: '项目', description: 'Wendell 的交互作品、博客实验与文档项目。' }}>
  <main class='projects-page'>
    <KnowledgeIndexHero
      icon='bulb'
      eyebrow='PROJECTS & EXPERIMENTS'
      title='项目'
      description='把想法做成可以打开、也可以继续完善的东西。'
      stats={[
        { label: '项目', value: projects.length },
        { label: '交互作品', value: projects.filter((p) => p.group === 'interactive').length },
        { label: '网站与文档', value: projects.filter((p) => p.group === 'building').length }
      ]}
      statsLabel='项目概览'
      symbol='✦'
    />
    {
      groups.map((group) => (
        <section class='project-section' aria-labelledby={`projects-${group.id}`}>
          <>
            <header>
              <>
                <h2 id={`projects-${group.id}`}>{group.title}</h2>
                <p>{group.description}</p>
              </>
            </header>
            <div class:list={['project-grid', { 'featured-grid': group.id === 'interactive' }]}>
              {projects
                .filter((project) => project.group === group.id)
                .map((project) => (
                  <article class:list={['project-card', `project-${project.id}`]}>
                    {project.group === 'interactive' && (
                      <div class='project-cover' aria-hidden='true'>
                        {'cover' in project ? (
                          <img
                            src={sitePath(project.cover)}
                            width='1080'
                            height='440'
                            alt=''
                            loading='lazy'
                          />
                        ) : (
                          <div
                            class:list={[
                              'nianzhen-art',
                              { 'lifeline-art': project.id === 'lifeline' }
                            ]}
                          >
                            <span class='chat-orbit' />
                            <svg
                              viewBox='0 0 48 48'
                              fill='none'
                              stroke='currentColor'
                              stroke-width='1.5'
                            >
                              {project.id === 'lifeline' ? (
                                <path d='M4 24h9l5-13 8 26 6-13h12' />
                              ) : (
                                <>
                                  <path d='M8 11h32v23H22L12 41v-7H8z' />
                                  <path d='M16 19h16M16 26h11' />
                                </>
                              )}
                            </svg>
                            <strong>{project.id === 'lifeline' ? '生命线' : '念真'}</strong>
                            <span>
                              {project.id === 'lifeline'
                                ? '来自深空的消息式文字冒险。'
                                : '聊日常，也探索新的问题。'}
                            </span>
                          </div>
                        )}
                      </div>
                    )}
                    <div class='project-copy'>
                      <div class='project-meta'>
                        <span>{project.kind}</span>
                        <small>{project.status}</small>
                      </div>
                      <h3>{project.name}</h3>
                      <p>{project.description}</p>
                      <ul class='project-tags' aria-label='项目特点'>
                        {project.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    </div>
                    <footer class='project-actions'>
                      <a
                        class='primary'
                        aria-label={`${project.primary.label}：${project.name}`}
                        href={sitePath(project.primary.href)}
                        target={external(project.primary.href) ? '_blank' : undefined}
                        rel={external(project.primary.href) ? 'noopener noreferrer' : undefined}
                      >
                        {project.primary.label}
                        <span aria-hidden='true'>↗</span>
                      </a>
                      {project.secondary && (
                        <a
                          href={sitePath(project.secondary.href)}
                          target={external(project.secondary.href) ? '_blank' : undefined}
                          rel={external(project.secondary.href) ? 'noopener noreferrer' : undefined}
                        >
                          {project.secondary.label}
                          <span aria-hidden='true'>→</span>
                        </a>
                      )}
                    </footer>
                  </article>
                ))}
            </div>
          </>
        </section>
      ))
    }
    <p class='project-tail'>
      更多代码和实验，放在 <a
        href='https://github.com/yen-chiu'
        target='_blank'
        rel='noopener noreferrer'>GitHub ↗</a
      >。也会把过程写成 <a href={sitePath('/blog')}>博客文章 ↗</a>。
    </p>
  </main>
</PageLayout>
<style>
  .projects-page {
    max-width: 64rem;
    margin: 1.5rem auto 3rem;
  }
  .project-section {
    margin-top: 2rem;
  }
  .project-section > header {
    margin-bottom: 1rem;
  }
  .project-section h2 {
    font-size: 1.15rem;
    font-weight: 650;
    margin: 0;
  }
  .project-section > header p {
    font-size: 0.78rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
    margin: 0.4rem 0 0;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid hsl(var(--border));
    border-radius: 1.1rem;
    background: hsl(var(--background) / 0.92);
  }
  .project-cover {
    height: 190px;
    overflow: hidden;
    background: #102129;
  }
  .project-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nianzhen-art {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    height: 100%;
    color: #e6fff6;
    background:
      radial-gradient(circle at 15% 80%, #598d8033, transparent 45%),
      linear-gradient(135deg, #14292f, #293e4c);
  }
  .nianzhen-art svg {
    position: absolute;
    width: 62px;
    height: 62px;
    left: 18%;
    top: 33%;
    opacity: 0.25;
    rotate: -12deg;
  }
  .nianzhen-art strong {
    font-size: 2.4rem;
    font-weight: 550;
    letter-spacing: 0.2em;
    padding-left: 0.2em;
  }
  .nianzhen-art > span:last-child {
    font-size: 0.68rem;
    letter-spacing: 0.09em;
    opacity: 0.75;
    margin-top: 0.6rem;
  }
  .chat-orbit {
    position: absolute;
    z-index: -1;
    width: 270px;
    height: 270px;
    border: 1px solid #e6fff614;
    border-radius: 50%;
    right: -20px;
    top: -70px;
  }
  .chat-orbit::after {
    content: '';
    position: absolute;
    inset: 35px;
    border: 1px solid #e6fff60d;
    border-radius: 50%;
  }
  .project-copy {
    padding: 1.25rem;
    flex: 1;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.65rem;
    color: hsl(var(--muted-foreground));
  }
  .project-meta small {
    font-size: 0.6rem;
    padding: 0.15rem 0.4rem;
    border: 1px solid hsl(var(--primary) / 0.16);
    border-radius: 0.35rem;
    background: hsl(var(--primary) / 0.06);
    color: hsl(var(--primary));
    white-space: nowrap;
  }
  h3 {
    font-size: 1.15rem;
    font-weight: 650;
    line-height: 1.5;
    margin: 0.65rem 0 0.55rem;
  }
  .project-copy > p {
    font-size: 0.8rem;
    line-height: 1.85;
    color: hsl(var(--muted-foreground));
    margin: 0;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  .project-tags li {
    font-size: 0.63rem;
    color: hsl(var(--muted-foreground));
    padding: 0.2rem 0.45rem;
    background: hsl(var(--muted) / 0.6);
    border-radius: 0.4rem;
  }
  .project-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 1.25rem;
    padding: 0.85rem 0 1.1rem;
    border-top: 1px solid hsl(var(--border) / 0.7);
  }
  .project-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 44px;
    padding: 0.5rem 0.8rem;
    font-size: 0.76rem;
    line-height: 1.2;
    border-radius: 0.65rem;
    color: hsl(var(--primary));
  }
  .project-actions .primary {
    color: hsl(var(--background));
    background: hsl(var(--primary));
  }
  .project-actions a:hover {
    box-shadow: inset 0 0 0 1px hsl(var(--primary) / 0.35);
  }
  .project-actions a:focus-visible,
  .project-tail a:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 3px;
  }
  .project-tail {
    font-size: 0.75rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
    margin: 1.5rem 0 0;
  }
  .project-tail a {
    color: hsl(var(--primary));
  }
  .project-astro,
  .project-manual {
    border-top: 2px solid hsl(var(--primary) / 0.35);
  }
  @media (max-width: 640px) {
    .projects-page {
      margin-top: 1rem;
    }
    .project-section {
      margin-top: 1.4rem;
    }
    .project-grid {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .project-cover {
      height: 140px;
    }
    .project-copy {
      padding: 1rem;
    }
    h3 {
      font-size: 1.05rem;
    }
    .project-copy > p {
      font-size: 0.77rem;
    }
    .project-actions {
      margin-inline: 1rem;
      padding: 0.75rem 0 0.9rem;
    }
    .project-actions a {
      font-size: 0.74rem;
    }
    .nianzhen-art strong {
      font-size: 2rem;
    }
    .nianzhen-art svg {
      width: 48px;
      height: 48px;
      left: 14%;
    }
  }
  .lifeline-art {
    background:
      radial-gradient(1px 1px at 15% 20%, #c4d8ff, transparent),
      radial-gradient(2px 2px at 75% 35%, #d6d2ff, transparent),
      linear-gradient(135deg, #111c34, #3a3558);
    color: #e9e9ff;
  }
  @media (min-width: 1024px) {
    .featured-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
