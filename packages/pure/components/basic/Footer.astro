---
import config from 'virtual:config'
import SiteStatus from '@/components/SiteStatus.astro'
import {sitePath} from '@/utils/site-path'
import {Icon} from '../user'
const social=config.footer.social||[]
---
<footer class='site-footer'>
 <div class='footer-row'>
  <div class='footer-legal'><span class='footer-owner'>{config.footer.year} {config.author}</span><span class='footer-license'>代码 <a href='https://github.com/yen-chiu/yen-chiu.github.io/blob/main/LICENSE'>Apache 2.0</a><span class='separator' aria-hidden='true'>·</span>内容 <a href={sitePath('/terms/copyright')}>版权声明</a></span></div>
  <nav class='footer-links' aria-label='页脚'><a href={sitePath('/terms')}>站点说明</a>{social.map(({label,href,icon})=><a href={sitePath(href)} rel='me' aria-label={label}><Icon name={icon}/></a>)}</nav>
 </div>
 <div class='footer-credit'>基于 <a href='https://astro.build/'>Astro</a> · <a href='https://github.com/yen-chiu/yen-chiu.github.io'>Vesper 暮星</a> · 派生自 <a href='https://github.com/LemonAdorable/astro-theme-iris'>Iris</a> / <a href='https://github.com/cworld1/astro-theme-pure'>Pure</a></div>
 <SiteStatus />
</footer>
<style>
.site-footer{width:100%;margin:3rem auto 1.25rem;padding-top:1.1rem;border-top:1px solid hsl(var(--border)/.7);color:hsl(var(--muted-foreground));font-size:.72rem;line-height:1.8;}.footer-row,.footer-legal,.footer-links{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem 1.2rem;}.footer-row{justify-content:space-between;}.footer-owner{white-space:nowrap;}.footer-license{display:inline-flex;flex-wrap:wrap;align-items:center;gap:.3rem;}.separator{margin:0 .2rem;}.footer-links{gap:.8rem;}.footer-links a{display:inline-flex;align-items:center;justify-content:center;min-height:36px;}.footer-links :global(svg){width:17px;height:17px;}a{color:inherit;text-decoration:none;}a:hover{color:hsl(var(--primary));text-decoration:underline;text-underline-offset:3px;}a:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:4px;border-radius:2px;}.footer-credit{margin-top:.3rem;font-size:.67rem;}@media(max-width:600px){.site-footer{margin-top:2rem;}.footer-row{justify-content:center;gap:.4rem;}.footer-legal{justify-content:center;gap:.2rem .8rem;}.footer-links{justify-content:center;width:100%;}.footer-credit{text-align:center;}}
</style>
