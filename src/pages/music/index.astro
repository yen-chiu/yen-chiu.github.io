---
import BaseLayout from '@/layouts/BaseLayout.astro'
import MusicPlayer from '@/components/music/MusicPlayer.astro'
import { musicSources, musicTracks } from '@/data/music'
import { sitePath } from '@/utils/site-path'
---
<BaseLayout meta={{ title: 'Vesper Music · 夜间留声', description: '夜间留声：Vesper 的独立音乐空间，收听具有公开播放许可的音乐，探索各平台的官方音乐入口。' }}>
  <main class='music-page'>
    <header class='music-heading'>
      <span class='music-label'>VESPER / MUSIC</span>
      <h1>夜间留声<span aria-hidden='true'> ♪</span></h1>
      <p>有些夜晚不需要文字，交给音乐就好。</p>
    </header>
    <MusicPlayer />
    <section class='music-library' aria-labelledby='music-sources-title'>
      <div class='library-heading'>
        <div><span class='music-label'>BEYOND THE PLAYLIST</span><h2 id='music-sources-title'>去别处听听</h2></div>
        <p>混合音源采用官方播放入口。各平台的授权、账户和地区限制由相应平台决定。</p>
      </div>
      <div class='source-grid'>
        {musicSources.map(source=><a href={source.href} target='_blank' rel='noopener noreferrer' class='music-source'>
          <span aria-hidden='true'>↗</span><strong>{source.name}</strong><small>{source.note}</small>
        </a>)}
      </div>
    </section>
    <footer class='music-fine-print' aria-label='音乐来源与版权说明'>
      <div>
        <h2>音乐来源与授权</h2>
        <p>作品与录音的权利可能不同。当前曲目的许可与来源随播放器显示，完整署名见授权档案。</p>
      </div>
      <a class='credits-link' href={sitePath('/music/credits/')}>
        <svg width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z M9 12l2 2 4-4'/></svg>
        <span>音乐授权档案 <small>（{musicTracks.length} 首）</small></span>
        <svg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'><path d='M7 17 17 7M7 7h10v10'/></svg>
      </a>
    </footer>
  </main>
</BaseLayout>
<style>
  .music-page{width:min(100%,70rem);margin:0 auto;padding:clamp(1.5rem,5vw,4rem) 0 5rem}
  .music-heading{margin:0 0 2rem}.music-label{font-size:.67rem;letter-spacing:.2em;font-weight:650;color:hsl(var(--primary))}.music-heading h1{font-size:clamp(2.3rem,7vw,4.3rem);line-height:1.25;letter-spacing:-.045em;font-weight:730;margin:.65rem 0}.music-heading h1 span{font-size:.6em;color:hsl(var(--primary));vertical-align:top}.music-heading p{font-size:.94rem;color:hsl(var(--muted-foreground));line-height:1.8}
  .music-library{margin-top:3.5rem}.library-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.2rem}.library-heading h2{font-size:1.5rem;margin:.45rem 0 0}.library-heading p{max-width:26rem;font-size:.77rem;line-height:1.7;color:hsl(var(--muted-foreground))}
  .source-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.7rem}.music-source{min-height:108px;padding:1rem;border:1px solid hsl(var(--border)/.8);border-radius:1rem;background:hsl(var(--background)/.7);display:flex;flex-direction:column;gap:.4rem;transition:border-color .2s ease}.music-source:hover{border-color:hsl(var(--primary)/.6)}.music-source>span{align-self:flex-end;color:hsl(var(--primary))}.music-source strong{font-size:.88rem}.music-source small{font-size:.69rem;line-height:1.5;color:hsl(var(--muted-foreground))}
  .music-fine-print{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:2.5rem 0 0;padding:1rem 1.1rem;border:1px solid hsl(var(--border));border-radius:1rem;background:hsl(var(--background)/.96);color:hsl(var(--foreground));font-size:.78rem;line-height:1.7}.music-fine-print h2{font-size:.9rem;font-weight:650;margin:0 0 .35rem}.music-fine-print p{margin:0;color:hsl(var(--muted-foreground))}.credits-link{display:flex;align-items:center;gap:.4rem;flex:none;min-height:44px;color:hsl(var(--primary));font-weight:600}.credits-link small{font-weight:400;color:hsl(var(--muted-foreground))}.credits-link:hover{text-decoration:underline}.credits-link svg{flex:none}@media(max-width:600px){.music-fine-print{display:block}.credits-link{margin-top:.4rem}}
  @media(max-width:850px){.source-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:600px){.music-page{padding-top:1.3rem}.library-heading{display:block}.library-heading p{margin-top:.65rem}.source-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.music-library{margin-top:2.2rem}}
</style>
