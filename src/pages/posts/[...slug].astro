---
import type { CollectionEntry } from 'astro:content'
import { getBlogCollection } from 'astro-pure/server'
import { getPostSlug } from '@/utils/content-paths'

export const prerender = true

export async function getStaticPaths() {
  const posts = (await getBlogCollection()) as CollectionEntry<'blog'>[]
  return posts.map((post) => {
    const slug = getPostSlug(post)
    return {
      params: { slug },
      props: { target: `/blog/${slug}` }
    }
  })
}

const { target } = Astro.props
return Astro.redirect(encodeURI(target), 301)
---
