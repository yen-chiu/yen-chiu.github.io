    <!-- Dialog Strings -->
    <string name="dialog_notification_settings">Lifeline은 수일에 걸쳐 진행되는 인터랙티브 스토리입니다.\n\n테일러가 알림을 통해 연락합니다. 하나도 놓치지 않도록 각 메시지를 개별적으로 수신할까요, 아니면 공간 확보를 위해 한꺼번에 수신할까요?\n\n{설정 메뉴에서 언제나 변경할 수 있습니다.}</string>
    <string name="credits_dialog">Lifeline 제작자:\n\nDave Justus\nMars Jokela\nDan Selleck\nColin Liotta\nJackie Steege\nWilson Bull\nJason Nowak\nGhia Mercado\nBen Schwartz\n\n번역 팀:\n\nMatt Decker\nSteen Groennebaek\nArne Twigt\nYumi Okubo-Shuman\nLauren Warnock</string>
    <string name="dialog_game_over">테일러가 이 길의 끝에 도달했습니다.\n\n이제 스토리의 나머지 부분을 둘러보세요: 이전에 선택한 대화 상자를 눌러 대답을 수정하거나 특정한 날로 되돌리세요.\n\n메인 메뉴에서 고속 모드를 활성화할 수도 있습니다.</string>
