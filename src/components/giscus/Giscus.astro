---
import config from '@/site-config'
interface Props {
  term?: string
  class?: string
  defer?: boolean
}

const { class: className, term, defer = false } = Astro.props
---

<div id='giscus' class={className} data-repo={config.integ.giscus?.repo} data-repo-id={config.integ.giscus?.repoId} data-category={config.integ.giscus?.category} data-category-id={config.integ.giscus?.categoryId} data-term={term} data-defer={defer ? 'true' : undefined}>
  <p class='giscus-loading'>评论正在预加载...</p>
</div>

<script>
  let themeListenerReady = false


  function getTheme() {
    const isDark = document.documentElement.classList.contains('dark')
    return isDark ? 'transparent_dark' : 'light'
  }

  function updateGiscusTheme() {
    const theme = getTheme()
    const iframe = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement | null
    if (iframe && iframe.contentWindow) {
      iframe.contentWindow.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app')
    }
  }

  function loadGiscus(container: HTMLElement) {
    if (!container.isConnected || container.dataset.giscusLoaded === 'true') return
    container.dataset.giscusLoaded = 'true'

    const giscusConfig = {repo:container.dataset.repo!,repoId:container.dataset.repoId!,category:container.dataset.category!,categoryId:container.dataset.categoryId!,mapping:container.dataset.term ? 'specific' : 'title',strict:'0',reactionsEnabled:'1',emitMetadata:'1',inputPosition:'top',lang:'zh-CN',loading:'lazy',crossorigin:'anonymous'}
    const script = document.createElement('script')
    if(container.dataset.term) script.setAttribute('data-term',container.dataset.term)
    script.src = 'https://giscus.app/client.js'
    script.setAttribute('data-repo', giscusConfig.repo)
    script.setAttribute('data-repo-id', giscusConfig.repoId)
    script.setAttribute('data-category', giscusConfig.category)
    script.setAttribute('data-category-id', giscusConfig.categoryId)
    script.setAttribute('data-mapping', giscusConfig.mapping)
    script.setAttribute('data-strict', giscusConfig.strict)
    script.setAttribute('data-reactions-enabled', giscusConfig.reactionsEnabled)
    script.setAttribute('data-emit-metadata', giscusConfig.emitMetadata)
    script.setAttribute('data-input-position', giscusConfig.inputPosition)
    script.setAttribute('data-theme', getTheme())
    script.setAttribute('data-lang', giscusConfig.lang)
    script.setAttribute('data-loading', giscusConfig.loading)
    script.setAttribute('crossorigin', giscusConfig.crossorigin)
    script.async = true

    container.appendChild(script)
  }

  function setupGiscus() {
    const container = document.getElementById('giscus')
    if (!container || container.dataset.giscusObserved === 'true') return
    container.dataset.giscusObserved = 'true'
    // Do not rely on :has() to hide the loading placeholder in older browsers.
    const frameObserver = new MutationObserver(() => {
      if (!container.querySelector('iframe.giscus-frame')) return
      container.querySelector<HTMLElement>('.giscus-loading')?.setAttribute('hidden', '')
      container.classList.add('giscus-ready')
      frameObserver.disconnect()
    })
    frameObserver.observe(container, { childList: true, subtree: true })

    const disclosure = container.closest('details')
    if (container.dataset.defer === 'true' && disclosure) {
      if (disclosure.open) loadGiscus(container)
      disclosure.addEventListener('toggle', () => {
        if (disclosure.open) loadGiscus(container)
      })
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        loadGiscus(container)
      },
      { rootMargin: '1800px 0px' }
    )
    observer.observe(container)

    const idleLoad = () => {
      observer.disconnect()
      loadGiscus(container)
    }
    const idleWindow = window as Window & {
      requestIdleCallback?: (callback: () => void, options?: { timeout: number }) => number
    }
    if (idleWindow.requestIdleCallback) {
      idleWindow.requestIdleCallback(idleLoad, { timeout: 4000 })
    } else {
      window.setTimeout(idleLoad, 2500)
    }

    // Short pages can reach the comments before the observer's first callback.
    if (container.getBoundingClientRect().top < window.innerHeight + 1800) {
      observer.disconnect()
      loadGiscus(container)
    }
  }

  function setupThemeListener() {
    if (themeListenerReady) return
    themeListenerReady = true

    const observer = new MutationObserver(() => {
      updateGiscusTheme()
    })
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class']
    })
  }

  setupGiscus()
  setupThemeListener()
  document.addEventListener('astro:page-load', setupGiscus)
</script>

<style>
  #giscus {
    min-height: 12rem;
    margin-top: 2rem;
  }

  .giscus-loading {
    display: grid;
    min-height: 12rem;
    place-items: center;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.8rem;
  }

  #giscus.giscus-ready .giscus-loading {
    display: none;
  }
</style>
