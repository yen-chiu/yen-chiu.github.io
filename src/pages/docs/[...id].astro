---
import { render, type CollectionEntry } from 'astro:content'

import { MediumZoom } from 'astro-pure/advanced'
import { GraphView } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import PageLayout from '@/layouts/ContentLayout.astro'
import Backlinks from '@/components/blog/Backlinks.astro'
import OutgoingLinks from '@/components/blog/OutgoingLinks.astro'
import HelpSupport from '@/components/docs/HelpSupport.astro'
import MobileTOC from '@/components/MobileTOC.astro'
import {
  buildBacklinksMap,
  getBacklinksForPost,
  getOutgoingLinks,
  type Backlink
} from '@/utils/backlinks'

import DocsContents from './DocsContents.astro'
import {sitePath} from '@/utils/site-path'

export const prerender = true

export async function getStaticPaths() {
  const posts = sortMDByDate(await getBlogCollection('docs'))
  const backlinksMap = await buildBacklinksMap(posts, '/docs')

  return posts.map((post) => ({
    params: { id: post.id },
    props: {
      post,
      backlinks: getBacklinksForPost(backlinksMap, post.id),
      outgoingLinks: getOutgoingLinks(post, posts, '/docs')
    }
  }))
}

type Props = {
  post: CollectionEntry<'docs'>
  backlinks: Backlink[]
  outgoingLinks: Backlink[]
}

const { post, backlinks, outgoingLinks } = Astro.props
const { Content, headings } = await render(post)
const { description, title } = post.data

const editPath = `https://github.com/yen-chiu/yen-chiu-astro/edit/main/${post.filePath}`

const words = (post.body ?? '').replace(/```[\s\S]*?```/g, '').length
const minutes = Math.max(2, Math.round(words / 500))
const tocItems = headings
  .filter((heading) => heading.depth <= 3)
  .map((heading) => ({
    ...heading,
    label: heading.text.replace(/#+\s*$/, '').trim()
  }))

const dates = post.data as { updatedDate?: Date; publishDate?: Date }
const updatedAt = dates.updatedDate ?? dates.publishDate
const updatedLabel = updatedAt
  ? new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })
      .format(new Date(updatedAt))
      .replace(/\//g, '.')
  : null
---

<PageLayout
  meta={{ description, title }}
  back={sitePath('/docs')}
  graphTarget='#docs-graph-view'
  mode='article'
  mainClass='docs-reading'
>
  <Fragment slot='left-sidebar'>
    <DocsContents class='docs-toc block' />
  </Fragment>

  <Fragment slot='sidebar'>
    {
      !!tocItems.length && (
        <nav class='doc-toc' aria-label='目次'>
          <p class='doc-toc__title'>目次</p>
          <ul class='doc-toc__list'>
            {tocItems.map((heading) => (
              <li class={`doc-toc__item doc-toc__item--h${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </Fragment>

  <Fragment slot='header'>
    <header class='doc-masthead'>
      <p class='doc-masthead__meta'>
        <span>文档</span>
        <span aria-hidden='true'>/</span>
        <span>约 {minutes} 分钟</span>
        <span aria-hidden='true'>/</span>
        <span>{tocItems.length} 节</span>
        {updatedLabel && <span class='doc-masthead__date'>{updatedLabel}</span>}
      </p>
      <h1 class='doc-masthead__title'>{title}</h1>
      {description && <p class='doc-masthead__desc'>{description}</p>}
      <div class='rule-double'></div>
    </header>
  </Fragment>

  <Content />

  <div slot='content-after' class='mt-8 flex flex-col gap-3 border-t pt-8 sm:gap-6'>
    {
      (outgoingLinks.length > 0 || backlinks.length > 0) && (
        <div id='wikilinks-section' class='flex flex-col gap-3'>
          {outgoingLinks.length > 0 && <OutgoingLinks links={outgoingLinks} />}
          {backlinks.length > 0 && (
            <Backlinks {backlinks} currentPostSlug={post.id} title='引用此文档' />
          )}
        </div>
      )
    }
    <GraphView currentSlug={`docs/${post.id}`} id='docs-graph-view' />
  </div>

  <div slot='bottom'>
    <HelpSupport editPath={editPath} />

    {/* Show docs contents grid */}
    <div class='mt-10'>
      <h3 class='text-xl font-bold text-foreground tracking-tight mb-2'>探索更多</h3>
      <p class='text-sm text-muted-foreground mb-6'>精选文档与阅读入口；完整维护记录请前往 Folio。</p>
      <DocsContents layout='grid' class='!mt-0' />
    </div>
  </div>
</PageLayout>
<MediumZoom />
{
  tocItems.length > 1 && (
    <MobileTOC headings={tocItems.map(({ depth, slug, label }) => ({ depth, slug, text: label }))} label='本文目录' />
  )
}

<style>
  .doc-masthead__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0 0 0.9rem;
    font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground));
  }

  .doc-masthead__date {
    margin-inline-start: auto;
    font-variant-numeric: tabular-nums;
  }

  .doc-masthead__title {
    margin: 0;
    font-size: clamp(1.65rem, 3.4vw, 2.15rem);
    font-weight: 640;
    letter-spacing: -0.025em;
    line-height: 1.3;
    color: hsl(var(--foreground));
  }

  .doc-masthead__desc {
    max-width: 34em;
    margin: 0.85rem 0 0;
    font-size: 0.92rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }

  .rule-double {
    height: 6px;
    margin: 1.8rem 0 0;
    border-top: 2.5px solid hsl(var(--foreground));
    border-bottom: 1px solid hsl(var(--foreground) / 0.32);
  }

  .doc-toc__title {
    margin: 0 0 0.85rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    color: hsl(var(--muted-foreground));
  }

  .doc-toc__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .doc-toc__item a {
    display: block;
    padding: 0.34rem 0 0.34rem 0.85rem;
    border-left: 1px solid hsl(var(--border));
    font-size: 0.82rem;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    transition:
      color 0.18s ease,
      border-color 0.18s ease;
  }

  .doc-toc__item--h3 a {
    padding-left: 1.6rem;
    font-size: 0.78rem;
  }

  .doc-toc__item a:hover {
    color: hsl(var(--foreground));
  }

  .doc-toc__item a[aria-current='true'] {
    border-left: 2px solid hsl(var(--primary));
    padding-left: calc(0.85rem - 1px);
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .doc-toc__item--h3 a[aria-current='true'] {
    padding-left: calc(1.6rem - 1px);
  }
</style>

<style is:global>
  main.docs-reading .article-left-rail {
    padding-top: 0.35rem;
  }

  main.docs-reading #content {
    font-size: 1rem;
    line-height: 1.78;
    color: hsl(var(--foreground) / 0.92);
  }

  main.docs-reading #content p {
    margin: 0 0 1.15em;
  }

  main.docs-reading #content h2 {
    margin: 2.4em 0 0.9em;
    padding-top: 0.95em;
    border-top: 1px solid hsl(var(--border));
    font-size: 1.28rem;
    font-weight: 640;
    letter-spacing: -0.012em;
  }

  main.docs-reading #content h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }

  main.docs-reading #content h3 {
    margin: 2em 0 0.7em;
    font-size: 1.05rem;
    font-weight: 620;
  }

  main.docs-reading #content a {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.28em;
    text-decoration-color: hsl(var(--muted-foreground) / 0.45);
    transition:
      color 0.18s ease,
      text-decoration-color 0.18s ease;
  }

  main.docs-reading #content a:hover {
    color: hsl(var(--primary));
    text-decoration-color: hsl(var(--primary));
  }

  main.docs-reading #content ul,
  main.docs-reading #content ol {
    margin: 0 0 1.15em;
    padding-left: 1.25em;
  }

  main.docs-reading #content li {
    margin-bottom: 0.45em;
  }

  main.docs-reading #content blockquote {
    margin: 1.6em 0;
    padding: 0 0 0 1.1rem;
    border-left: 2px solid hsl(var(--primary) / 0.55);
    color: hsl(var(--muted-foreground));
  }

  main.docs-reading #content table {
    width: 100%;
    margin: 1.6em 0;
    border-collapse: collapse;
    font-size: 0.86rem;
    font-variant-numeric: tabular-nums;
  }

  main.docs-reading #content th {
    padding: 0.6rem 0.75rem 0.6rem 0;
    border-bottom: 1px solid hsl(var(--foreground) / 0.55);
    font-weight: 600;
    text-align: left;
  }

  main.docs-reading #content td {
    padding: 0.55rem 0.75rem 0.55rem 0;
    border-bottom: 1px solid hsl(var(--border) / 0.8);
  }
</style>

<script>
  import('@/components/scripts/wikilink-preview.ts').catch((error) => {
    console.error('Failed to load wikilink preview:', error)
  })

  function initDocToc() {
    const toc = document.querySelector<HTMLElement>('.doc-toc')
    const content = document.getElementById('content')
    if (!toc || !content || toc.dataset.ready === 'true') return
    toc.dataset.ready = 'true'

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
    const entries = links
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1))
        const heading = content.querySelector(`#${CSS.escape(id)}`)
        return heading ? { link, heading } : null
      })
      .filter((entry): entry is { link: HTMLAnchorElement; heading: Element } => entry !== null)

    if (!entries.length) return

    const mark = (active: Element | null) => {
      entries.forEach(({ link, heading }) => {
        if (heading === active) link.setAttribute('aria-current', 'true')
        else link.removeAttribute('aria-current')
      })
    }

    const observer = new IntersectionObserver(
      (records) => {
        const visible = records
          .filter((record) => record.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
        if (visible.length) mark(visible[0].target)
      },
      { rootMargin: '-18% 0px -62% 0px', threshold: [0, 1] }
    )

    entries.forEach(({ heading }) => observer.observe(heading))
  }

  initDocToc()
  document.addEventListener('astro:page-load', initDocToc)

  function highlightTarget(target: Element, highlightClass = 'anchor-highlight') {
    target.scrollIntoView({ behavior: 'smooth', block: 'center' })
    target.classList.remove(highlightClass)
    void (target as HTMLElement).offsetWidth
    target.classList.add(highlightClass)
    setTimeout(() => target.classList.remove(highlightClass), 2400)
  }

  function getHashTarget(hash: string) {
    if (!hash.startsWith('#') || hash.length === 1) return null
    try {
      return document.getElementById(decodeURIComponent(hash.slice(1)))
    } catch {
      return null
    }
  }

  function highlightCurrentHash() {
    const target = getHashTarget(window.location.hash)
    if (target) highlightTarget(target)
  }

  function initDocsNavigation() {
    document.querySelectorAll('a[data-footnote-ref], a.data-footnote-backref').forEach((link) => {
      if (link.hasAttribute('data-docs-navigation-ready')) return
      link.setAttribute('data-docs-navigation-ready', 'true')
      link.addEventListener('click', (event) => {
        const href = link.getAttribute('href')
        if (!href?.startsWith('#')) return
        const target = document.getElementById(href.slice(1))
        if (!target) return
        event.preventDefault()
        highlightTarget(target)
      })
    })

    document.querySelectorAll<HTMLAnchorElement>('#content a[href^="#"]').forEach((link) => {
      if (link.hasAttribute('data-docs-hash-ready')) return
      link.setAttribute('data-docs-hash-ready', 'true')
      link.addEventListener('click', (event) => {
        const target = getHashTarget(link.hash)
        if (!target) return
        event.preventDefault()
        history.pushState(null, '', link.hash)
        highlightTarget(target)
      })
    })

    const locateTarget = new URLSearchParams(window.location.search).get('locate')
    if (!locateTarget) {
      if (window.location.hash) requestAnimationFrame(highlightCurrentHash)
      return
    }

    setTimeout(() => {
      const target = Array.from(document.querySelectorAll('#content a[href]')).find((link) => {
        const href = link.getAttribute('href')?.split('#', 1)[0] ?? ''
        const documentId = href.replace(/^\/docs\//, '').replace(/\/$/, '')
        return documentId === locateTarget || documentId.split('/').at(-1) === locateTarget
      })
      if (target) {
        highlightTarget(target, 'wikilink-highlight')
        window.history.replaceState({}, '', window.location.pathname + window.location.hash)
      }
    }, 500)
  }

  initDocsNavigation()
  document.addEventListener('astro:page-load', initDocsNavigation)
  window.addEventListener('hashchange', highlightCurrentHash)
</script>
