---
import manifest from '../../../migration/content-manifest.json'
import sites from '../../data/sites.json'
import { sitePath } from '@/utils/site-path'

interface Item {
  change?: string
  area?: string
  scope?: string
  title: string
  note?: string
  links?: { label: string; url: string }[]
}
interface Entry {
  status?: string
  gen?: number
  site?: string
  date?: string
  title: string
  summary?: string
  items: Item[]
  commit?: string
}
interface Props { entries: Entry[]; showSite?: boolean; showVersion?: boolean; showDate?: boolean; clamp?: boolean; maxItems?: number }
const { entries, showSite = false, showVersion = true, showDate = showVersion, clamp = false, maxItems = 3 } = Astro.props
const siteLabel = (id?: string) => sites.find(site => site.id === id)?.label ?? ''
const changes: Record<string, string> = {
  added: '新增', changed: '调整', fixed: '修复', improved: '优化',
  removed: '移除', deprecated: '弃用', security: '安全', planned: '计划',
}
const areas: Record<string, string> = { feature: '功能', style: '样式', infra: '基建', docs: '文档' }
const versionOf = (entry: Entry) => (entry.gen && entry.date ? `v${entry.gen}.${entry.date.replace(/-/g, '.')}` : '')
const linkTo = (url: string) => {
  const original = new URL(url, 'https://yenchiu.com')
  const migrated = manifest.find(item => item.originalUrl === original.href.split(/[?#]/)[0])
  if (migrated) return sitePath(migrated.url) + original.search + original.hash
  // 站内链接走站点根，避免在预览路径下跳到线上域名；站点用 trailingSlash: 'never'，去掉尾斜杠。
  return original.origin === 'https://yenchiu.com'
    ? sitePath(original.pathname.replace(/\/+$/, '') || '/') + original.search + original.hash
    : original.href
}
---
<ol class='updates'>
  {entries.map(entry => <li class:list={['entry', entry.status === 'unreleased' && 'is-unreleased', !showDate && 'no-date']}>
    <div class='entry-side'>
      {entry.status === 'unreleased'
        ? <span class='when'>未发布</span>
        : showDate && <time datetime={entry.date}>{entry.date}</time>}
    </div>
    <div class='update-body'>
      <div class='update-meta'>
        {showVersion && versionOf(entry) && <span class='version'>{versionOf(entry)}</span>}
        {showSite && siteLabel(entry.site) && <span class='site-tag'>{siteLabel(entry.site)}</span>}
        {entry.status === 'unreleased' && <span class='version pending'>在途改动</span>}
        <span class='count'>{entry.items.length} 项</span>
      </div>
      <h3>{entry.title}</h3>
      {entry.summary && <p class='summary'>{entry.summary}</p>}
      <ul class:list={['update-items', clamp && entry.items.length > maxItems && 'is-clamped']} data-max={maxItems}>
        {entry.items.map(item => <li class='update-item' title={item.note ?? item.title}>
          <div class='item-line'>
            {item.change && <span class:list={['flag', `f-${item.change}`]}>{changes[item.change] ?? '更新'}</span>}
            {item.area && <span class='area'>{areas[item.area] ?? item.area}</span>}
            <span class='item-title'>{item.title}</span>
            {item.scope && <span class='item-scope'>{item.scope}</span>}
            {item.links?.map(link => <a class='item-link' href={linkTo(link.url)} aria-label={link.label}>↗</a>)}
          </div>
          {item.note && <p class='item-note'>{item.note}</p>}
        </li>)}
      </ul>
      {clamp && entry.items.length > maxItems && <button type='button' class='more-toggle' data-more aria-expanded='false'>
        还有 {entry.items.length - maxItems} 项，展开看
      </button>}
      {entry.commit && <code>{entry.commit}</code>}
    </div>
  </li>)}
</ol>
<style>
  /* 不再限制行高与框内滚动：版本本身可折叠，展开时按内容自然撑开 */
  .updates {list-style:none;padding:0;margin:0;}
  .entry {display:grid;grid-template-columns:6.5rem minmax(0,1fr);gap:1rem;padding:1.2rem 0;border-bottom:1px solid hsl(var(--border));min-width:0;}
  .entry.no-date {grid-template-columns:minmax(0,1fr);padding-top:.6rem;}
  .entry.no-date .entry-side {display:none;}
  .entry:last-child {border-bottom:0;}
  .entry.is-unreleased {border-bottom-style:dashed;}
  time, .when {display:block;font-size:.75rem;color:hsl(var(--muted-foreground));font-variant-numeric:tabular-nums;padding-top:.2rem;}
  .when {font-size:.7rem;letter-spacing:.04em;color:hsl(var(--primary));}
  .update-meta {display:flex;align-items:center;gap:.65rem;font-size:.67rem;color:hsl(var(--muted-foreground));margin-bottom:.45rem;}
  .version {font-variant-numeric:tabular-nums;font-size:.68rem;letter-spacing:.02em;color:hsl(var(--foreground));border:1px solid hsl(var(--border));border-radius:.3rem;padding:.15rem .4rem;}
  .version.pending {border-style:dashed;color:hsl(var(--muted-foreground));}
  .site-tag {font-size:.66rem;color:hsl(var(--primary));letter-spacing:.02em;}
  .count {font-variant-numeric:tabular-nums;}
  h3 {font-size:.95rem;font-weight:600;line-height:1.7;margin:0;}
  .summary {font-size:.8rem;color:hsl(var(--muted-foreground));line-height:1.7;margin:.2rem 0 0;}
  .update-items {
    list-style:none;margin:.7rem 0 0;padding:0;
    border-top:1px solid hsl(var(--border));
  }
  .update-item {padding:.5rem 0;border-bottom:1px solid hsl(var(--border)/.55);}
  .update-items.is-clamped > .update-item:nth-child(n+4) {display:none;}
  .more-toggle {margin-top:.6rem;font-size:.7rem;color:hsl(var(--primary));background:none;border:1px dashed hsl(var(--border));border-radius:.3rem;padding:.3rem .55rem;cursor:pointer;line-height:1.6;}
  .more-toggle:hover {border-color:hsl(var(--primary)/.5);}
  .update-item:last-child {border-bottom:0;}
  .item-line {display:flex;align-items:center;gap:.4rem;min-width:0;}
  .flag {flex:0 0 auto;font-size:.62rem;border-radius:.3rem;padding:.1rem .32rem;background:hsl(var(--primary)/.1);color:hsl(var(--primary));}
  .f-fixed {background:hsl(38 90% 50% / .16);color:hsl(32 80% 40%);}
  .f-improved {background:hsl(160 60% 45% / .16);color:hsl(165 70% 32%);}
  .f-removed {background:hsl(0 70% 50% / .14);color:hsl(0 65% 45%);}
  .f-deprecated {background:hsl(20 80% 50% / .14);color:hsl(22 75% 42%);}
  .f-security {background:hsl(280 60% 50% / .15);color:hsl(280 55% 45%);}
  .f-planned {background:transparent;border:1px dashed hsl(var(--border));color:hsl(var(--muted-foreground));}
  .area {flex:0 0 auto;font-size:.62rem;color:hsl(var(--muted-foreground));}
  .item-title {min-width:0;font-size:.82rem;font-weight:600;line-height:1.5;overflow-wrap:anywhere;}
  .item-scope {flex:0 0 auto;font-size:.62rem;color:hsl(var(--muted-foreground));}
  .item-link {flex:0 0 auto;font-size:.7rem;color:hsl(var(--primary));text-decoration:none;line-height:1;}
  .item-link:hover {text-decoration:underline;}
  .item-note {font-size:.72rem;color:hsl(var(--muted-foreground));line-height:1.65;margin:.15rem 0 0;overflow-wrap:anywhere;}
  a:focus-visible {outline:2px solid hsl(var(--primary));outline-offset:3px;}
  code {font-size:.7rem;overflow-wrap:anywhere;}
  @media(max-width:600px) {
    .entry {grid-template-columns:1fr;gap:.5rem;}
    time, .when {font-size:.7rem;}
    .update-meta {margin-bottom:.25rem;}
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest?.('.more-toggle') as HTMLElement | null
    if (!button) return
    const list = button.previousElementSibling as HTMLElement | null
    if (!list) return
    const clamped = list.classList.toggle('is-clamped')
    const max = Number(list.dataset.max ?? 3)
    button.setAttribute('aria-expanded', String(!clamped))
    button.textContent = clamped ? `还有 ${list.children.length - max} 项，展开看` : '收起'
  })
</script>
