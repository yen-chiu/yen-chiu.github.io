---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { galleryAlbums } from '@/lib/gallery'
export function getStaticPaths(){return galleryAlbums.map(album=>({params:{id:album.id},props:{album}}))}
const {album}=Astro.props
---
<BaseLayout meta={{title:album.name+' · 光影档案',description:album.name+' 摄影专题'}}>
<main class="album"><a href="/gallery/">← 光影档案</a><header><small>YENCHIU / PHOTO ESSAY</small><h1>{album.name}</h1><p>{album.photos.length} 张作品</p></header>
<div class="wall">{album.photos.map(p=><figure><a href={'/gallery/photo/'+p.id+'/'}><img src={p.preview} alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async"/></a><figcaption>{p.title}</figcaption></figure>)}</div></main>
</BaseLayout>
<style>
.album{max-width:76rem;margin:auto;padding:2rem 0 4rem}header{padding:2rem 0}h1{font-size:clamp(2rem,5vw,4rem);line-height:1.2}small{letter-spacing:.15em}.wall{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem;align-items:start}figure{margin:0}img{width:100%;height:auto;display:block}figcaption{padding:.6rem 0;border-bottom:1px solid hsl(var(--border))}@media(max-width:600px){.wall{grid-template-columns:1fr;gap:1.5rem}}
</style>
