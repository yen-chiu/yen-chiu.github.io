ne":"1036","sender":"Miko"},{"key":"S1-05","chapter":"第一章","line":"1619","sender":"Miko"},{"key":"S1-05-n","chapter":"第一章","line":"1620","sender":"Miko"},{"key":"W1-01","chapter":"第一章","line":"1628","sender":""},{"key":"S2-01-n","chapter":"第二章","line":"202","sender":""},{"key":"S2-02","chapter":"第二章","line":"603","sender":"Miko"},{"key":"S2-03","chapter":"第二章","line":"674","sender":"Miko"},{"key":"S2-06","chapter":"第二章","line":"1108","sender":"Miko"},{"key":"S2-07","chapter":"第二章","line":"1279","sender":"Miko"},{"key":"S2-08","chapter":"第二章","line":"1344","sender":"Miko"},{"key":"W1-03","chapter":"第二章","line":"2074","sender":""},{"key":"S3-01-n","chapter":"第三章","line":"214","sender":""},{"key":"S3-02","chapter":"第三章","line":"1381","sender":"Iris"},{"key":"S3-03-n","chapter":"第三章","line":"1932","sender":""},{"key":"S3-04-n","chapter":"第三章","line":"2682","sender":""},{"key":"W1-05","chapter":"第三章","line":"2879","sender":""},{"key":"W1-06","chapter":"第三章","line":"2880","sender":""},{"key":"S4-01-n","chapter":"第四章","line":"760","sender":""},{"key":"S4-03","chapter":"第四章","line":"1688","sender":"Miko"},{"key":"S4-03-n","chapter":"第四章","line":"1689","sender":""},{"key":"S4-05-n","chapter":"第四章","line":"2041","sender":""},{"key":"S4-06-n","chapter":"第四章","line":"2645","sender":""},{"key":"W1-07","chapter":"第四章","line":"2695","sender":""},{"key":"S5-01-n","chapter":"第五章","line":"467","sender":""},{"key":"S5-02-n","chapter":"第五章","line":"497","sender":""},{"key":"S5-03-n","chapter":"第五章","line":"733","sender":""},{"key":"S5-04","chapter":"第五章","line":"1326","sender":"Miko"},{"key":"S5-04-n","chapter":"第五章","line":"1327","sender":""},{"key":"W1-08","chapter":"第五章","line":"1620","sender":""},{"key":"S6-01-n","chapter":"第六章","line":"106","sender":""},{"key":"S6-02-n","chapter":"第六章","line":"917","sender":""},{"key":"S6-03-n","chapter":"第六章","line":"1410","sender":""},{"key":"S6-04-n","chapter":"第六章","line":"1461","sender":""},{"key":"S6-06","chapter":"第六章","line":"2385","sender":"Miko"},{"key":"W1-09","chapter":"第六章","line":"2828","sender":""},{"key":"W1-10","chapter":"第六章","line":"2829","sender":""}],"dynamics":[{"image":"E1-01","text":"决定了！今天要做一件大事！","chapter":"番外一","line":"63","who":"Miko"},{"image":"E1-02","text":"红丝绒蛋糕出炉！","chapter":"番外一","line":"293","who":"Miko"},{"image":"E2-01","text":"全部是漂亮的小姐姐啊","chapter":"番外二","line":"16","who":"Miko"},{"image":"E2-03","text":"她们都在笑我...无语了...某些人总该为此负责的！","chapter":"番外二","line":"272","who":"Miko"},{"image":"E2-02","text":"虽然是受惩罚，可是Iris这样子还蛮好看的咧hhh","chapter":"番外二","line":"295","who":"Miko"},{"image":"S1-01","text":"我这里能看见星星，你呢","chapter":"第一章","line":"449","who":"Miko"},{"image":"S1-04","text":"爸爸给我拍的照片，给我买的公仔，现在他在哪里？","chapter":"第一章","line":"1107","who":"Miko"},{"image":"S1-05","text":"终于吃到好吃的蛋糕啦，如果有你一起","chapter":"第一章","line":"1621","who":"Miko"},{"image":"S2-01","text":"美少女！美少女！美少女！o(≧ロ≦)o","chapter":"第二章","line":"201","who":"Miko"},{"image":"S2-04","text":"虽然没有找到想要的信息但有人陪着很开心","chapter":"第二章","line":"807","who":"Miko"},{"image":"S2-05","text":"意大利菜真好吃，还有人陪着，希望下次也是","chapter":"第二章","line":"1021","who":"Miko"},{"image":"S2-07","text":"感觉今天会有很大收获，没想到lo裙一点都不违和呀…","chapter":"第二章","line":"1299","who":"Miko"},{"image":"S2-08","text":"好啊！我就发出来！我看哪个不怕死的敢传播这张照片？！","chapter":"第二章","line":"1373","who":"Miko"},{"image":"S2-03","text":"今天穿了好久没穿的小裙子，开心","chapter":"第二章","line":"1524","who":"Miko"},{"image":"S3-01","text":"很高兴认识你们，这里是Miko，给你们添麻烦了","chapter":"第三章","line":"213","who":"Miko"},{"image":"S3-03","text":"好看吗好看吗不说我就等会再问一遍","chapter":"第三章","line":"1931","who":"Miko"},{"image":"S3-04","text":"领我摆脱困境的，是你？还是根本只有我自己","chapter":"第三章","line":"2681","who":"Miko"},{"image":"S4-01","text":"致我所有的朋友，谢谢你们！我会坚强下去的！","chapter":"第四章","line":"759","who":"Miko"},{"image":"S4-02","text":"去练琴，不好的心情都扔掉吧！","chapter":"第四章","line":"999","who":"Miko"},{"image":"S4-03","text":"今天居然去偷护士服，怎么会有这样的事情...","chapter":"第四章","line":"1760","who":"Miko"},{"image":"S4-04","text":"今天认识了好喜欢的小姐姐，还送花给我啾咪","chapter":"第四章","line":"2008","who":"Miko"},{"image":"S4-05","text":"我是不是已经习惯了一个人？什么又是真正的朋友呢？","chapter":"第四章","line":"2040","who":"Miko"},{"image":"S4-06","text":"这个世界为什么这么复杂？还有谁是我可以依靠的？","chapter":"第四章","line":"2644","who":"Miko"},{"image":"S5-01","text":"为什么我不可以有自己的朋友？为什么我不可以做自己想做的事情？","chapter":"第五章","line":"466","who":"Miko"},{"image":"S5-02","text":"不一样的衣服就是不一样的心情","chapter":"第五章","line":"496","who":"Miko"},{"image":"S5-03","text":"奇怪的人类发明啊...还有，我怎么莫名其就来博物馆晃一下午了…","chapter":"第五章","line":"732","who":"Miko"},{"image":"S5-05","text":"酷！！莉姐准备这样带我中破晚高峰！","chapter":"第五章","line":"1423","who":"Miko"},{"image":"S5-06","text":"我是在帮助别人吗？我感觉我是在帮助自己，帮助自己找到自己的路。","chapter":"第五章","line":"1580","who":"Miko"},{"image":"S6-01","text":"便利店小哥哥送了我一个棒棒糖，他说吃了糖心情就会变好了...真的会吗？","chapter":"第六章","line":"105","who":"Miko"},{"image":"S6-02","text":"今天突然想穿小裙子","chapter":"第六章","line":"916","who":"Miko"},{"image":"S6-03","text":"原来被整个世界抛弃是这种感受，这是不是就是所谓的孤独？","chapter":"第六章","line":"1409","who":"Miko"},{"image":"S6-04","text":"无法想象他的心情...真的对不起...","chapter":"第六章","line":"1460","who":"Miko"},{"image":"S6-05","text":"换了个造型，感觉自己瞬间变成了大佬","chapter":"第六章","line":"1748","who":"Miko"},{"image":"S6-07","text":"我改变不了这个世界，只能改变我自己","chapter":"第六章","line":"2760","who":"Miko"}],"profiles":{"Miko":{"sig":"走在未知的道路上，不许停也不能回头","tags":["甜品控","高中生","蓝带","腿玩年"],"cover":"images/聊天背景.webp"},"Iris":{"sig":"","tags":[],"cover":"images/菜单背景.webp"},"Lily":{"sig":"","tags":[],"cover":"images/菜单背景.webp"}},"voices":[{"who":"Miko","name":"哈哈哈，我是天才","chapter":"番外一","line":"295"},{"who":"Miko","name":"走在未知的道路上，不许停也不能回头","chapter":"第三章","line":"660"}],"days":{"第一章":["Day1","Day2","Day3"],"第二章":["Day1","Day2","Day3"],"第三章":["Day1","Day2","Day3"],"第四章":["Day1","Day2","Day3","Day4"],"第五章":["Day1","Day2","Day3"],"第六章":["Day1","Day2","Day3","Day4"]},"photos":["E1-01","E1-02","E2-01","E2-02","E2-03","E2-04","E2-04","S1-01-n","S1-01","S1-02","S1-03","S1-04","S1-05","S2-01","S2-02","S2-03","S2-04","S2-05","S2-06","S2-07","S2-08","S3-01","S3-02","S3-03","S3-04","S4-01","S4-02","S4-03","S4-04","S4-05","S4-06","S5-01","S5-02","S5-03","S5-04","S5-05","S5-06","S6-01","S6-02","S6-03","S6-04","S6-05","S6-06","S6-07","W1-01","W1-02","W1-03","W1-04","W1-05","W1-06","W1-07","W1-08","W1-09","W1-10","april","birthday","christmas","mid_autumn"],"chapters":[{"id":"番外一","cover":"chapter/番外一.webp","days":0},{"id":"番外二","cover":"chapter/番外二.webp","days":0},{"id":"第一章","cover":"chapter/第一章.webp","days":3},{"id":"第二章","cover":"chapter/第二章.webp","days":3},{"id":"第三章","cover":"chapter/第三章.webp","days":3},{"id":"第四章","cover":"chapter/第四章.webp","days":4},{"id":"第五章","cover":"chapter/第五章.webp","days":3},{"id":"第六章","cover":"chapter/第六章.webp","days":4}]}