---
import { sitePath } from '@/utils/site-path'
const colors = [
  { name: '紫', hue: 267 }, { name: '蓝', hue: 215 }, { name: '青', hue: 165 },
  { name: '粉', hue: 335 }, { name: '琥珀', hue: 35 }
]
const wallpaperPresets = [
  { name: '星夜', subtitle: '原版封面', src: '/images/moonlit-cover.svg' },
  { name: '极光', subtitle: '深蓝与湖绿', src: '/images/wallpapers/aurora-ridge.svg' },
  { name: '晨雾', subtitle: '冷银与远山', src: '/images/wallpapers/silver-mist.svg' },
  { name: '晚霞', subtitle: '玫瑰色海面', src: '/images/wallpapers/rose-twilight.svg' }
]
---
<appearance-panel id='appearance-panel' class='appearance-panel' hidden aria-label='外观设置'>
  <header>
    <strong>外观设置</strong>
    <button type='button' data-appearance-close aria-label='关闭外观设置'>×</button>
  </header>
  <h2 class='settings-group-title'>全站外观</h2>
  <fieldset>
    <legend>主题颜色 <output data-hue-value>267°</output></legend>
    <div class='presets'>{colors.map(color => (
      <button type='button' data-hue={color.hue} aria-pressed='false'
        style={'--swatch:hsl(' + color.hue + ' 55% 58%)'}>
        <i aria-hidden='true'></i>{color.name}
      </button>
    ))}</div>
    <input type='range' min='0' max='360' step='1' value='267'
      aria-label='主题色相' data-hue-slider />
  </fieldset>

  <fieldset>
    <legend>显示模式</legend>
    <div class='options'>
      {['system', 'light', 'dark'].map((value, i) => (
        <button type='button' data-theme-choice={value} aria-pressed={i === 0 ? 'true' : 'false'}>
          {['跟随系统', '浅色', '深色'][i]}
        </button>
      ))}
    </div>
  </fieldset>

  <fieldset>
    <legend>动画效果</legend>
    <div class='options'>
      {['system', 'always', 'reduced'].map((value, i) => (
        <button type='button' data-motion-choice={value} aria-pressed={i === 0 ? 'true' : 'false'}>
          {['跟随系统', '总是开启', '减少动画'][i]}
        </button>
      ))}
    </div>
    <p class='setting-hint'>觉得页面太晃就选「减少动画」。想保留打字机、卡片浮现和点击烟花，可以选「总是开启」。</p>
  </fieldset>

  <fieldset>
    <legend>网络加载</legend>
    <div class='options'>
      {['auto', 'standard', 'saving'].map((value, i) => (
        <button type='button' data-network-choice={value} aria-pressed={i === 0 ? 'true' : 'false'}>{['自动', '标准', '节省流量'][i]}</button>
      ))}
    </div>
    <p class='setting-hint'>自动根据浏览器提供的节流偏好及网络类型减少提前加载；节省流量不会关闭正文或主动播放的音乐。所有模式均需主动加载评论。</p>
  </fieldset>
  <fieldset>
    <legend>头像</legend>
    <label class='switch'>动态头像（Animated WebP）<input type='checkbox' data-animated-avatar-choice /></label>
    <p class='setting-hint'>默认开启动态头像。首页人物在固定头像框内轻微浮动，关于页使用 Animated WebP；选择「减少动画」或系统启用减少动态效果时保持静态。</p>
  </fieldset>

  <h2 class='settings-group-title'>首页</h2>
  <fieldset>
    <legend>首页封面</legend>
    <label class='switch'>显示封面插画<input type='checkbox' data-cover-choice checked /></label>
    <label class='switch'>显示标题<input type='checkbox' data-title-choice checked /></label>
    <label class='switch'>轻微波浪<input type='checkbox' data-waves-choice /></label>
    <p class='setting-hint'>首页保留全屏入口，下滑后收起。</p>
  </fieldset>

  <fieldset class='home-wallpaper-settings'>
    <legend>首页壁纸</legend>
    <div class='options'>
      <button type='button' data-home-wallpaper-mode='inherit' aria-pressed='true'>跟随内页</button>
      <button type='button' data-home-wallpaper-mode='separate' aria-pressed='false'>单独设置</button>
    </div>
    <p class='setting-hint'>默认沿用内页选定的图片，但不改变首页封面的显示方式。也可以为首页单独设置图片。</p>
    <div data-home-wallpaper-specific hidden>
      <div class='wallpaper-gallery home-wallpaper-gallery' aria-label='首页壁纸预设'>
        {wallpaperPresets.map(preset => (
          <button type='button' class='wallpaper-tile' data-home-wallpaper-source={preset.src}
            aria-pressed='false' title={preset.subtitle}>
            <img src={sitePath(preset.src)} alt='' width='150' height='78' loading='lazy' decoding='async' />
            <span class='wallpaper-tile-caption'><strong>{preset.name}</strong><small>{preset.subtitle}</small></span>
          </button>
        ))}
        <button type='button' class='wallpaper-tile' data-home-wallpaper-use-uploaded hidden aria-pressed='false'>
          <span class='home-uploaded-preview' aria-hidden='true'></span>
          <span class='wallpaper-tile-caption'><strong>首页照片</strong><small>仅保存在本机</small></span>
        </button>
      </div>
      <div class='wallpaper-custom'>
        <label for='home-wallpaper-custom-url'>首页图片地址（HTTPS）</label>
        <div class='wallpaper-url-row'>
          <input id='home-wallpaper-custom-url' data-home-wallpaper-url type='url'
            inputmode='url' maxlength='2048' spellcheck='false'
            placeholder='https://example.com/cover.webp' autocomplete='off' />
          <button type='button' data-home-wallpaper-url-apply>使用链接</button>
        </div>
      </div>
      <div class='wallpaper-local-actions'>
        <label class='wallpaper-upload-action' for='home-wallpaper-upload'>
          上传首页图片
          <input id='home-wallpaper-upload' type='file' data-home-wallpaper-file
            accept='image/jpeg,image/png,image/webp,image/avif' />
        </label>
        <button type='button' data-home-wallpaper-clear-upload hidden>删除首页图片</button>
      </div>
      <p class='setting-hint'>支持 JPG / PNG / WebP / AVIF（不超过 8 MB）。首页上传的图片与内页上传图分开保存，都只留在当前浏览器。</p>
      <p class='wallpaper-status' data-home-wallpaper-status role='status' aria-live='polite'></p>
    </div>
  </fieldset>

  <fieldset>
    <legend>首页开场</legend>
    <label class='switch'>银墨开场动画<input type='checkbox' data-silver-ink-choice /></label>
    <p class='setting-hint'>默认关闭。开启后，每次新会话进入首页时最多播放一次银墨动画；不喜欢可以随时关掉。</p>
  </fieldset>

  <h2 class='settings-group-title'>内页</h2>
  <fieldset>
    <legend>内页背景</legend>
    <div class='options wallpaper'>
      {['banner', 'fullscreen', 'overlay'].map((value, i) => (
        <button type='button' data-wallpaper-choice={value} aria-pressed={i === 0 ? 'true' : 'false'}>
          {['纯色', '壁纸', '柔化'][i]}
        </button>
      ))}
    </div>
    <p class='setting-hint'>应用于博客、文章、归档等内页。首页默认使用这里选中的图片，也可以单独指定。</p>
  </fieldset>

  <fieldset class='wallpaper-settings'>
    <legend>内页壁纸图片</legend>
    <div class='wallpaper-gallery' aria-label='壁纸预设'>
      {wallpaperPresets.map(preset => (
        <button type='button' class='wallpaper-tile' data-wallpaper-source={preset.src}
          aria-pressed='false' title={preset.subtitle}>
          <img src={sitePath(preset.src)} alt='' width='150' height='78'
            loading='lazy' decoding='async' />
          <span class='wallpaper-tile-caption'><strong>{preset.name}</strong><small>{preset.subtitle}</small></span>
        </button>
      ))}
      <button type='button' class='wallpaper-tile wallpaper-tile-uploaded'
        data-wallpaper-use-uploaded aria-pressed='false' hidden>
        <span class='wallpaper-uploaded-preview' aria-hidden='true'></span>
        <span class='wallpaper-tile-caption'><strong>我的图片</strong><small>保存在本机</small></span>
      </button>
    </div>
    <div class='wallpaper-opacity'>
      <label for='wallpaper-opacity'>壁纸强度</label>
      <output for='wallpaper-opacity' data-wallpaper-opacity>24%</output>
    </div>
    <input id='wallpaper-opacity' data-wallpaper-opacity-slider
      type='range' min='8' max='75' step='1' value='24'
      aria-label='壁纸显示强度' />
    <p class='setting-hint'>选择预设后会自动切换到壁纸模式；阅读时觉得花，就调低强度或选「柔化」。</p>

    <div class='wallpaper-custom'>
      <label for='wallpaper-custom-url'>图片地址（HTTPS）</label>
      <div class='wallpaper-url-row'>
        <input id='wallpaper-custom-url' data-wallpaper-url type='url'
          inputmode='url' maxlength='2048' spellcheck='false'
          placeholder='https://example.com/photo.webp' autocomplete='off' />
        <button type='button' data-wallpaper-url-apply>使用链接</button>
      </div>
      <p class='setting-hint'>外链图片由浏览器直接请求原网站；对方可能禁止引用，也可能记录访问请求。</p>
    </div>
    <div class='wallpaper-local-actions'>
      <label class='wallpaper-upload-action' for='wallpaper-upload'>
        上传本地图片
        <input id='wallpaper-upload' type='file' data-wallpaper-file
          accept='image/jpeg,image/png,image/webp,image/avif' />
      </label>
      <button type='button' data-wallpaper-clear-upload hidden>删除本地图片</button>
    </div>
    <p class='setting-hint'>支持 JPG / PNG / WebP / AVIF，最大 8 MB。图片只存于当前浏览器，清除浏览器数据后会消失，也不会同步到其他设备。</p>
    <p class='wallpaper-status' data-wallpaper-status role='status' aria-live='polite'></p>
  </fieldset>

  <h2 class='settings-group-title'>文章列表</h2>
  <fieldset>
    <legend>文章列表布局</legend>
    <div class='options'>
      <button type='button' data-layout-choice='list' aria-pressed='true'>列表</button>
      <button type='button' data-layout-choice='grid' aria-pressed='false'>网格</button>
    </div>
  </fieldset>

  <button class='reset' type='button' data-appearance-reset>恢复默认外观</button>
</appearance-panel>

<script>
  import type { AppearanceSettings } from '../../types/appearance'

  class AppearancePanel extends HTMLElement {
    private controller?: AbortController

    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      const { signal } = this.controller
      const api = () => window.wendellAppearance
      const status = this.querySelector<HTMLElement>('[data-wallpaper-status]')
      const urlInput = this.querySelector<HTMLInputElement>('[data-wallpaper-url]')
      const uploadInput = this.querySelector<HTMLInputElement>('[data-wallpaper-file]')
      const savedImageButton = this.querySelector<HTMLButtonElement>('[data-wallpaper-use-uploaded]')
      const clearImageButton = this.querySelector<HTMLButtonElement>('[data-wallpaper-clear-upload]')
      const homeStatus = this.querySelector<HTMLElement>('[data-home-wallpaper-status]')
      const homeUrlInput = this.querySelector<HTMLInputElement>('[data-home-wallpaper-url]')
      const homeUploadInput = this.querySelector<HTMLInputElement>('[data-home-wallpaper-file]')
      const homeSavedButton = this.querySelector<HTMLButtonElement>('[data-home-wallpaper-use-uploaded]')
      const homeClearButton = this.querySelector<HTMLButtonElement>('[data-home-wallpaper-clear-upload]')
      const homeSpecific = this.querySelector<HTMLElement>('[data-home-wallpaper-specific]')
      const setStatus = (message: string, error = false) => {
        if (!status) return
        status.textContent = message
        status.dataset.error = String(error)
      }
      const setHomeStatus = (message: string, error = false) => {
        if (!homeStatus) return
        homeStatus.textContent = message
        homeStatus.dataset.error = String(error)
      }
      const sync = () => {
        const settings = api()?.get()
        if (!settings) return
        this.querySelectorAll<HTMLButtonElement>('[data-hue]').forEach(button =>
          button.setAttribute('aria-pressed', String(Number(button.dataset.hue) === settings.hue)))
        for (const [selector, key] of [
          ['theme-choice', 'theme'], ['wallpaper-choice', 'wallpaper'],
          ['layout-choice', 'layout'], ['motion-choice', 'motion'], ['network-choice', 'network']
        ] as const) {
          this.querySelectorAll<HTMLButtonElement>('[data-' + selector + ']').forEach(button =>
            button.setAttribute('aria-pressed',
              String(button.getAttribute('data-' + selector) === settings[key])))
        }
        this.querySelectorAll<HTMLButtonElement>('[data-wallpaper-source]').forEach(button =>
          button.setAttribute('aria-pressed',
            String(button.dataset.wallpaperSource === settings.wallpaperSource)))
        savedImageButton?.setAttribute('aria-pressed',
          String(settings.wallpaperSource === 'uploaded'))
        const homeSeparate = settings.homeWallpaperSource !== 'inherit'
        this.querySelectorAll<HTMLButtonElement>('[data-home-wallpaper-mode]').forEach(button =>
          button.setAttribute('aria-pressed',
            String(button.dataset.homeWallpaperMode === (homeSeparate ? 'separate' : 'inherit'))))
        if (homeSpecific) homeSpecific.hidden = !homeSeparate
        this.querySelectorAll<HTMLButtonElement>('[data-home-wallpaper-source]').forEach(button =>
          button.setAttribute('aria-pressed',
            String(button.dataset.homeWallpaperSource === settings.homeWallpaperSource)))
        homeSavedButton?.setAttribute('aria-pressed',
          String(settings.homeWallpaperSource === 'home-uploaded'))
        if (homeUrlInput && document.activeElement !== homeUrlInput)
          homeUrlInput.value = settings.homeWallpaperSource.startsWith('https://')
            ? settings.homeWallpaperSource : ''
        const hueOutput = this.querySelector<HTMLOutputElement>('[data-hue-value]')
        if (hueOutput) hueOutput.value = settings.hue + '°'
        const hueSlider = this.querySelector<HTMLInputElement>('[data-hue-slider]')
        if (hueSlider) hueSlider.value = String(settings.hue)
        const opacityOutput = this.querySelector<HTMLOutputElement>('[data-wallpaper-opacity]')
        if (opacityOutput) opacityOutput.value = settings.wallpaperOpacity + '%'
        const opacitySlider = this.querySelector<HTMLInputElement>('[data-wallpaper-opacity-slider]')
        if (opacitySlider) opacitySlider.value = String(settings.wallpaperOpacity)
        for (const [attr, value] of [
          ['data-cover-choice', settings.cover],
          ['data-title-choice', settings.title],
          ['data-waves-choice', settings.waves],
          ['data-silver-ink-choice', settings.silverInk],
          ['data-animated-avatar-choice', settings.animatedAvatar]
        ] as const) {
          const checkbox = this.querySelector<HTMLInputElement>('[' + attr + ']')
          if (checkbox) checkbox.checked = value
        }
        if (urlInput && document.activeElement !== urlInput)
          urlInput.value = settings.wallpaperSource.startsWith('https://')
            ? settings.wallpaperSource : ''
      }
      const refreshUploaded = async () => {
        try {
          const hasSaved = await api()?.hasUpload()
          if (!this.isConnected) return
          if (savedImageButton) savedImageButton.hidden = !hasSaved
          if (clearImageButton) clearImageButton.hidden = !hasSaved
        } catch {
          if (savedImageButton) savedImageButton.hidden = true
          if (clearImageButton) clearImageButton.hidden = true
        }
      }
      const refreshHomeUploaded = async () => {
        try {
          const saved = await api()?.hasHomeUpload()
          if (!this.isConnected) return
          if (homeSavedButton) homeSavedButton.hidden = !saved
          if (homeClearButton) homeClearButton.hidden = !saved
        } catch {
          if (homeSavedButton) homeSavedButton.hidden = true
          if (homeClearButton) homeClearButton.hidden = true
        }
      }
      const applyHomeExternalImage = async () => {
        const raw = homeUrlInput?.value.trim() ?? ''
        let url: URL
        try {
          url = new URL(raw)
          if (url.protocol !== 'https:' || url.username || url.password || raw.length > 2048)
            throw new Error('请填写有效的 HTTPS 图片地址')
        } catch {
          setHomeStatus('图片地址不正确，请填完整的 HTTPS 链接。', true)
          return
        }
        const button = this.querySelector<HTMLButtonElement>('[data-home-wallpaper-url-apply]')
        if (button) button.disabled = true
        setHomeStatus('正在检查首页图片…')
        try {
          await new Promise<void>((resolve, reject) => {
            const image = new Image()
            const timeout = window.setTimeout(() => {
              image.src = ''
              reject(new Error('图片加载超时，请换个链接'))
            }, 10000)
            image.onload = () => { window.clearTimeout(timeout); resolve() }
            image.onerror = () => {
              window.clearTimeout(timeout)
              reject(new Error('图片无法加载，可能是链接失效或禁止外链'))
            }
            image.src = url.href
          })
          if (!this.isConnected) return
          api()?.set({ homeWallpaperSource: url.href })
          setHomeStatus('首页壁纸已切换。')
        } catch (error) {
          setHomeStatus(error instanceof Error ? error.message : '无法使用这张图片', true)
        } finally {
          if (button) button.disabled = false
        }
      }
      const applyExternalImage = async () => {
        const raw = urlInput?.value.trim() ?? ''
        let url: URL
        try {
          url = new URL(raw)
          if (url.protocol !== 'https:' || url.username || url.password || raw.length > 2048)
            throw new Error('请使用有效的 HTTPS 图片地址')
        } catch {
          setStatus('图片地址不正确，请填完整的 HTTPS 链接。', true)
          return
        }
        setStatus('正在检查图片链接…')
        const button = this.querySelector<HTMLButtonElement>('[data-wallpaper-url-apply]')
        if (button) button.disabled = true
        try {
          await new Promise<void>((resolve, reject) => {
            const image = new Image()
            const timeout = window.setTimeout(() => {
              image.src = ''
              reject(new Error('图片加载超时，试试换一个链接'))
            }, 10000)
            image.onload = () => { window.clearTimeout(timeout); resolve() }
            image.onerror = () => {
              window.clearTimeout(timeout)
              reject(new Error('图片无法加载，可能是链接失效或网站禁止引用'))
            }
            image.src = url.href
          })
          if (!this.isConnected) return
          api()?.set({ wallpaperSource: url.href, wallpaper: 'fullscreen' })
          setStatus('已切换到自定义壁纸。')
        } catch (error) {
          setStatus(error instanceof Error ? error.message : '图片加载失败', true)
        } finally {
          if (button) button.disabled = false
        }
      }

      this.addEventListener('click', event => {
        const button = (event.target as Element).closest<HTMLButtonElement>('button')
        if (!button || !api()) return
        if (button.hasAttribute('data-hue')) api()?.set({ hue: Number(button.dataset.hue) })
        if (button.dataset.themeChoice)
          api()?.set({ theme: button.dataset.themeChoice as AppearanceSettings['theme'] })
        if (button.dataset.wallpaperChoice)
          api()?.set({ wallpaper: button.dataset.wallpaperChoice as AppearanceSettings['wallpaper'] })
        if (button.dataset.wallpaperSource) {
          api()?.set({ wallpaperSource: button.dataset.wallpaperSource, wallpaper: 'fullscreen' })
          setStatus('壁纸已切换。')
        }
        if (button.dataset.homeWallpaperMode === 'inherit')
          api()?.set({ homeWallpaperSource: 'inherit' })
        if (button.dataset.homeWallpaperMode === 'separate') {
          const current = api()?.get()
          if (current) api()?.set({
            homeWallpaperSource: current.homeWallpaperSource === 'inherit'
              ? current.wallpaperSource : current.homeWallpaperSource
          })
        }
        if (button.dataset.homeWallpaperSource) {
          api()?.set({ homeWallpaperSource: button.dataset.homeWallpaperSource })
          setHomeStatus('首页壁纸已切换。')
        }
        if (button.hasAttribute('data-home-wallpaper-url-apply'))
          void applyHomeExternalImage()
        if (button.hasAttribute('data-home-wallpaper-use-uploaded')) {
          void api()?.useHomeUpload()
            .then(() => setHomeStatus('已切换到保存的首页图片。'))
            .catch((error: unknown) => setHomeStatus(
              error instanceof Error ? error.message : '无法读取首页图片', true))
        }
        if (button.hasAttribute('data-home-wallpaper-clear-upload')) {
          void api()?.clearHomeUpload()
            .then(() => { setHomeStatus('已删除保存的首页图片。'); void refreshHomeUploaded() })
            .catch((error: unknown) => setHomeStatus(
              error instanceof Error ? error.message : '无法删除首页图片', true))
        }
        if (button.dataset.layoutChoice)
          api()?.set({ layout: button.dataset.layoutChoice as AppearanceSettings['layout'] })
        if (button.dataset.networkChoice)
          api()?.set({ network: button.dataset.networkChoice as AppearanceSettings['network'] })
        if (button.dataset.motionChoice)
          api()?.set({ motion: button.dataset.motionChoice as AppearanceSettings['motion'] })
        if (button.hasAttribute('data-wallpaper-url-apply')) void applyExternalImage()
        if (button.hasAttribute('data-wallpaper-use-uploaded')) {
          void api()?.useUpload()
            .then(() => setStatus('已切换到本地图片。'))
            .catch((error: unknown) => setStatus(
              error instanceof Error ? error.message : '无法读取本地图片', true))
        }
        if (button.hasAttribute('data-wallpaper-clear-upload')) {
          void api()?.clearUpload()
            .then(() => { setStatus('本地图片已删除。'); void refreshUploaded() })
            .catch((error: unknown) => setStatus(
              error instanceof Error ? error.message : '无法删除本地图片', true))
        }
        if (button.hasAttribute('data-appearance-reset')) {
          api()?.reset()
          setStatus('已恢复默认外观；已上传图片未删除，需要时可以重新选择。')
        }
      }, { signal })
      this.querySelector('[data-hue-slider]')?.addEventListener('input', event =>
        api()?.set({ hue: Number((event.target as HTMLInputElement).value) }), { signal })
      this.querySelector('[data-wallpaper-opacity-slider]')?.addEventListener('input', event =>
        api()?.set({ wallpaperOpacity: Number((event.target as HTMLInputElement).value) }), { signal })
      homeUrlInput?.addEventListener('keydown', event => {
        if (event.key === 'Enter') { event.preventDefault(); void applyHomeExternalImage() }
      }, { signal })
      homeUploadInput?.addEventListener('change', () => {
        const image = homeUploadInput.files?.[0]
        if (!image) return
        setHomeStatus('正在保存首页图片…')
        void api()?.uploadHome(image)
          .then(() => { setHomeStatus('首页图片已保存到当前浏览器。'); void refreshHomeUploaded() })
          .catch((error: unknown) => setHomeStatus(
            error instanceof Error ? error.message : '首页图片保存失败', true))
          .finally(() => { homeUploadInput.value = '' })
      }, { signal })
      urlInput?.addEventListener('keydown', event => {
        if (event.key === 'Enter') { event.preventDefault(); void applyExternalImage() }
      }, { signal })
      uploadInput?.addEventListener('change', () => {
        const image = uploadInput.files?.[0]
        if (!image) return
        setStatus('正在保存图片到本地…')
        void api()?.upload(image)
          .then(() => { setStatus('壁纸已保存到当前浏览器。'); void refreshUploaded() })
          .catch((error: unknown) =>
            setStatus(error instanceof Error ? error.message : '图片保存失败', true))
          .finally(() => { uploadInput.value = '' })
      }, { signal })
      this.addEventListener('change', event => {
        const input = event.target as HTMLInputElement
        if (input.hasAttribute('data-cover-choice')) api()?.set({ cover: input.checked })
        if (input.hasAttribute('data-title-choice')) api()?.set({ title: input.checked })
        if (input.hasAttribute('data-waves-choice')) api()?.set({ waves: input.checked })
        if (input.hasAttribute('data-silver-ink-choice')) api()?.set({ silverInk: input.checked })
        if (input.hasAttribute('data-animated-avatar-choice')) api()?.set({ animatedAvatar: input.checked })
      }, { signal })
      window.addEventListener('wendell:appearance', sync, { signal })
      sync()
      void refreshUploaded()
      void refreshHomeUploaded()
    }
    disconnectedCallback() { this.controller?.abort() }
  }
  if (!customElements.get('appearance-panel'))
    customElements.define('appearance-panel', AppearancePanel)
</script>

