---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { photos } from '@/data/photos'
import { galleryAlbums } from '@/lib/gallery'
const ordered=[...photos].sort((a,b)=>b.date.localeCompare(a.date))
const featured=ordered.find(p=>p.featured)||ordered[0]
const albums=[...new Set(ordered.map(p=>p.album))]
---
<BaseLayout meta={{title:'光影档案 · Gallery',description:'YenChiu 摄影作品集'}}>
<main class="gallery">
<header><span class="eyebrow">YENCHIU / PHOTOGRAPHY</span><h1>光影档案</h1><p>用镜头记录时间与所见。</p><small>{ordered.length} 张照片 · {albums.length} 个相册</small></header>
{featured&&<section class="feature"><a href={'/gallery/photo/'+featured.id+'/'}><img src={featured.variants?.[1920]||featured.preview} width={featured.width} height={featured.height} alt={featured.alt} decoding="async"/></a><div><span class="eyebrow">SELECTED WORK / 精选</span><h2>{featured.title}</h2><p>{featured.caption||featured.album}</p></div></section>}
{galleryAlbums.length>0&&<section class="album-index"><h2>摄影专题</h2><div>{galleryAlbums.map(a=><a href={'/gallery/album/'+a.id+'/'}>{a.name} <small>{a.photos.length} 张 →</small></a>)}</div></section>}
<photo-gallery>
<nav aria-label="筛选相册"><button data-album="" aria-pressed="true">全部</button>{albums.map(a=><button data-album={a} aria-pressed="false">{a}</button>)}</nav>
{ordered.length===0?<section class="empty"><h2>相册尚未开放</h2><p>第一组摄影作品整理完成后，将在这里呈现。</p></section>:<div class="wall">{ordered.map((p,i)=><figure data-group={p.album} class:list={[{wide:p.width/p.height>1.45&&i%5===0}]}><a href={p.preview} data-photo data-detail={'/gallery/photo/'+p.id+'/'} data-title={p.title} data-caption={p.caption||''} data-camera={p.camera||''} data-date={p.date}><img src={p.thumbnail} srcset={p.variants?`${p.variants[480]} 480w, ${p.variants[960]} 960w, ${p.variants[1920]} 1920w`:undefined} sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw" alt={p.alt} width={p.width} height={p.height} loading={i<2?'eager':'lazy'} decoding="async"/></a><figcaption><a href={'/gallery/photo/'+p.id+'/'}><strong>{p.title}</strong></a><small>{p.date}</small></figcaption></figure>)}</div>}
<dialog aria-label="照片浏览"><div class="viewer"><button data-close aria-label="关闭">×</button><button data-prev aria-label="上一张">‹</button><img data-full alt=""/><button data-next aria-label="下一张">›</button><div class="details"><strong data-title-out></strong><p data-caption-out></p><small data-meta></small><p><a data-detail-out href="/gallery/">作品详情 →</a></p></div></div></dialog>
</photo-gallery>
</main></BaseLayout>
<script>
class PhotoGallery extends HTMLElement {
 connectedCallback(){
 const dialog=this.querySelector('dialog')!
 const full=dialog.querySelector<HTMLImageElement>('[data-full]')!
 const links=[...this.querySelectorAll<HTMLAnchorElement>('[data-photo]')]
 let active=links, index=0, opener:HTMLElement|null=null
 const show=(i:number)=>{if(!active.length)return;index=(i+active.length)%active.length;const a=active[index];full.src=a.href;dialog.querySelector<HTMLAnchorElement>('[data-detail-out]')!.href=a.dataset.detail||'/gallery/';full.alt=a.querySelector('img')?.alt||'';dialog.querySelector('[data-title-out]')!.textContent=a.dataset.title||'';dialog.querySelector('[data-caption-out]')!.textContent=a.dataset.caption||'';dialog.querySelector('[data-meta]')!.textContent=[a.dataset.date,a.dataset.camera].filter(Boolean).join(' · ')}
 this.querySelectorAll<HTMLButtonElement>('[data-album]').forEach(b=>b.onclick=()=>{this.querySelectorAll('[data-album]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));this.querySelectorAll<HTMLElement>('[data-group]').forEach(x=>x.hidden=!!b.dataset.album&&x.dataset.group!==b.dataset.album);active=links.filter(a=>!a.closest('figure')?.hidden)})
 links.forEach(a=>a.onclick=e=>{if(e.ctrlKey||e.metaKey||e.shiftKey||e.altKey)return;e.preventDefault();opener=a;show(active.indexOf(a));dialog.showModal()})
 dialog.querySelector<HTMLButtonElement>('[data-close]')!.onclick=()=>dialog.close()
 dialog.querySelector<HTMLButtonElement>('[data-prev]')!.onclick=()=>show(index-1)
 dialog.querySelector<HTMLButtonElement>('[data-next]')!.onclick=()=>show(index+1)
 dialog.onkeydown=e=>{if(e.key==='ArrowLeft'||e.key==='ArrowRight'){e.preventDefault();show(index+(e.key==='ArrowLeft'?-1:1))}}
 let startX=0,startY=0;full.addEventListener('touchstart',e=>{startX=e.changedTouches[0].clientX;startY=e.changedTouches[0].clientY},{passive:true});full.addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-startX,dy=e.changedTouches[0].clientY-startY;if(Math.abs(dx)>60&&Math.abs(dx)>Math.abs(dy)*1.5)show(index+(dx<0?1:-1))},{passive:true});
 dialog.onclose=()=>{full.removeAttribute('src');opener?.focus()}
 }
}
if(!customElements.get('photo-gallery'))customElements.define('photo-gallery',PhotoGallery)
</script>
<style>
.gallery{max-width:76rem;margin:auto;padding:clamp(1rem,4vw,3rem) 0 4rem}.eyebrow{font-size:.72rem;letter-spacing:.2em;color:hsl(var(--primary))}header{margin-bottom:2rem}h1{font-size:clamp(2.2rem,6vw,4rem);letter-spacing:-.045em;line-height:1.2;margin:.6rem 0}header p{margin:.5rem 0}small,header p{color:hsl(var(--muted-foreground))}nav{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1.5rem}button{min-height:44px;min-width:44px;padding:.5rem .9rem;border:1px solid hsl(var(--border));border-radius:999px}button[aria-pressed=true]{background:hsl(var(--primary));color:hsl(var(--primary-foreground))}.wall{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,245px),1fr));gap:1.2rem;align-items:start}figure{margin:0;min-width:0}figure[hidden]{display:none}figure img{width:100%;height:auto;border-radius:8px;display:block}figcaption{display:flex;justify-content:space-between;gap:.5rem;padding:.6rem 0;font-size:.85rem}.empty{padding:4rem 1rem;border-block:1px solid hsl(var(--border));text-align:center}.empty p{color:hsl(var(--muted-foreground))}dialog{max-width:100vw;max-height:100dvh;width:100vw;height:100dvh;margin:auto;background:#111;color:#eee;border:0;padding:0}dialog::backdrop{background:#111}.viewer{height:100%;display:grid;grid-template-columns:44px minmax(0,1fr) 44px;grid-template-rows:48px minmax(0,1fr) auto;align-items:center;gap:4px;padding:8px}.viewer img{grid-column:2;width:100%;height:100%;object-fit:contain}.viewer [data-close]{grid-column:3;grid-row:1}.viewer [data-prev]{grid-column:1;grid-row:2}.viewer [data-next]{grid-column:3;grid-row:2}.details{grid-column:1/-1;text-align:center;padding:10px;overflow-wrap:anywhere}.details p{margin:.35rem 0}button:focus-visible,a:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:3px}
.feature{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);gap:clamp(1rem,4vw,3rem);align-items:center;margin:0 0 3rem;border-block:1px solid hsl(var(--border));padding:1.2rem 0}.feature img{width:100%;height:auto;display:block}.feature h2{font-size:clamp(1.5rem,3vw,2.5rem);margin:.6rem 0}.wall{grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(1rem,3vw,2rem)}.wall .wide{grid-column:span 2}figure img{border-radius:3px}figcaption{border-bottom:1px solid hsl(var(--border));padding-bottom:.8rem}@media(max-width:900px){.wall{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.feature{grid-template-columns:1fr;margin-bottom:2rem}.wall{grid-template-columns:1fr}.wall .wide{grid-column:auto}}
.album-index{margin:0 0 2rem}.album-index h2{font-size:1.2rem;margin-bottom:.8rem}.album-index div{display:flex;flex-wrap:wrap;gap:.75rem}.album-index a{border-bottom:1px solid hsl(var(--border));padding:.6rem 0;margin-right:1rem}.album-index small{margin-left:.5rem}.viewer img{touch-action:pan-y pinch-zoom}
</style>
