---
const since = '2023-05-20T13:14:00+08:00'
---
<site-status data-since={since}>
  <p><span class='status-dot' aria-hidden='true'></span><span data-runtime>建站于 2023 年 5 月 20 日</span></p>
  <button type='button' data-refresh title='重新获取最新页面，保留本地设置'>刷新页面 <span aria-hidden='true'>↻</span></button>
  <span class='sr-only' data-refresh-status role='status'></span>
</site-status>
<script>
  class SiteStatus extends HTMLElement {
    private timer?: ReturnType<typeof setInterval>
    private controller?: AbortController
    connectedCallback() {
      this.controller?.abort()
      this.controller = new AbortController()
      if (this.timer) clearInterval(this.timer)
      const runtime = this.querySelector('[data-runtime]')
      const start = Date.parse(this.dataset.since ?? '')
      const update = () => {
        if (!runtime || !Number.isFinite(start)) return
        const seconds = Math.max(0, Math.floor((Date.now() - start) / 1000))
        runtime.textContent = `本站已运行 ${Math.floor(seconds / 86400)} 天 ${Math.floor(seconds / 3600) % 24} 小时 ${Math.floor(seconds / 60) % 60} 分 ${seconds % 60} 秒`
      }
      update()
      this.timer = setInterval(update, 1000)
      const button = this.querySelector<HTMLButtonElement>('[data-refresh]')
      button?.addEventListener('click', async () => {
        button.disabled = true
        button.textContent = '正在刷新…'
        const target = new URL(location.href)
        target.searchParams.delete('qa')
        target.searchParams.set('v', String(Date.now()))
        try {
          const response = await fetch(target.href, { cache: 'reload', signal: AbortSignal.timeout(15000) })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          location.replace(target.href)
        } catch {
          button.disabled = false
          button.textContent = '刷新页面 ↻'
          const status = this.querySelector('[data-refresh-status]')
          if (status) status.textContent = '刷新失败，请检查网络后重试。'
        }
      }, { signal: this.controller.signal })
    }
    disconnectedCallback() {
      if (this.timer) clearInterval(this.timer)
      this.controller?.abort()
    }
  }
  if (!customElements.get('site-status')) customElements.define('site-status', SiteStatus)
</script>
<style>
  site-status {display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:.4rem 1.1rem;margin-top:1rem;color:hsl(var(--muted-foreground));font-size:.8rem;}
  p {display:flex;align-items:center;gap:.5rem;margin:0;line-height:1.8;}
  .status-dot {width:.4rem;height:.4rem;flex-shrink:0;border-radius:50%;background:#22a98d;}
  button {min-height:44px;padding:.4rem .7rem;border:1px solid hsl(var(--border));border-radius:.7rem;cursor:pointer;color:inherit;background:transparent;}
  button:hover {color:hsl(var(--primary));background:hsl(var(--muted)/.4);}
  button:focus-visible {outline:2px solid hsl(var(--primary));outline-offset:3px;}
  button:disabled {opacity:.65;cursor:wait;}
  @media(max-width:639px) { site-status{font-size:.75rem;gap:.35rem;} }
</style>
