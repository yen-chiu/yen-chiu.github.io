---
import type { MarkdownHeading } from 'astro'

import { generateToc } from '../../plugins/toc'
import TOCHeading from './TOCHeading.astro'

interface Props {
  headings: MarkdownHeading[]
  class?: string
  id?: string
}

const { headings, class: className, ...props } = Astro.props

const toc = generateToc(headings)
---

<toc-heading class={className} {...props}>
  <div class='flex items-center justify-between mb-0 flex-shrink-0'>
    <h2 class='font-medium'>TABLE OF CONTENTS</h2>
  </div>
  <div class='toc-content-wrapper'>
    <ul class='mt-4'>
      {toc.map((heading) => <TOCHeading heading={heading} />)}
    </ul>
  </div>
</toc-heading>

<script>
  // This script tag is useful only if you want to display the TOC alongside the blog post...
  // ... and highlight the section that the user is currently reading through.
  // Feel free to remove this tag if you don't need this type of functionality.

  interface TOCLink {
    element: HTMLAnchorElement
    progressBar: HTMLElement
    slug: string
  }

  interface HeadingProgress {
    inView: boolean
    progress: number
  }

  class TOC extends HTMLElement {
    headings: HTMLElement[] = []
    tocLinks: TOCLink[] = []
    headingProgress: Record<string, HeadingProgress> = {}
    userScrolledAt = 0
    settleNext = false
    unlockTimer = 0

    constructor() {
      super()
      // Initialize the headings and tocLinks
      this.headings = Array.from(
        document.querySelectorAll(
          'article h1, article h2, article h3, article h4, article h5, article h6'
        )
      )
      this.tocLinks = Array.from(this.querySelectorAll('a.toc-item')).map((link) => ({
        element: link as HTMLAnchorElement,
        progressBar: link.previousElementSibling as HTMLElement,
        slug: (link.getAttribute('href') || '').substring(1)
      }))
    }

    updatePositionAndStyle = () => {
      const windowHeight = window.innerHeight
      const content = document.querySelector('#content') as HTMLElement | null
      // Measure in viewport space: `offsetTop` is relative to the nearest
      // positioned ancestor, so headings nested in cards / tabs reported bogus
      // ranges and the in-view highlight broke into disconnected pills.
      const contentBottom = content ? content.getBoundingClientRect().bottom : windowHeight * 3

      this.headings.forEach((el, index) => {
        const rect = el.getBoundingClientRect()
        const nextRect = this.headings[index + 1]?.getBoundingClientRect()
        const nextTop = nextRect ? nextRect.top : contentBottom
        const start = rect.top
        const end = Math.max(start + rect.height, nextTop - rect.height)
        const progress = (windowHeight - start) / Math.max(1, end - start)

        this.headingProgress[el.id] = {
          inView: start < windowHeight && end > 0,
          progress: Math.max(0, Math.min(1, progress))
        }
      })

      this.tocLinks.forEach(({ element: el, progressBar: bar, slug }, i) => {
        if (this.headingProgress[slug]) {
          const { inView, progress } = this.headingProgress[slug]
          el.classList.toggle('highlight', inView)
          el.classList.toggle('highlight-bg-translucent', inView)
          el.classList.toggle(
            'rounded-t-2xl',
            inView && (i === 0 || !this.headingProgress[this.tocLinks[i - 1]?.slug]?.inView)
          )
          el.classList.toggle(
            'rounded-b-2xl',
            inView &&
              (i === this.tocLinks.length - 1 ||
                !this.headingProgress[this.tocLinks[i + 1]?.slug]?.inView)
          )
          bar.classList.toggle('is-read', !inView && progress === 1)
          bar.classList.toggle('highlight-bg', inView)
          bar.style.setProperty('height', `${progress * 90}%`)
        }
      })

      this.centerCurrent()
    }

    // 把「正在读的那一节」滚到目录框的中间；到头/到尾时自然贴边
    centerCurrent = () => {
      const wrapper = this.querySelector('.toc-content-wrapper') as HTMLElement | null
      if (!wrapper) return
      if (Date.now() - this.userScrolledAt < 1200) return

      const max = wrapper.scrollHeight - wrapper.clientHeight
      if (max <= 2) return

      const inView = this.tocLinks.find((link) => this.headingProgress[link.slug]?.inView)
      const passed = [...this.tocLinks]
        .reverse()
        .find((link) => (this.headingProgress[link.slug]?.progress ?? 0) >= 1)
      // 到页面顶部、第一节还没进视口时，回到列表最上面，而不是掉到最末一条
      const current = inView || passed || this.tocLinks[0]
      if (!current) return

      const rect = current.element.getBoundingClientRect()
      const wrapperRect = wrapper.getBoundingClientRect()
      const offsetWithin = rect.top - wrapperRect.top + wrapper.scrollTop
      const target = Math.max(
        0,
        Math.min(max, offsetWithin - (wrapper.clientHeight - rect.height) / 2)
      )
      if (Math.abs(wrapper.scrollTop - target) < 4) return
      const reduce = ((globalThis as any).wendellMotion?.reduce?.() ?? matchMedia('(prefers-reduced-motion: reduce)').matches)
      if (this.settleNext && !reduce) {
        // 用户手动动过目录、锁定期刚结束：平滑归位一次
        this.settleNext = false
        wrapper.scrollTo({ top: target, behavior: 'smooth' })
        return
      }
      // 跟随滚动一律即时，避免动画被下一帧打断；点击目录跳转才用平滑
      wrapper.scrollTop = target
    }

    connectedCallback() {
      // Smooth scroll for TOC links
      this.tocLinks.forEach((link) => {
        link.element.addEventListener('click', (e) => {
          e.preventDefault()
          // Push the history to add the hash at the end of the URL
          const directHeading = this.headings.find((heading) => heading.id === link.slug)
          if (directHeading) {
            // Push the history to add the hash at the end of the URL
            history.pushState(
              null,
              directHeading.textContent || '',
              link.element.getAttribute('href')
            )
            // 把焦点交给标题，键盘用户跳转后 Tab 能接着往下走
            if (!directHeading.hasAttribute('tabindex')) {
              directHeading.setAttribute('tabindex', '-1')
            }
            const reduce = ((globalThis as any).wendellMotion?.reduce?.() ?? matchMedia('(prefers-reduced-motion: reduce)').matches)
            directHeading.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' })
            directHeading.focus({ preventScroll: true })
          } else {
            console.warn(`No heading found for slug: ${link.slug}`)
          }
        })
      })

      // 滚动时按帧更新一次，避免每个 scroll 事件都算一遍布局
      let ticking = false
      const onScroll = () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          ticking = false
          this.updatePositionAndStyle()
        })
      }
      onScroll()
      window.addEventListener('scroll', onScroll, { passive: true })
      window.addEventListener('resize', onScroll, { passive: true })

      // 用户自己滚目录时，先别抢着把它拉回去
      const wrapper = this.querySelector('.toc-content-wrapper')
      if (wrapper) {
        const markUser = () => {
          this.userScrolledAt = Date.now()
          window.clearTimeout(this.unlockTimer)
          // 锁定期结束时补一次归位，用户松手后目录自己回来
          this.unlockTimer = window.setTimeout(() => {
            this.settleNext = true
            this.updatePositionAndStyle()
          }, 1250)
        }
        wrapper.addEventListener('wheel', markUser, { passive: true })
        wrapper.addEventListener('touchmove', markUser, { passive: true })
        wrapper.addEventListener('pointerdown', markUser)
      }
    }
  }

  customElements.define('toc-heading', TOC)
</script>

<style>
  toc-heading {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100vh;
  }

  toc-heading .toc-content-wrapper {
    flex: 1;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 0;
  }

  toc-heading :global(.toc-item) {
    display: flow-root;
  }

  /* Custom scrollbar for TOC content */
  toc-heading .toc-content-wrapper::-webkit-scrollbar {
    width: 5px;
  }

  toc-heading .toc-content-wrapper::-webkit-scrollbar-thumb {
    background-color: hsl(var(--muted-foreground) / 0.3);
    border-radius: 999px;
  }

  toc-heading .toc-content-wrapper {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.3) transparent;
  }
</style>
