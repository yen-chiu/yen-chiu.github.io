---
import { musicTracks } from '@/data/music'
import { sitePath } from '@/utils/site-path'
interface Props { compact?: boolean }
const { compact = false } = Astro.props
---
<vesper-music-player class:list={['vesper-music-player', compact && 'is-compact']} data-tracks={JSON.stringify(musicTracks)} aria-label='Vesper 音乐播放器'>
  <div class='music-deck'>
    <div class='music-art' aria-hidden='true'><div class='music-vinyl'><span class='music-vinyl-label'>V</span></div></div>
    <div class='music-info'>
      <span class='music-kicker'>VESPER · NIGHT RADIO</span>
      <h3 data-song-title>夜曲 Op. 9 No. 2</h3>
      <p data-song-artist>Frédéric Chopin</p>
    </div>
    <div class='music-timeline'>
      <label class='sr-only' for={compact ? 'home-music-seek' : 'music-page-seek'}>播放进度</label>
      <input id={compact ? 'home-music-seek' : 'music-page-seek'} data-seek type='range' min='0' max='1000' value='0' step='1' aria-label='播放进度' />
      <div class='music-times'><span data-current>0:00</span><span data-duration>--:--</span></div>
    </div>
    <div class='music-actions'>
      <button type='button' class='music-main-button' data-play aria-label='播放' aria-pressed='false'><span data-play-symbol aria-hidden='true'>▶</span></button>
      <label class='music-volume'><span aria-hidden='true'>♫</span><input data-volume type='range' min='0' max='1' value='0.7' step='0.05' aria-label='音量' /></label>
      {compact && <a class='music-more' href={sitePath('/music/')} aria-label='打开完整音乐页面'>完整音乐页 ↗</a>}
    </div>
    <p class='music-status' data-status aria-live='polite'>点击播放开始收听 · 不会自动播放</p>
  </div>
  {!compact && <section class='music-side' aria-label='歌词与歌单'>
    <div class='music-tabs' role='tablist' aria-label='音乐内容'>
      <button type='button' role='tab' id='music-lyrics-tab' aria-controls='music-lyrics-panel' aria-selected='true' data-tab='lyrics'>歌词</button>
      <button type='button' role='tab' id='music-list-tab' aria-controls='music-list-panel' aria-selected='false' data-tab='list'>歌单</button>
    </div>
    <div class='music-pane' role='tabpanel' id='music-lyrics-panel' aria-labelledby='music-lyrics-tab' data-panel='lyrics'>
      <div class='music-empty'><span aria-hidden='true'>♪</span><p>音乐无需言语</p><small>当前示范曲目为纯音乐，暂无逐字歌词。</small></div>
    </div>
    <div class='music-pane' role='tabpanel' id='music-list-panel' aria-labelledby='music-list-tab' data-panel='list' hidden>
      <label class='sr-only' for='music-song-search'>搜索歌单</label>
      <input id='music-song-search' class='music-search' type='search' data-search placeholder='搜索曲目或演奏者…' />
      <ol data-playlist class='music-playlist'>
        {musicTracks.map(track=><li data-track-id={track.id} data-search-text={`${track.title} ${track.artist}`.toLowerCase()}>
          <button type='button' data-select-song={track.id} class='music-track'><span class='music-track-symbol' aria-hidden='true'>♪</span><span class='music-track-name'><b>{track.title}</b><small>{track.artist}</small></span><span class='music-track-provider'>{track.provider}</span></button>
        </li>)}
      </ol>
    </div>
    <div class='music-side-note'><p>示范曲目采用不同的开放许可；具体署名与授权请查看各曲目来源。</p><ul>{musicTracks.map(track=><li><a href={track.attribution.match(/https:\/\/\S+/)?.[0] || '#'} target='_blank' rel='noopener noreferrer'>{track.title} · 来源与许可 ↗</a></li>)}</ul></div>
  </section>}
</vesper-music-player>

<script>
  import { musicEngine } from '@/utils/music-engine'
  import type { MusicTrack } from '@/utils/music-engine'
  const formatTime = (value:number) => Number.isFinite(value) ? `${Math.floor(value/60)}:${String(Math.floor(value%60)).padStart(2,'0')}` : '--:--'
  class VesperMusicPlayer extends HTMLElement {
    private controller?:AbortController
    private unsubscribe?:()=>void
    connectedCallback() {
      this.controller?.abort()
      this.unsubscribe?.()
      this.controller=new AbortController()
      const {signal}=this.controller
      let tracks:MusicTrack[]=[]
      try { tracks=JSON.parse(this.dataset.tracks || '[]') } catch {}
      musicEngine.configure(tracks)
      const play=this.querySelector<HTMLButtonElement>('[data-play]')!
      const symbol=this.querySelector<HTMLElement>('[data-play-symbol]')!
      const seek=this.querySelector<HTMLInputElement>('[data-seek]')!
      const volume=this.querySelector<HTMLInputElement>('[data-volume]')!
      const current=this.querySelector<HTMLElement>('[data-current]')!
      const duration=this.querySelector<HTMLElement>('[data-duration]')!
      const status=this.querySelector<HTMLElement>('[data-status]')!
      const title=this.querySelector<HTMLElement>('[data-song-title]')!
      const artist=this.querySelector<HTMLElement>('[data-song-artist]')!
      this.unsubscribe=musicEngine.subscribe(snapshot=>{
        const track=tracks.find(track=>track.id===snapshot.id)
        if(track){title.textContent=track.title;artist.textContent=track.artist}
        current.textContent=formatTime(snapshot.currentTime)
        duration.textContent=snapshot.duration?formatTime(snapshot.duration):'--:--'
        seek.value=String(snapshot.duration?Math.round(snapshot.currentTime/snapshot.duration*1000):0)
        volume.value=String(snapshot.volume)
        status.textContent=snapshot.status
        play.setAttribute('aria-label',snapshot.playing?'暂停':'播放')
        play.setAttribute('aria-pressed',String(snapshot.playing))
        symbol.textContent=snapshot.playing?'Ⅱ':'▶'
        this.classList.toggle('is-playing',snapshot.playing)
        this.querySelectorAll<HTMLElement>('[data-track-id]').forEach(el=>el.classList.toggle('is-active',el.dataset.trackId===snapshot.id))
      })
      play.addEventListener('click',()=>{void musicEngine.toggle()},{signal})
      seek.addEventListener('input',()=>musicEngine.seek(Number(seek.value)/1000),{signal})
      volume.addEventListener('input',()=>musicEngine.setVolume(Number(volume.value)),{signal})
      this.querySelectorAll<HTMLButtonElement>('[data-select-song]').forEach(button=>button.addEventListener('click',()=>musicEngine.select(button.dataset.selectSong||''),{signal}))
      const search=this.querySelector<HTMLInputElement>('[data-search]')
      search?.addEventListener('input',()=>{const q=search.value.trim().toLowerCase();this.querySelectorAll<HTMLElement>('[data-search-text]').forEach(row=>{row.hidden=!(row.dataset.searchText||'').includes(q)})},{signal})
      const tabs=[...this.querySelectorAll<HTMLButtonElement>('[data-tab]')]
      tabs.forEach(tab=>tab.addEventListener('click',()=>{for(const button of tabs)button.setAttribute('aria-selected',String(button===tab));this.querySelectorAll<HTMLElement>('[data-panel]').forEach(panel=>{panel.hidden=panel.dataset.panel!==tab.dataset.tab})},{signal}))
    }
    disconnectedCallback(){this.controller?.abort();this.unsubscribe?.()}
  }
  if(!customElements.get('vesper-music-player'))customElements.define('vesper-music-player',VesperMusicPlayer)
</script>

<style>
  .vesper-music-player{--music-accent:hsl(var(--primary));display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:1.25rem;color:hsl(var(--foreground))}
  .music-deck,.music-side{min-width:0;min-height:430px;border:1px solid hsl(var(--border)/.7);border-radius:1.5rem;background:hsl(var(--background)/.76);box-shadow:0 12px 36px hsl(var(--foreground)/.055);padding:clamp(1rem,3vw,2rem)}
  .music-deck{display:flex;align-items:center;flex-direction:column;justify-content:center;text-align:center}
  .music-art{width:clamp(150px,20vw,240px);aspect-ratio:1;display:grid;place-items:center;margin:1rem auto 1.3rem;border-radius:50%;background:radial-gradient(circle at 55% 38%,hsl(var(--primary)/.28),transparent 60%);filter:drop-shadow(0 12px 22px hsl(var(--primary)/.18))}
  .music-vinyl{width:90%;aspect-ratio:1;display:grid;place-items:center;border-radius:50%;background:repeating-radial-gradient(circle at center,transparent 0 3px,#ffffff0c 4px 5px,transparent 6px 9px),conic-gradient(from 30deg,#192238,#384865,#11192d,#536178,#172036,#192238);box-shadow:0 12px 26px #0004;animation:music-spin 24s linear infinite;animation-play-state:paused}
  .is-playing .music-vinyl{animation-play-state:running}
  .music-vinyl-label{display:grid;place-items:center;width:28%;aspect-ratio:1;border-radius:50%;background:linear-gradient(130deg,#bdcfe0,#e4e9ee);color:#24324c;font-family:Georgia,serif;font-size:2rem}
  .music-info{min-height:5rem}.music-kicker{font-size:.63rem;letter-spacing:.17em;color:hsl(var(--muted-foreground))}.music-info h3{font-size:clamp(1.08rem,2.5vw,1.4rem);margin:.65rem 0 .2rem}.music-info p{font-size:.78rem;color:hsl(var(--muted-foreground));line-height:1.65}
  .music-timeline{width:100%;max-width:28rem;margin:1.35rem 0 .8rem}.music-timeline input{width:100%;accent-color:var(--music-accent);cursor:pointer}.music-times{display:flex;justify-content:space-between;color:hsl(var(--muted-foreground));font-size:.72rem;font-variant-numeric:tabular-nums}
  .music-actions{width:100%;display:flex;align-items:center;justify-content:center;gap:1.25rem;flex-wrap:wrap}.music-main-button{border:0;background:var(--music-accent);color:hsl(var(--primary-foreground));width:3.4rem;height:3.4rem;min-width:48px;min-height:48px;border-radius:50%;cursor:pointer;box-shadow:0 5px 18px hsl(var(--primary)/.25);font-size:1.2rem}.music-volume{display:flex;align-items:center;gap:.4rem;font-size:.9rem;color:hsl(var(--muted-foreground))}.music-volume input{width:5rem;accent-color:var(--music-accent)}
  .music-status{min-height:1.4rem;margin:.9rem 0 0;font-size:.71rem;color:hsl(var(--muted-foreground));line-height:1.5}
  .music-side{display:flex;flex-direction:column}.music-tabs{align-self:center;background:hsl(var(--muted)/.55);border-radius:999px;padding:.25rem;display:flex;gap:.25rem}.music-tabs button{border:0;background:transparent;padding:.55rem 1.7rem;border-radius:999px;color:inherit;cursor:pointer;min-height:40px;font-size:.85rem}.music-tabs button[aria-selected='true']{background:var(--music-accent);color:hsl(var(--primary-foreground))}.music-pane{flex:1;min-height:0;overflow:auto;padding:1.5rem .2rem}.music-pane[hidden]{display:none}.music-empty{min-height:250px;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:.7rem;text-align:center}.music-empty>span{font-size:2.5rem;color:var(--music-accent)}.music-empty p{font-size:1.1rem}.music-empty small{font-size:.78rem;color:hsl(var(--muted-foreground))}.music-side-note{border-top:1px solid hsl(var(--border)/.7);padding-top:1rem;font-size:.7rem;line-height:1.6;color:hsl(var(--muted-foreground))}.music-side-note a{text-decoration:underline;text-underline-offset:3px}
  .music-search{width:100%;padding:.7rem 1rem;border:1px solid hsl(var(--border));border-radius:999px;background:hsl(var(--background));color:inherit;font-size:.85rem}.music-playlist{list-style:none;margin:.75rem 0 0;padding:0}.music-playlist li[hidden]{display:none}.music-track{width:100%;display:flex;align-items:center;text-align:left;gap:.8rem;background:transparent;border:0;border-radius:.8rem;padding:.7rem;cursor:pointer;color:inherit}.music-track:hover,.is-active .music-track{background:hsl(var(--primary)/.08)}.music-track-symbol{display:grid;place-items:center;width:2.5rem;height:2.5rem;border-radius:.65rem;background:hsl(var(--primary)/.15);color:var(--music-accent)}.music-track-name{display:grid;flex:1;min-width:0;gap:.2rem}.music-track-name b{font-size:.85rem}.music-track-name small,.music-track-provider{font-size:.68rem;color:hsl(var(--muted-foreground))}.music-track-provider{white-space:nowrap}
  .is-compact{display:block;max-width:100%}.is-compact .music-deck{min-height:0;display:grid;grid-template-columns:4rem minmax(0,1fr);align-items:center;text-align:left;gap:.65rem 1rem;padding:1rem 1.2rem}.is-compact .music-art{grid-row:span 2;width:4rem;margin:0;filter:none}.is-compact .music-info{min-height:0}.is-compact .music-info h3{font-size:1rem;margin:.25rem 0}.is-compact .music-kicker{font-size:.6rem}.is-compact .music-info p{font-size:.7rem}.is-compact .music-timeline{grid-column:1/-1;max-width:none;margin:.15rem 0 0}.is-compact .music-actions{grid-column:1/-1;justify-content:flex-start;gap:1rem}.is-compact .music-main-button{width:2.75rem;height:2.75rem;font-size:1rem}.is-compact .music-status{grid-column:1/-1;margin:0}.music-more{margin-left:auto;font-size:.77rem;color:var(--music-accent);text-decoration:underline;text-underline-offset:3px}
  @keyframes music-spin{to{transform:rotate(360deg)}}
  @media(max-width:680px){.vesper-music-player:not(.is-compact){grid-template-columns:1fr}.music-deck,.music-side{min-height:0}.music-side{min-height:300px}.music-art{width:clamp(150px,44vw,210px)}.music-pane{min-height:200px}.music-side-note{margin-top:0}}
  @media(prefers-reduced-motion:reduce){.music-vinyl{animation:none!important}}
  :global(html.motion-off) .music-vinyl,:global(html[data-effect-quality='low']) .music-vinyl,:global(html[data-effect-quality='static']) .music-vinyl{animation:none!important}
  :global(html[data-effects-paused='true']) .music-vinyl{animation-play-state:paused!important}
  button:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid var(--music-accent);outline-offset:3px}
</style>
