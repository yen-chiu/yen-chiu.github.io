---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import InteractiveAvatar from '@/components/InteractiveAvatar.astro'
import { getPostPath, getPostSlug } from '@/utils/content-paths'
import { sitePath } from '@/utils/site-path'
import avatar from '@/assets/avatar.png'

const posts = (await getCollection('blog')).filter((p) => !p.data.draft)
const selections = [
  { slug: 'qq-bot-postmortem', label: '从一次失败开始', reason: '三次碰壁之后，写下 QQ 接入 AI 助手的排查过程与取舍。' },
  { slug: 'xss-audit', label: '看一次真正的修复', reason: '审查自己的写作台，跟着一个 XSS 漏洞走完发现与修复。' },
  { slug: 'miko-web', label: '认识一个作品', reason: '从旧游戏的逆向分析，到异次元通讯网页版的重建故事。' }
]
const featuredPosts = selections.map(selection => {
  const post = posts.find(post => getPostSlug(post) === selection.slug)
  if (!post) throw new Error(`Missing curated article: ${selection.slug}`)
  return { ...selection, post }
})
const entries = [
  { title: '博客', desc: '技术实践与生活记录', path: '/blog', symbol: '✎' },
  { title: '时光机', desc: '在日历里回看写作', path: '/archives', symbol: '◷' },
  { title: '念真', desc: '一个一直在生长的故事', path: '/persona', symbol: '☾' },
  { title: '链接', desc: '常去的地方与网络邻居', path: '/links', symbol: '↗' }
]
---

<BaseLayout
  pageKind='home'
  meta={{ title: 'Wendell', description: '读书，买花，长大。Wendell 的个人博客。' }}
>
  <main class='home-page'>
    <landing-hero class='landing-track'>
      <section class='home-cover' aria-label='首页封面'>
        <img
          class='cover-image'
          src={sitePath('/images/moonlit-cover.svg')}
          alt=''
          width='1600'
          height='700'
          fetchpriority='high'
        />
        <div class='cover-shade'></div><div class='star-field' aria-hidden='true'></div>
        <div class='hero-intro'>
          <InteractiveAvatar
            ><Image
              id='home-avatar'
              src={avatar}
              alt='Wendell 的头像'
              width={128}
              height={128}
              loading='eager'
            /></InteractiveAvatar
          >
          <p class='eyebrow'>代码 · 阅读 · 生活</p>
          <h1>
            <button
              class='glitch-name'
              type='button'
              data-text='Wendell'
              aria-label='Wendell，触发名字动画'>Wendell</button
            >
          </h1>
          <p class='tagline'>读书，买花，长大。</p>
          <nav class='cover-actions' aria-label='首页入口'>
            <a class='primary-reading' href={sitePath('/blog')}>进入博客 ↗</a><a href={sitePath('/about')}>关于我</a><a
              href='https://github.com/yen-chiu'
              target='_blank'
              rel='noopener noreferrer'>GitHub ↗</a
            >
          </nav>
        </div>
        <button type='button' class='scroll-hint' data-collapse aria-describedby='scroll-hint-hint'
          ><span>向下探索</span><b aria-hidden='true'>⌄</b></button
        ><span class='sr-only' id='scroll-hint-hint'>收起全屏封面，进入正文</span>
        <a
          class='cover-credit'
          href='https://github.com/yen-chiu/yen-chiu.github.io/blob/main/public/images/moonlit-cover.svg'
          target='_blank'
          rel='noopener noreferrer'
          ><span class='cover-credit-icon' aria-hidden='true'>ⓘ</span><span class='cover-credit-label'>星夜 · 本站矢量封面</span><span class='cover-credit-arrow' aria-hidden='true'>↗</span></a
        >
        <div class='cover-wave' aria-hidden='true'></div>
      </section>
    </landing-hero>
    <section class='home-doorway' id='home-entries' aria-labelledby='doorway-title'>
      <header>
        <div>
          <p class='section-kicker'>WELCOME TO MY CORNER</p><h2 id='doorway-title'>
            你好，路过的朋友。
          </h2><p>第一次来，可以先读这三篇。这里有折腾的过程，也有做成的作品。</p>
        </div><a href='#' class='expand-cover'>展开封面 ↑</a>
      </header>
      <section class='reading-guide' aria-labelledby='reading-guide-title'>
        <h3 id='reading-guide-title' class='guide-heading'>精选导读</h3>
        <div class='guide-grid'>
          {featuredPosts.map(({ label, reason, post }, index) => (
            <article class='guide-card'>
              <span class='guide-label'><b aria-hidden='true'>0{index + 1}</b>{label}</span>
              <h4><a href={sitePath(getPostPath(post))}>{post.data.title}</a></h4>
              <p>{reason}</p>
              <a class='guide-read' href={sitePath(getPostPath(post))} aria-label={`开始阅读：${post.data.title}`}>开始阅读 <span aria-hidden='true'>↗</span></a>
            </article>
          ))}
        </div>
      </section>
      <nav class='entry-grid'  aria-label='探索本站'>
        {
          entries.map((e) => (
            <a href={sitePath(e.path)}>
              <>
                <span class='entry-symbol' aria-hidden='true'>
                  {e.symbol}
                </span>
                <strong>{e.title}</strong>
                <p>{e.desc}</p>
                <span class='entry-arrow' aria-hidden='true'>
                  ↗
                </span>
              </>
            </a>
          ))
        }
      </nav>
      <p class='home-note'>
        从 2023 年开始记录，已留下 <a href={sitePath('/blog')}>{posts.length} 篇文章</a>。<a
          href={sitePath('/rss.xml')}>订阅 RSS ↗</a
        >
      </p>
    </section>
  </main>
</BaseLayout>
<script>
  import { fadeProgress, springStep } from '@/utils/hero-motion'

  class LandingHero extends HTMLElement {
    private controller?: AbortController
    private frame = 0
    private viewportObserver?: ResizeObserver
    connectedCallback() {
      this.controller?.abort()
      this.viewportObserver?.disconnect()
      this.controller = new AbortController()
      const { signal } = this.controller,
        cover = this.querySelector<HTMLElement>('.home-cover')!,
        intro = this.querySelector<HTMLElement>('.hero-intro')!,
        credit = this.querySelector<HTMLElement>('.cover-credit')!
      const reduced = matchMedia('(prefers-reduced-motion: reduce)')
      const motionReduced = () => (globalThis as any).wendellMotion?.reduce?.() ?? reduced.matches
      const layers = [
        {
          element: intro.querySelector<HTMLElement>('interactive-avatar'),
          start: 0.02,
          end: 0.78,
          travel: 48,
          scale: 0.24
        },
        {
          element: intro.querySelector<HTMLElement>('.eyebrow'),
          start: 0.07,
          end: 0.8,
          travel: 37,
          scale: 0.12
        },
        {
          element: intro.querySelector<HTMLElement>('h1'),
          start: 0.11,
          end: 0.86,
          travel: 31,
          scale: 0.13
        },
        {
          element: intro.querySelector<HTMLElement>('.tagline'),
          start: 0.16,
          end: 0.9,
          travel: 24,
          scale: 0.09
        },
        {
          element: intro.querySelector<HTMLElement>('.cover-actions'),
          start: 0.22,
          end: 0.95,
          travel: 17,
          scale: 0.06
        }
      ]
      const hint = this.querySelector<HTMLElement>('[data-collapse]')!
      const measure = () => {
        const height = this.offsetHeight,
          compact = Math.min(340, innerHeight * 0.42)
        /* 封面被 margin-top:-90px 拉到页面顶上方，rect.top 一开局就是负数；
           直接拿 -top 当进度会让首屏就先收起十几像素。以文档内起点（不小于 0）为基准，
           保证 scrollY=0 时进度正好是 0，封面完整铺满。 */
        const docTop = this.getBoundingClientRect().top + window.scrollY
        const start = Math.max(0, docTop)
        const target = Math.max(
          0,
          Math.min(1, (window.scrollY - start) / Math.max(1, height - compact))
        )
        cover.style.height = `${height - (height - compact) * target}px`
        return target
      }
      let target = measure(),
        spring = { position: target, velocity: 0 },
        lastTime = 0
      const paint = () => {
        const value = spring.position,
          p = Math.max(0, Math.min(1, value))
        let visible = false
        for (const layer of layers) {
          const element = layer.element
          if (!element) continue
          const opacity = 1 - fadeProgress(p, layer.start, layer.end)
          const rebound = Math.max(-0.025, Math.min(0.035, -spring.velocity * 0.012))
          element.style.opacity = String(opacity)
          element.style.transform = motionReduced()
            ? ''
            : `translate3d(0,${-value * layer.travel}px,0) scale(${1 - value * layer.scale + rebound})`
          element.style.visibility = opacity < 0.001 ? 'hidden' : 'visible'
          element.inert = opacity < 0.02
          if (opacity >= 0.001) visible = true
        }
        intro.style.transform = motionReduced()
          ? ''
          : `translate3d(0,${-value * 9}px,0) scale(${1 - value * 0.08})`
        intro.style.visibility = visible ? 'visible' : 'hidden'
        intro.inert = !visible
        const caption = fadeProgress(p, 0.35, 0.8)
        credit.classList.toggle('is-visible', caption > 0.001)
        credit.style.opacity = String(caption)
        credit.style.transform = motionReduced() ? '' : `translateY(${(1 - caption) * 6}px)`
        const hintOpacity = 1 - fadeProgress(p, 0, 0.35)
        hint.style.opacity = String(hintOpacity)
        hint.style.visibility = hintOpacity < 0.001 ? 'hidden' : 'visible'
        hint.inert = hintOpacity < 0.02
        this.classList.toggle('is-collapsed', p > 0.98)
      }
      const tick = (time: number) => {
        target = measure()
        const dt = lastTime ? (time - lastTime) / 1000 : 1 / 60
        lastTime = time
        spring = motionReduced()
          ? { position: target, velocity: 0 }
          : springStep(spring, target, dt)
        const settled =
          Math.abs(target - spring.position) < 0.0003 && Math.abs(spring.velocity) < 0.003
        if (settled) spring = { position: target, velocity: 0 }
        paint()
        if (settled) {
          this.frame = 0
          lastTime = 0
        } else this.frame = requestAnimationFrame(tick)
      }
      const schedule = () => {
        if (!this.frame) this.frame = requestAnimationFrame(tick)
      }
      const resize = () => {
        this.style.setProperty('--viewport-width', `${document.documentElement.clientWidth}px`)
        schedule()
      }
      this.viewportObserver = new ResizeObserver(resize)
      this.viewportObserver.observe(document.documentElement)
      window.addEventListener('scroll', schedule, { passive: true, signal })
      window.addEventListener('resize', resize, { signal })
      window.addEventListener('wendell:appearance', schedule, { signal })
      reduced.addEventListener(
        'change',
        () => {
          spring.velocity = 0
          schedule()
        },
        { signal }
      )
      document.addEventListener(
        'visibilitychange',
        () => {
          if (document.hidden) {
            cancelAnimationFrame(this.frame)
            this.frame = 0
            lastTime = 0
          } else {
            target = measure()
            spring = { position: target, velocity: 0 }
            paint()
          }
        },
        { signal }
      )
      resize()
      paint()
      this.querySelector('[data-collapse]')?.addEventListener(
        'click',
        () => {
          const compact = Math.min(340, innerHeight * 0.42)
          window.scrollTo({
            top: window.scrollY + this.getBoundingClientRect().top + this.offsetHeight - compact,
            behavior: motionReduced() ? 'instant' : 'smooth'
          })
        },
        { signal }
      )
      const name = this.querySelector<HTMLButtonElement>('.glitch-name')!
      name.addEventListener(
        'click',
        () => {
          name.classList.remove('is-glitching')
          void name.offsetWidth
          name.classList.add('is-glitching')
          this.querySelector<HTMLButtonElement>('interactive-avatar button')?.click()
        },
        { signal }
      )
      name.addEventListener('animationend', (event) => {
        if (!(event as AnimationEvent).pseudoElement) name.classList.remove('is-glitching')
      }, { signal })
    }
    disconnectedCallback() {
      this.viewportObserver?.disconnect()
      this.controller?.abort()
      cancelAnimationFrame(this.frame)
    }
  }
  if (!customElements.get('landing-hero')) customElements.define('landing-hero', LandingHero)
</script>
<style>
  .home-page {
    margin-top: -90px;
  }
  .landing-track {
    overflow-anchor: none;
    display: block;
    height: 100vh; /* Chrome 99: fallback before small viewport units. */
    height: 100svh;
    position: relative;
    width: var(--viewport-width, 100%);
    margin-left: calc(50% - var(--viewport-width, 100%) / 2);
  }
  .home-cover {
    position: sticky;
    top: 0;
    height: 100vh; /* Chrome 99: fallback before small viewport units. */
    height: 100svh;
    min-height: 230px;
    isolation: isolate;
    overflow: hidden;
    background: #1e2948;
    color: white;
    display: grid;
    place-items: center;
  }
  .cover-image,
  .cover-shade,
  .star-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  .cover-image {
    object-position: 65% center;
  }
  .cover-shade {
    background: linear-gradient(180deg, #10172f44, #10172f33 30%, #10172fbb);
  }
  .star-field {
    background-image:
      radial-gradient(1px 1px at 15% 30%, #fff, transparent),
      radial-gradient(2px 2px at 78% 25%, #fff8, transparent),
      radial-gradient(1px 1px at 60% 55%, #fff, transparent);
    background-size: 370px 310px;
    pointer-events: none;
  }
  .hero-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6rem 1rem 5rem;
    will-change: opacity;
  }
  .hero-intro :global(img) {
    width: 112px;
    height: 112px;
    border: 3px solid #ffffffaa;
    box-shadow: 0 15px 55px #10172f70;
  }
  .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    margin: 1.7rem 0 0.6rem;
    opacity: 0.8;
  }
  h1 {
    margin: 0;
    line-height: 1.15;
  }
  .glitch-name {
    position: relative;
    font-size: clamp(3rem, 8vw, 5.7rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    color: inherit;
    border: 0;
    background: transparent;
    padding: 0.1rem 0.2rem;
    cursor: pointer;
  }
  .glitch-name::before,
  .glitch-name::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    padding: inherit;
    opacity: 0;
    pointer-events: none;
  }
  .glitch-name::before {
    color: #8ce9ff;
    clip-path: inset(18% 0 53% 0);
  }
  .glitch-name::after {
    color: #eab0ff;
    clip-path: inset(63% 0 12% 0);
  }
  .tagline {
    font-size: 1rem;
    letter-spacing: 0.18em;
    margin: 1rem 0 1.8rem;
    color: #ffffffe0;
  }
  .cover-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .cover-actions a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 1rem;
    font-size: 0.8rem;
    color: white;
    background: #ffffff12;
    border: 1px solid #ffffff55;
    border-radius: 2rem;
    backdrop-filter: blur(12px);
  }
  .cover-actions .primary-reading {
    color: #172338;
    background: #f1f5ff;
    border-color: #f1f5ff;
    font-weight: 650;
  }
  .cover-actions .primary-reading:hover { background: #fff; }
  .cover-actions a:hover {
    background: #ffffff30;
  }
  .scroll-hint {
    position: absolute;
    bottom: 2.2rem;
    left: 50%;
    transform: translateX(-50%);
    border: 0;
    background: transparent;
    color: white;
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    min-height: 44px;
    padding: 0.5rem 1rem;
    cursor: pointer;
  }
  .scroll-hint b {
    font-size: 1.7rem;
    line-height: 1;
  }
  .is-collapsed .scroll-hint {
    display: none;
  }
  .cover-credit {
    position: absolute;
    right: max(1.1rem, calc((100vw - 67rem) / 2));
    bottom: 1.4rem;
    background: #080e1bbd;
    backdrop-filter: blur(10px);
    border: 1px solid #ffffff22;
    border-radius: 2rem;
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    font-size: 0.68rem;
    color: #ffffffe0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s;
  }
  .cover-credit-icon, .cover-credit-arrow {
    flex-shrink: 0;
    line-height: 1;
  }
  .cover-credit-arrow { margin-left: -0.125rem; }
  .cover-credit.is-visible {
    opacity: 1;
    visibility: visible;
  }
  .cover-wave {
    display: none;
    position: absolute;
    bottom: -1px;
    left: -10%;
    width: 120%;
    height: 1.4rem;
    background: hsl(var(--background));
    clip-path: ellipse(60% 70% at 50% 100%);
  }
  :global(html[data-banner-waves='true']) .cover-wave {
    display: block;
  }
  :global(html[data-banner-title='false']) :is(h1, .eyebrow, .tagline) {
    visibility: hidden;
  }
  :global(html[data-home-cover='false']) :is(.cover-image, .star-field) {
    display: none;
  }
  :global(html[data-home-cover='false']) .cover-credit {
    display: none;
  }
  .home-doorway {
    padding: 3rem 0 1.5rem;
    max-width: 64rem;
    margin: auto;
    scroll-margin-top: calc(min(42vh, 340px) + 1rem);
    scroll-margin-top: calc(min(42svh, 340px) + 1rem);
  }
  .home-doorway header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }
  .section-kicker {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: hsl(var(--primary));
    margin: 0 0 0.5rem;
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 650;
  }
  .home-doorway header p:not(.section-kicker) {
    font-size: 0.83rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
    margin: 0.6rem 0 1.5rem;
  }
  .expand-cover {
    font-size: 0.7rem;
    white-space: nowrap;
    color: hsl(var(--primary));
    min-height: 44px;
    display: flex;
    align-items: center;
  }
  .reading-guide { margin: 0 0 2rem; }
  .guide-heading { font-size: .85rem; font-weight: 600; margin-bottom: .85rem; color: hsl(var(--muted-foreground)); }
  .guide-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; }
  .guide-card { display: flex; flex-direction: column; min-width: 0; padding: 1.3rem; border: 1px solid hsl(var(--border)); border-radius: 1.1rem; background: hsl(var(--background)/.92); }
  .guide-label { display:flex; align-items:center; gap:.6rem; color:hsl(var(--primary)); font-size:.7rem; }
  .guide-label b { font-size:.85rem; font-variant-numeric:tabular-nums; }
  .guide-card h4 { font-size: 1rem; line-height:1.65; font-weight:600; margin:.85rem 0 .6rem; overflow-wrap:anywhere; }
  .guide-card h4 a:hover { color:hsl(var(--primary)); }
  .guide-card p { font-size:.78rem; line-height:1.8; color:hsl(var(--muted-foreground)); margin:0 0 1rem; }
  .guide-read { display:flex; align-items:center; gap:.5rem; min-height:44px; margin-top:auto; font-size:.75rem; font-weight:600; color:hsl(var(--primary)); }
  .entry-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .entry-grid a {
    position: relative;
    padding: 1.5rem 1.1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 1.15rem;
    background: hsl(var(--background) / 0.9);
  }
  .entry-symbol {
    display: block;
    font-size: 1.6rem;
    color: hsl(var(--primary));
    margin-bottom: 1rem;
  }
  .entry-grid strong {
    font-size: 1rem;
    font-weight: 600;
  }
  .entry-grid p {
    font-size: 0.72rem;
    line-height: 1.7;
    margin: 0.5rem 0 0;
    color: hsl(var(--muted-foreground));
  }
  .entry-arrow {
    position: absolute;
    right: 1.1rem;
    top: 1.5rem;
    color: hsl(var(--primary));
  }
  .entry-grid a:hover {
    border-color: hsl(var(--primary) / 0.5);
    background: hsl(var(--primary) / 0.04);
  }
  .home-note {
    margin: 1.5rem 0 0;
    font-size: 0.72rem;
    line-height: 1.8;
    color: hsl(var(--muted-foreground));
  }
  .home-note a {
    color: hsl(var(--primary));
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }
  :is(a, button):focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 4px;
  }
  @media (max-width: 640px) {
    .home-page {
      margin-top: -78px;
    }
    .hero-intro :global(img) {
      width: 100px;
      height: 100px;
    }
    .guide-grid { grid-template-columns: 1fr; gap:.75rem; }
    .guide-card { padding:1.1rem; }
    .guide-card h4 { margin-top:.6rem; }
    .guide-card p { margin-bottom:.4rem; }
    .entry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.7rem;
    }
    .home-doorway {
      padding-top: 1.7rem;
    }
    h2 {
      font-size: 1.25rem;
    }
    .home-doorway header {
      align-items: start;
    }
    .home-doorway header p:not(.section-kicker) {
      font-size: 0.75rem;
    }
    .entry-grid a {
      padding: 1.1rem;
    }
    .cover-credit {
      right: 1rem;
      font-size: 0.6rem;
    }
    .tagline {
      font-size: 0.88rem;
