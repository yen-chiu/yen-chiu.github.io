---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'

import BaseLayout from '@/layouts/BaseLayout.astro'
import InteractiveAvatar from '@/components/InteractiveAvatar.astro'
import { getPostPath, getPostSlug } from '@/utils/content-paths'
import { sitePath } from '@/utils/site-path'
import avatar from '@/assets/avatar.png'

const posts = (await getCollection('blog')).filter((p) => !p.data.draft)
const selections = [
  { slug: 'qq-bot-postmortem', label: '从一次失败开始', reason: '三次碰壁之后，写下 QQ 接入 AI 助手的排查过程与取舍。' },
  { slug: 'xss-audit', label: '看一次真正的修复', reason: '审查自己的写作台，跟着一个 XSS 漏洞走完发现与修复。' },
  { slug: 'miko-web', label: '旧游戏的新入口', reason: '拆开《异次元通讯》的剧情文件，再把它做成浏览器能玩的版本。' }
]
const featuredPosts = selections.map(selection => {
  const post = posts.find(post => getPostSlug(post) === selection.slug)
  if (!post) throw new Error(`Missing curated article: ${selection.slug}`)
  return { ...selection, post }
})
const entries = [
  { title: 'Vesper · 博客', desc: '技术实践与生活记录', path: '/blog', symbol: '✎' },
  { title: 'Folio · 文档库', desc: '笔记、工具与知识归档', path: 'https://yenchiu.com/folio/', symbol: '▤' },
  { title: 'Echora · 聊天', desc: '念真与互动故事的独立空间', path: 'https://yenchiu.com/echora/', symbol: '☾' },
  { title: '时光机', desc: '在日历里回看写作', path: '/archives', symbol: '◷' },
  { title: '念真', desc: '认识 Echora 中的对话角色', path: '/persona', symbol: '✧' },
  { title: '链接', desc: '常去的地方与网络邻居', path: '/links', symbol: '↗' }
]
---

<BaseLayout
  pageKind='home'
  meta={{ title: 'YenChiu', description: 'YenChiu · Wendell 的个人网站，以 Vesper 写作，Folio 整理，Echora 交流。' }}
>
  <main class='home-page'>
    <landing-hero class='landing-track'>
      <div class='opening-motto' aria-hidden='true' inert>
        <canvas class='opening-ink' aria-hidden='true'></canvas>
        <div class='opening-vignette' aria-hidden='true'></div>
        <div class='opening-copy'>
          <span class='opening-label'>VESPER · INK IN MOTION</span>
          <p>未写尽，亦未定论。</p>
          <span class='opening-rule'></span>
        </div>
        <button class='opening-skip' type='button' aria-label='跳过开场动画'>跳过 <span aria-hidden='true'>↗</span></button>
      </div>

      <section class='home-cover' aria-label='首页封面'>
        <div class='cover-image' aria-hidden='true'></div>
        <div class='cover-shade'></div><div class='star-field' aria-hidden='true'></div>
        <div class='hero-intro'>
          <InteractiveAvatar
            ><Image
              id='home-avatar'
              src={avatar}
              alt='Wendell 的头像'
              width={128}
              height={128}
              loading='eager'
            /></InteractiveAvatar
          >
          <p class='eyebrow'>代码 · 阅读 · 生活</p>
          <h1>
            <button
              class='glitch-name'
              type='button'
              data-text='Wendell'
              aria-label='Wendell，触发名字动画'>Wendell</button
            >
          </h1>
          <p class='tagline'>读书，买花，长大。</p>
          <nav class='cover-actions' aria-label='首页入口'>
            <a class='primary-reading' href={sitePath('/blog')}>进入博客 ↗</a><a href={sitePath('/about')}>关于我</a><a
              href='https://github.com/yen-chiu'
              target='_blank'
              rel='noopener noreferrer'>GitHub ↗</a
            >
          </nav>
        </div>
        <button type='button' class='scroll-hint' data-collapse aria-describedby='scroll-hint-hint'
          ><span>往下看看</span><b aria-hidden='true'>⌄</b></button
        ><span class='sr-only' id='scroll-hint-hint'>收起全屏封面，进入正文</span>
        <a
          class='cover-credit'
          href='https://github.com/yen-chiu/yen-chiu.github.io/blob/main/public/images/moonlit-cover.svg'
          target='_blank'
          rel='noopener noreferrer'
          ><span class='cover-credit-icon' aria-hidden='true'>ⓘ</span><span class='cover-credit-label'>星夜 · 本站矢量封面</span><span class='cover-credit-arrow' aria-hidden='true'>↗</span></a
        >
        <div class='cover-wave' aria-hidden='true'></div>
      </section>
    </landing-hero>
    <section class='home-doorway' id='home-entries' aria-labelledby='doorway-title'>
      <header>
        <div>
          <p class='section-kicker'>WELCOME TO MY CORNER</p><h2 id='doorway-title'>
            你好，路过的朋友。
          </h2><p>第一次来？不妨先从这三篇读起：有失败记录，也有最后做出来的东西。</p>
        </div><a href='#' class='expand-cover'>展开封面 ↑</a>
      </header>
      <section class='reading-guide' aria-labelledby='reading-guide-title'>
        <h3 id='reading-guide-title' class='guide-heading'>精选导读</h3>
        <div class='guide-grid'>
          {featuredPosts.map(({ label, reason, post }, index) => (
            <article class='guide-card'>
              <span class='guide-label'><b aria-hidden='true'>0{index + 1}</b>{label}</span>
              <h4><a href={sitePath(getPostPath(post))}>{post.data.title}</a></h4>
              <p>{reason}</p>
              <a class='guide-read' href={sitePath(getPostPath(post))} aria-label={`开始阅读：${post.data.title}`}>开始阅读 <span aria-hidden='true'>↗</span></a>
            </article>
          ))}
        </div>
      </section>
      <nav class='entry-grid'  aria-label='探索本站'>
        {
          entries.map((e) => (
            <a href={sitePath(e.path)}>
              <>
                <span class='entry-symbol' aria-hidden='true'>
                  {e.symbol}
                </span>
                <strong>{e.title}</strong>
                <p>{e.desc}</p>
                <span class='entry-arrow' aria-hidden='true'>
                  ↗
                </span>
              </>
            </a>
          ))
        }
      </nav>
      <p class='home-note'>
        从 2023 年开始记录，已留下 <a href={sitePath('/blog')}>{posts.length} 篇文章</a>。<a
          href={sitePath('/rss.xml')}>订阅 RSS ↗</a
        >
      </p>
    </section>
  </main>
</BaseLayout>
<script>
  import { fadeProgress, springStep } from '@/utils/hero-motion'

  class LandingHero extends HTMLElement {
    private controller?: AbortController
    private frame = 0
    private viewportObserver?: ResizeObserver
    connectedCallback() {
      this.controller?.abort()
      this.viewportObserver?.disconnect()
      this.controller = new AbortController()
      const { signal } = this.controller,
        cover = this.querySelector<HTMLElement>('.home-cover')!,
        intro = this.querySelector<HTMLElement>('.hero-intro')!,
        credit = this.querySelector<HTMLAnchorElement>('.cover-credit')!
      const syncCoverCredit = () => {
        const appearance = window.wendellAppearance?.get()
        const chosen = appearance?.homeWallpaperSource === 'inherit' || !appearance?.homeWallpaperSource
          ? appearance?.wallpaperSource : appearance.homeWallpaperSource
        const source = chosen || '/images/moonlit-cover.svg'
        const label = credit.querySelector<HTMLElement>('.cover-credit-label')
        const arrow = credit.querySelector<HTMLElement>('.cover-credit-arrow')
        const presets: Record<string, string> = {
          '/images/moonlit-cover.svg': '星夜',
          '/images/wallpapers/aurora-ridge.svg': '极光',
          '/images/wallpapers/silver-mist.svg': '晨雾',
          '/images/wallpapers/rose-twilight.svg': '晚霞'
        }
        if (source === 'uploaded' || source === 'home-uploaded') {
          credit.removeAttribute('href')
          credit.removeAttribute('target')
          credit.removeAttribute('rel')
          if (label) label.textContent = '我的壁纸 · 保存在此浏览器'
          if (arrow) arrow.hidden = true
        } else {
          credit.href = source.startsWith('https://')
            ? source
            : 'https://github.com/yen-chiu/yen-chiu.github.io/blob/main/public' + source
          credit.target = '_blank'
          credit.rel = 'noopener noreferrer'
          if (label) label.textContent = presets[source]
            ? presets[source] + ' · 本站矢量壁纸' : '自定义壁纸 · 外部图片'
          if (arrow) arrow.hidden = false
        }
      }
      const reduced = matchMedia('(prefers-reduced-motion: reduce)')
      const motionReduced = () => (globalThis as any).wendellMotion?.reduce?.() ?? reduced.matches
      const layers = [
        {
          element: intro.querySelector<HTMLElement>('interactive-avatar'),
          start: 0.02,
          end: 0.78,
          travel: 48,
          scale: 0.24
        },
        {
          element: intro.querySelector<HTMLElement>('.eyebrow'),
          start: 0.07,
          end: 0.8,
          travel: 37,
          scale: 0.12
        },
        {
          element: intro.querySelector<HTMLElement>('h1'),
          start: 0.11,
          end: 0.86,
          travel: 31,
          scale: 0.13
        },
        {
          element: intro.querySelector<HTMLElement>('.tagline'),
          start: 0.16,
          end: 0.9,
          travel: 24,
          scale: 0.09
        },
        {
          element: intro.querySelector<HTMLElement>('.cover-actions'),
          start: 0.22,
          end: 0.95,
          travel: 17,
          scale: 0.06
        }
      ]
      const motto = this.querySelector<HTMLElement>('.opening-motto')
      if (motto) {
        const canvas = motto.querySelector<HTMLCanvasElement>('.opening-ink')
        let shouldPlay = window.wendellAppearance?.get().silverInk === true && !motionReduced()
        try {
          if (sessionStorage.getItem('vesper-opening-motto-seen') === '1') shouldPlay = false
        } catch {
          // Storage may be unavailable.
        }
        let stopInk: (() => void) | null = null
        let timer = 0
        let finishing = false
        const unlock = () => {
          document.documentElement.classList.remove('vesper-opening-active')
          document.body.style.removeProperty('overflow')
        }
        const finish = () => {
          if (finishing) return
          finishing = true
          window.clearTimeout(timer)
          stopInk?.()
          stopInk = null
          motto.classList.add('is-exiting')
          window.setTimeout(() => {
            motto.classList.remove('is-playing', 'is-exiting')
            unlock()
          }, 750)
          motto.setAttribute('aria-hidden', 'true')
          motto.inert = true
          if (motto.contains(document.activeElement)) {
            (this.querySelector<HTMLElement>('.primary-reading'))?.focus({ preventScroll: true })
          }
        }
        if (shouldPlay && canvas) {
          document.documentElement.classList.add('vesper-opening-active')
          document.body.style.overflow = 'hidden'
          motto.classList.remove('is-exiting')
          motto.classList.add('is-playing')
          motto.setAttribute('aria-hidden', 'false')
          motto.inert = false
          // Load the shader module only after the visitor explicitly enables this effect.
          void import('@/utils/silver-ink-opening.js').then(({ playSilverInk }) => {
            if (signal.aborted || finishing) return
            stopInk = playSilverInk(canvas, signal)
            if (!stopInk) { finish(); return }
            try { sessionStorage.setItem('vesper-opening-motto-seen', '1') } catch {}
            timer = window.setTimeout(finish, 7000)
          }).catch(error => {
            console.warn('Silver ink opening could not be loaded:', error)
            finish()
          })
          motto.querySelector<HTMLButtonElement>('.opening-skip')?.addEventListener('click', finish, { signal })
          reduced.addEventListener('change', () => { if (motionReduced()) finish() }, { signal })
          signal.addEventListener('abort', () => { window.clearTimeout(timer); stopInk?.(); unlock() }, { once: true })
        } else {
          motto.classList.remove('is-playing', 'is-exiting')
          motto.setAttribute('aria-hidden', 'true')
          motto.inert = true
        }
      }
      const hint = this.querySelector<HTMLElement>('[data-collapse]')!
      const measure = () => {
        const height = this.offsetHeight,
          compact = Math.min(340, innerHeight * 0.42)
        /* 封面被 margin-top:-90px 拉到页面顶上方，rect.top 一开局就是负数；
           直接拿 -top 当进度会让首屏就先收起十几像素。以文档内起点（不小于 0）为基准，
           保证 scrollY=0 时进度正好是 0，封面完整铺满。 */
        const docTop = this.getBoundingClientRect().top + window.scrollY
        const start = Math.max(0, docTop)
        const target = Math.max(
          0,
          Math.min(1, (window.scrollY - start) / Math.max(1, height - compact))
        )
        cover.style.height = `${height - (height - compact) * target}px`
        return target
      }
      let target = measure(),
        spring = { position: target, velocity: 0 },
        lastTime = 0
      const paint = () => {
        const value = spring.position,
          p = Math.max(0, Math.min(1, value))
        let visible = false
        for (const layer of layers) {
          const element = layer.element
          if (!element) continue
          const opacity = 1 - fadeProgress(p, layer.start, layer.end)
          const rebound = Math.max(-0.025, Math.min(0.035, -spring.velocity * 0.012))
          element.style.opacity = String(opacity)
          element.style.transform = motionReduced()
            ? ''
            : `translate3d(0,${-value * layer.travel}px,0) scale(${1 - value * layer.scale + rebound})`
          element.style.visibility = opacity < 0.001 ? 'hidden' : 'visible'
          element.inert = opacity < 0.02
          if (opacity >= 0.001) visible = true
        }
        intro.style.transform = motionReduced()
          ? ''
          : `translate3d(0,${-value * 9}px,0) scale(${1 - value * 0.08})`
        intro.style.visibility = visible ? 'visible' : 'hidden'
        intro.inert = !visible
        const caption = fadeProgress(p, 0.35, 0.8)
        credit.classList.toggle('is-visible', caption > 0.001)
        credit.style.opacity = String(caption)
        credit.style.transform = motionReduced() ? '' : `translateY(${(1 - caption) * 6}px)`
        const hintOpacity = 1 - fadeProgress(p, 0, 0.35)
        hint.style.opacity = String(hintOpacity)
        hint.style.visibility = hintOpacity < 0.001 ? 'hidden' : 'visible'
        hint.inert = hintOpacity < 0.02
        this.classList.toggle('is-collapsed', p > 0.98)
      }
      const tick = (time: number) => {
        target = measure()
        const dt = lastTime ? (time - lastTime) / 1000 : 1 / 60
        lastTime = time
        spring = motionReduced()
          ? { position: target, velocity: 0 }
          : springStep(spring, target, dt)
        const settled =
          Math.abs(target - spring.position) < 0.0003 && Math.abs(spring.velocity) < 0.003
        if (settled) spring = { position: target, velocity: 0 }
        paint()
        if (settled) {
          this.frame = 0
          lastTime = 0
        } else this.frame = requestAnimationFrame(tick)
      }
      const schedule = () => {
        if (!this.frame) this.frame = requestAnimationFrame(tick)
      }
      const resize = () => {
        this.style.setProperty('--viewport-width', `${document.documentElement.clientWidth}px`)
        schedule()
      }
      this.viewportObserver = new ResizeObserver(resize)
      this.viewportObserver.observe(document.documentElement)
      window.addEventListener('scroll', schedule, { passive: true, signal })
      window.addEventListener('resize', resize, { signal })
      window.addEventListener('wendell:appearance', () => {
        syncCoverCredit()
        schedule()
      }, { signal })
      syncCoverCredit()
      reduced.addEventListener(
        'change',
        () => {
          spring.velocity = 0
          schedule()
        },
        { signal }
      )
      document.addEventListener(
        'visibilitychange',
        () => {
          if (document.hidden) {
            cancelAnimationFrame(this.frame)
            this.frame = 0
            lastTime = 0
          } else {
            target = measure()
            spring = { position: target, velocity: 0 }
            paint()
          }
        },
        { signal }
      )
      resize()
      paint()
      this.querySelector('[data-collapse]')?.addEventListener(
        'click',
        () => {
          const compact = Math.min(340, innerHeight * 0.42)
          window.scrollTo({
            top: window.scrollY + this.getBoundingClientRect().top + this.offsetHeight - compact,
            behavior: motionReduced() ? 'instant' : 'smooth'
          })
        },
        { signal }
      )
      const name = this.querySelector<HTMLButtonElement>('.glitch-name')!
      name.addEventListener(
        'click',
        () => {
          name.classList.remove('is-glitching')
          void name.offsetWidth
          name.classList.add('is-glitching')
          this.querySelector<HTMLButtonElement>('interactive-avatar button')?.click()
        },
        { signal }
      )
      name.addEventListener('animationend', (event) => {
        if (!(event as AnimationEvent).pseudoElement) name.classList.remove('is-glitching')
      }, { signal })
    }
    disconnectedCallback() {
      this.viewportObserver?.disconnect()
      this.controller?.abort()
      cancelAnimationFrame(this.frame)
    }
  }
  if (!customElements.get('landing-hero')) customElements.define('landing-hero', LandingHero)
</script>
<style>
  .home-page {
    margin-top: -90px;
  }
  .landing-track {
    overflow-anchor: none;
    display: block;
    height: 100vh; /* Chrome 99: fallback before small viewport units. */
    height: 100svh;
    position: relative;
    width: var(--viewport-width, 100%);
    margin-left: calc(50% - var(--viewport-width, 100%) / 2);
  }
  .home-cover {
    position: sticky;
    top: 0;
    height: 100vh; /* Chrome 99: fallback before small viewport units. */
    height: 100svh;
    min-height: 230px;
    isolation: isolate;
    overflow: hidden;
    background: #1e2948;
    color: white;
    display: grid;
    place-items: center;
  }
  .cover-image,
  .cover-shade,
  .star-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  .cover-image {
    background-image: var(--home-wallpaper-image, url('/images/moonlit-cover.svg'));
    background-size: cover;
    background-position: 65% center;
    background-repeat: no-repeat;
  }
  .cover-shade {
    background: linear-gradient(180deg, #10172f44, #10172f33 30%, #10172fbb);
  }
  /* White home-cover copy must stay readable on bright custom photography. */
  :global(html[data-home-wallpaper-custom='true']) .cover-shade {
    background: linear-gradient(180deg, #0a10275c, #0a10276b 42%, #0a1027d8);
  }
  :global(html[data-home-wallpaper-custom='true']) .star-field {
    display: none;
  }
  .star-field {
    background-image:
      radial-gradient(1px 1px at 15% 30%, #fff, transparent),
      radial-gradient(2px 2px at 78% 25%, #fff8, transparent),
      radial-gradient(1px 1px at 60% 55%, #fff, transparent);
    background-size: 370px 310px;
    pointer-events: none;
  }
  /* Independent silver-ink prologue; the homepage remains unchanged beneath it. */
  .opening-motto {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    z-index: 2147483000;
    overflow: hidden;
    isolation: isolate;
    background: #050609;
    color: #e7e9ed;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .opening-motto.is-playing {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition: opacity 700ms ease, visibility 700ms ease;
  }
  .opening-motto.is-playing.is-exiting {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  :global(html.vesper-opening-active) :global(header) {
    visibility: hidden !important;
  }
  :global(html.vesper-opening-active) :global(body) {
    overflow: hidden !important;
  }
  .opening-ink, .opening-vignette {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .opening-ink { display: block; }
  .opening-vignette {
    background: radial-gradient(ellipse at 50% 48%, transparent 8%, #01020542 66%, #020305 110%);
  }
  .opening-copy {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.4rem;
    padding: 2rem 1rem;
    text-align: center;
    pointer-events: none;
  }
  .opening-label { font: 10px system-ui, sans-serif; letter-spacing: .36em; color: #9ba5b8; }
  .opening-copy p {
    margin: 0;
    font-family: Georgia, 'Noto Serif SC', serif;
    font-size: clamp(18px, 4.2vw, 32px);
    font-weight: 400;
    letter-spacing: .22em;
    line-height: 1.8;
    text-shadow: 0 0 25px #d4e0ff66;
  }
  .opening-rule {
    width: 85px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #b3c4d7, transparent);
  }
  .opening-skip {
    position: absolute;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    z-index: 1;
    min-width: 76px;
    min-height: 44px;
    padding: .6rem 1rem;
    border: 1px solid #a7b1c366;
    border-radius: 999px;
    background: #101621cc;
    color: #e7e9ed;
    font: 12px system-ui, sans-serif;
    cursor: pointer;
    pointer-events: auto;
  }
  .opening-skip:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .opening-motto.is-playing .opening-copy { animation: silver-ink-words 7s ease-in-out both; }
  @keyframes silver-ink-words {
    0%, 28% { opacity: 0; transform: translateY(8px); }
    43%, 77% { opacity: 1; transform: translateY(0); }
    96%, 100% { opacity: 0; transform: translateY(-5px); }
  }
  @media (max-width: 640px) {
    .opening-copy p { font-size: clamp(17px, 5vw, 24px); letter-spacing: .1em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .opening-motto, .opening-motto.is-playing { transition: none; }
    .opening-motto.is-playing.is-exiting { visibility: hidden; }
  }
  .hero-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6rem 1rem 5rem;
    will-change: opacity;
  }
  .hero-intro :global(img) {
    width: 112px;
    height: 112px;
    border: 3px solid #ffffffaa;
    box-shadow: 0 15px 55px #10172f70;
  }
  .eyebrow {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    margin: 1.35rem 0 0.5rem;
    opacity: 0.8;
  }
  h1 {
    margin: 0;
    line-height: 1.15;
  }
  .glitch-name {
    position: relative;
    font-size: clamp(3rem, 8vw, 5.7rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    color: inherit;
    border: 0;
    background: transparent;
    padding: 0.1rem 0.2rem;
